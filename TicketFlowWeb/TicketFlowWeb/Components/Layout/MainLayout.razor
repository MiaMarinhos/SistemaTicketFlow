@inherits LayoutComponentBase

<div class="page">
    <main>
        <div class="top-navbar px-4 shadow-sm">

            <div class="nav-left">
                <a href="/" class="brand-link">
                    <img src="images/logo_ticketflow.png" alt="Logo TicketFlow" class="brand-logo" />
                </a>
            </div>

            <div class="nav-center">
                <a class="botonDescubrir">DESCUBRIR</a>
            </div>

            <div class="nav-right">
                <a class="botonRegistrarse">Regístrate</a>
                <a class="botonIniciarSesion">Iniciar Sesión</a>
            </div>
        </div>
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>


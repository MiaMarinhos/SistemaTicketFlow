@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization

<AuthorizeView Roles="ADMIN">
    <Authorized>
        @* ==========================================
           VISTA DE ANFITRION: Formato predeterminado con menú izquierdo
           ========================================== *@
        <div class="page">
            <div class="sidebar">
                <NavMenu />
            </div>
            @* se hace un llamado al NavMenu pues alli esta el nuevo formato*@
            <main>
                <div class="top-row px-4 text-end" style="background-color: #f7f7f7; border-bottom: 1px solid #d6d5d5; padding: 0.8rem;">
                    <span class="me-3 fw-bold">
                        Conectado como: @context.User.FindFirst(c => c.Type == "Nombres")?.Value!
                    </span>
                </div>

                <article class="content px-4 py-3">
                    @Body
                </article>
            </main>
        </div>
    </Authorized>
 </AuthorizeView>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
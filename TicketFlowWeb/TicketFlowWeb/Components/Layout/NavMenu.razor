@using Microsoft.AspNetCore.Components.Authorization

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">TicketFlow Anfitrión</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Panel Principal
            </NavLink>
        </div>
        @* este menu es solo para el ANFITRION*@
        <AuthorizeView Roles="ANFITRION">
            @* como esta autorizado, puede poner todos lo que quieres en cada div*@
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/anfitrion/perfil">
                        <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Ver Perfil
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/anfitrion/gestionar-evento">
                        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Mis Eventos
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/anfitrion/entradas_evento">
                        <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Pagos
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/anfitrion/pagos_evento">
                        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Mis Eventos
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        

    </nav>
</div>
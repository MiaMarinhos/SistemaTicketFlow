@using Microsoft.AspNetCore.Components.Authorization

<AuthorizeView Roles="ANFITRION">
    <Authorized>
        <div class="top-row ps-3 navbar navbar-dark">
            <div class="container-fluid">
                <a class="navbar-brand" href="">TicketFlow Anfitrión</a>
            </div>
        </div>
    </Authorized>
</AuthorizeView>
<AuthorizeView Roles="ADMIN">
    <Authorized>
        <div class="top-row ps-3 navbar navbar-dark">
            <div class="container-fluid">
                <a class="navbar-brand" href="admin">TicketFlow Administrador</a>
            </div>
        </div>
    </Authorized>
</AuthorizeView>
<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        @* este menu es solo para el ANFITRION*@
        <AuthorizeView Roles="ANFITRION">
            @* como esta autorizado, puede poner todos lo que quieres en cada div*@
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                        <span class="bi bi-house-door-fill" aria-hidden="true"></span> Panel Principal
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/anfitrion/perfil">
                        <span class="bi bi-person-bounding-box" aria-hidden="true"></span> Ver Perfil
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/anfitrion/gestionar-evento">
                        <span class="bi bi-calendar4-event" aria-hidden="true"></span> Mis Eventos
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/anfitrion/entradas_evento">
                        <span class="bi bi-ticket-perforated-fill" aria-hidden="true"></span> Entradas por Evento
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/anfitrion/pagos_evento">
                        <span class="bi bi-cash-coin" aria-hidden="true"></span> Pagos Recibidos
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>
        @*======================================================================================*@
        @* este menu es solo para el ADMIN*@
        <AuthorizeView Roles="ADMIN">
            @* como esta autorizado, puede poner todos lo que quieres en cada div*@
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/admin">
                        <span class="bi bi-house-fill" aria-hidden="true"></span> Panel Principal
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/admin/perfil">
                        <span class="bi bi-person-circle" aria-hidden="true"></span> Perfil
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/admin/usuarios">
                        <span class="bi bi-people-fill" aria-hidden="true"></span> Usuarios
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/admin/eventos">
                        <span class="bi bi-calendar-event-fill" aria-hidden="true"></span> Eventos
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/admin/solicitudes">
                        <span class="bi bi-chat-left-text-fill" aria-hidden="true"></span> Solicitudes
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/admin/pagos">
                        <span class="bi bi-cash-stack" aria-hidden="true"></span>Pagos
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/admin/ventas">
                        <span class="bi bi-cart-fill" aria-hidden="true"></span> Ventas
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/admin/reportes">
                        <span class="bi bi-file-earmark-bar-graph-fill" aria-hidden="true"></span> Reportes
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/auth/logout?deDonde=admin">
                        <span class="bi bi-box-arrow-right" aria-hidden="true"></span> Cerrar Sesion
                    </NavLink>
                </div>

            </Authorized>
        </AuthorizeView>
        

    </nav>
</div>
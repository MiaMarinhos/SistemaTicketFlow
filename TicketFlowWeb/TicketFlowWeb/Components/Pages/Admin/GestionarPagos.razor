@page "/admin/pagos"
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize(Roles = "ADMIN")]
@layout AdminLayout

<PageTitle>Panel de Pagos</PageTitle>

<h3>Gestionar Pagos a Anfitriones</h3>

<nav class="navbar bg-body-tertiary">
    <div class="filtros-pagos">
        <label>Buscar:</label>
        <input type="text"
               class="form-control filtro-input"
               placeholder="Buscar usuario..."
               @bind="textoBusqueda"
               @bind:event="oninput" />

        <label>Fecha:</label>
        <input type="date"
               class="form-control filtro-fecha"
               @bind="fechaFiltro" />

        <label>Estado:</label>
        <select class="form-select filtro-estado"
                @bind="estadoFiltro">
            <option value="">Todos</option>
            <option value="Pendiente">Pendiente</option>
            <option value="Pagado">Pagado</option>
            <option value="Rechazado">Rechazado</option>
            <option value="Reembolso">Reembolso</option>
        </select>

        <button class="btn btn-dark" @onclick="LimpiarFiltros">
            <i class="bi bi-x-circle"></i>
        </button>
    </div>
</nav>

<div class="mt-4">

    @if (PagosFiltrados.Any())
    {
        <table class="table table-bordered table-hover">
            <thead class="table-primary">
                <tr>
                    <th>ID Pago</th>
                    <th>Usuario</th>
                    <th>Evento</th>
                    <th>Banco</th>
                    <th>Monto</th>
                    <th>Fecha</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var pago in PagosFiltrados)
                {
                    <tr>
                        <td>@pago.IdPago</td>
                        <td>@pago.Usuario</td>
                        <td>@pago.Evento</td>
                        <td>@pago.Banco</td>
                        <td>S/ @pago.Monto</td>
                        <td>@pago.Fecha.ToString("dd/MM/yyyy")</td>
                        <td>@pago.Estado</td>
                        <td>
                            <button class="btn btn-outline-dark btn-sm"
                                    data-bs-toggle="modal"
                                    data-bs-target="#detallePagoModal"
                                    @onclick="() => SeleccionarPago(pago)">
                                <i class="bi bi-eye"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="text-center py-5 border rounded bg-light">
            <i class="bi bi-search fs-1 text-secondary"></i>

            <h5 class="mt-3 text-secondary">
                No se encontraron coincidencias
            </h5>

            <p class="text-muted">
                Intente modificar los filtros de búsqueda.
            </p>
        </div>
    }

</div>
<div class="modal fade" id="detallePagoModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">
                    <i class="bi bi-receipt me-2"></i>
                    Detalle del Pago
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                @if (pagoSeleccionado != null)
                {
                    <div class="mb-3">
                        <h6 class="text-muted">Información general</h6>
                        <hr />
                    </div>

                    <div class="row mb-2">
                        <div class="col-5 fw-bold">ID Pago:</div>
                        <div class="col-7">@pagoSeleccionado.IdPago</div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-5 fw-bold">Usuario:</div>
                        <div class="col-7">@pagoSeleccionado.Usuario</div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-5 fw-bold">Evento:</div>
                        <div class="col-7">@pagoSeleccionado.Evento</div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-5 fw-bold">Banco:</div>
                        <div class="col-7">@pagoSeleccionado.Banco</div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-5 fw-bold">Monto:</div>
                        <div class="col-7">S/ @pagoSeleccionado.Monto</div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-5 fw-bold">Fecha:</div>
                        <div class="col-7">@pagoSeleccionado.Fecha.ToString("dd/MM/yyyy")</div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-5 fw-bold">Estado:</div>
                        <div class="col-7">
                            <span class="badge bg-secondary">
                                @pagoSeleccionado.Estado
                            </span>
                        </div>
                    </div>
                }
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    Cerrar
                </button>
            </div>

        </div>
    </div>
</div>

@code {
    private string textoBusqueda = "";
    private DateTime? fechaFiltro;
    private string estadoFiltro = "";

    private Pago? pagoSeleccionado;

    private IEnumerable<Pago> PagosFiltrados =>
        pagos.Where(p =>
            (string.IsNullOrWhiteSpace(textoBusqueda) ||
             p.Usuario.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase))

            &&

            (fechaFiltro == null ||
             p.Fecha.Date == fechaFiltro.Value.Date)

            &&

            (string.IsNullOrWhiteSpace(estadoFiltro) ||
             p.Estado == estadoFiltro)
        );

    private List<Pago> pagos = new()
    {
        new Pago { IdPago = 1, Usuario = "Juan Carlos", Evento = "Concierto Rock", Banco = "BCP", Monto = 85, Fecha = new DateTime(2026, 6, 15), Estado = "Pagado" },
        new Pago { IdPago = 2, Usuario = "Andrea Lucía", Evento = "Feria Gastronómica Sabores Limeños", Banco = "BBVA", Monto = 20, Fecha = new DateTime(2026, 6, 11), Estado = "Pendiente" },
        new Pago { IdPago = 3, Usuario = "Sebastián", Evento = "Obra de Teatro Hamlet", Banco = "Interbank", Monto = 120, Fecha = new DateTime(2026, 7, 4), Estado = "Pagado" },
        new Pago { IdPago = 4, Usuario = "Valería", Evento = "Maratón Lima 42K", Banco = "BCP", Monto = 60, Fecha = new DateTime(2026, 6, 21), Estado = "Pagado" },
        new Pago { IdPago = 5, Usuario = "Diego Alonso", Evento = "Festival de Cine Independiente", Banco = "BCP", Monto = 35, Fecha = new DateTime(2026, 7, 1), Estado = "Reembolso" },
        new Pago { IdPago = 6, Usuario = "Camila Fernanda", Evento = "Noche de Salsa y Sabor", Banco = "BCP", Monto = 45, Fecha = new DateTime(2026, 6, 2), Estado = "Pagado" }
    };

    private void SeleccionarPago(Pago pago)
    {
        pagoSeleccionado = pago;
    }

    private void LimpiarFiltros()
    {
        textoBusqueda = "";
        fechaFiltro = null;
        estadoFiltro = "";
    }

    public class Pago
    {
        public int IdPago { get; set; }
        public string Usuario { get; set; } = "";
        public string Evento { get; set; } = "";
        public string Banco { get; set; } = "";
        public decimal Monto { get; set; }
        public DateTime Fecha { get; set; }
        public string Estado { get; set; } = "";
    }
}
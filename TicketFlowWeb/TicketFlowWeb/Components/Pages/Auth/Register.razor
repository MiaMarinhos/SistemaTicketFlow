@page "/register"

<div class="register-container d-flex justify-content-center align-items-center min-vh-100">
    <div class="card register-card shadow-lg border-0 p-4 m-3 animate-fade-in">
        <div class="text-center mb-4">
            <img src="images/logo_ticketflow.png" alt="Logo TicketFlow" class="register-logo mb-2" />
            <h3 class="fw-bold text-dark">Crea tu cuenta</h3>
            <p class="text-muted small">Únete a TicketFlow y vive las mejores experiencias</p>
        </div>

        <form >
            <h5 class="section-title mb-3">Datos Personales</h5>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label font-medium">DNI</label>
                    <input name="dni" type="text" class="form-control custom-input" placeholder="Ingresa tu DNI" required maxlength="45" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label font-medium">Nombre</label>
                    <input name="nombre" type="text" class="form-control custom-input" placeholder="Tu nombre" required maxlength="45" />
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label font-medium">Apellido Paterno</label>
                    <input name="apellido_paterno" type="text" class="form-control custom-input" placeholder="Apellido paterno" required maxlength="45" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label font-medium">Apellido Materno</label>
                    <input name="apellido_materno" type="text" class="form-control custom-input" placeholder="Apellido materno" required maxlength="45" />
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label font-medium">Teléfono</label>
                    <input name="telefono" type="tel" class="form-control custom-input" placeholder="Ej: 987654321" required maxlength="45" />
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label font-medium">Género</label>
                    <select name="idGenero" class="form-select custom-input" required>
                        <option value="" disabled selected>Elegir...</option>
                        <option value="1">Masculino</option>
                        <option value="2">Femenino</option>
                    </select>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label font-medium">Fecha de Nacimiento</label>
                    <input name="fecha_nacimiento" type="date" class="form-control custom-input" required />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label font-medium">Distrito</label>
                    <select name="idDistrito" class="form-select custom-input" required>
                        <option value="" disabled selected>Selecciona tu distrito</option>
                        <option value="1">Miraflores</option>
                        <option value="2">San Isidro</option>
                        <option value="3">Santiago de Surco</option>
                        <option value="4">San Miguel</option>
                    </select>
                </div>
            </div>

            <hr class="my-4 text-muted" />
            <h5 class="section-title mb-3">Datos de Cuenta</h5>

            <div class="mb-3">
                <label class="form-label font-medium">Correo Electrónico</label>
                <input name="correo_electronico" type="email" class="form-control custom-input" placeholder="ejemplo@correo.com" required maxlength="45" />
            </div>

            <div class="mb-4">
                <label class="form-label font-medium">Contraseña</label>
                <input name="contrasena" type="password" class="form-control custom-input" placeholder="Crea una contraseña segura" required maxlength="45" />
            </div>

        <div class="text-center mt-3">
                <a href="/" class="btn btn-primary w-100 py-2 fw-bold btn-register shadow-sm">Registrarse </a>
        </div>

        <div class="text-center mt-3">
            <p class="small text-muted">¿Ya tienes una cuenta? <a href="/login" class="text-decoration-none text-primary fw-medium">Inicia Sesión</a></p>
        </div>
    </form>
</div>
</div>

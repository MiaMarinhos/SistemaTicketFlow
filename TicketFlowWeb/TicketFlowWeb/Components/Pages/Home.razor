@page "/"
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>Home</PageTitle>
<div class="home">
    <div class="cabezera">
        <div class="cabezera-contenido">
            <h1 class="display-4 fw-bold">TicketFlow</h1>
        </div>
    </div>
    <br/>
</div>

<AuthorizeView Roles="ANFITRION">
    @* si la vista esta autorizada para el ANFITRION entonces se vera un mensaje diferentes*@
    <Authorized Context="authContext">
        <h1>SOLO LOS ANFITRIONES PUEDEN VER ESTO</h1>
    </Authorized>
    <NotAuthorized Context="authContext">
        @* en el caso que no este autorizado como ANFITRION, se sobre entiende que como CLIENTE
            y entonces podras navegar por los eventos que ofrece TicketFlow
        *@
        @* AQUI SE DEBE DE PONER MAS COSAS QUE SOLO EL CLIENTE PUEDE VER*@

        <h1>SOLO LOS CLIENTES PUEDEN VER ESTO</h1>
    </NotAuthorized>


</AuthorizeView>


Welcome to Ticket Flow

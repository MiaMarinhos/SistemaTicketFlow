@page "/anfitrion/entradas_evento"
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize(Roles = "ANFITRION")]
@using TicketFlowWeb.Models
@inject NavigationManager NavigationManager

<PageTitle>TicketFlow - Entradas por Eventos</PageTitle>

<div class="entradas-eventos-contenedor">
    <main class="contenido-perfil">

        <section class="titulo-section mb-4">
            <h1>Entradas por eventos</h1>
        </section>

        <section class="row g-4 mb-4">

            <div class="col-md-4">
                <div class="tarjeta-kpi-anf">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="kpi-titulo-anf">MÁS ENTRADAS VENDIDAS</span>
                        <span>🔥</span>
                    </div>
                    <div class="kpi-valor-evento">Poemax</div>
                    <p class="m-0 text-success small fw-bold">300 tickets vendidos</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="tarjeta-kpi-anf">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="kpi-titulo-anf">MÁS ENTRADAS DISPONIBLES</span>
                        <span>🎟️</span>
                    </div>
                    <div class="kpi-valor-evento">Festival de Cine Independiente</div>
                    <p class="m-0 text-primary small fw-bold">300 tickets libres</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="tarjeta-kpi-anf destacada-anf">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="kpi-titulo-anf">TOTAL ENTRADAS VENDIDAS</span>
                        <span>📊</span>
                    </div>
                    <div class="kpi-valor-anf text-primary">682</div>
                    <p class="m-0 text-muted small">De un total de 1500 emitidas</p>
                </div>
            </div>

        </section>

        <section class="tarjeta-perfil p-4 rounded-4 bg-white shadow-sm">
            <h4 class="mb-3 fw-bold text-indigo fs-5">Detalle de eventos</h4>

            <div class="tabla-scroll-contenedor">
                <table class="table table-striped table-hover align-middle m-0 Custom-tabla-anf">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Título</th>
                            <th>Fecha</th>
                            <th>Precio</th>
                            <th class="text-center">Entradas Vendidas</th>
                            <th class="text-center">Entradas Disponibles</th>
                            <th class="text-center">Capacidad Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ev in listadoInventario)
                        {
                            <tr>
                                <td class="fw-bold text-muted" style="width: 60px;">@ev.Id</td>
                                <td class="fw-bold text-indigo">@ev.Titulo</td>
                                <td><span class="badge-fecha">@ev.FechaTexto</span></td>
                                <td class="fw-bold text-dark">S/. @ev.Precio.ToString("0.00")</td>
                                <td class="text-center fw-bold text-success fs-6">@ev.EntradasVendidas</td>
                                <td class="text-center fw-bold text-primary fs-6">@ev.EntradasDisponibles</td>
                                <td class="text-center text-muted">@ev.CapacidadTotal</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

    </main>
</div>

<style>
    .entradas-eventos-contenedor {
        min-height: 100vh;
        background-color: #f2edff;
        font-family: Arial, Helvetica, sans-serif;
        color: #110846;
    }

    .contenido-perfil {
        padding: 40px 50px;
    }

    .titulo-section {
        background-color: white;
        padding: 35px 42px;
        border-radius: 8px;
    }

        .titulo-section h1 {
            margin: 0;
            font-size: 38px;
            font-weight: bold;
            letter-spacing: 2px;
            color: #15095f;
        }

    .tarjeta-kpi-anf {
        background: #ffffff;
        border: 1px solid #e1dbf5;
        border-radius: 14px;
        padding: 22px;
        box-shadow: 0 4px 15px rgba(21, 9, 95, 0.04);
        min-height: 135px;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

        .tarjeta-kpi-anf.destacada-anf {
            background: linear-gradient(135deg, #ffffff 0%, #f7f5ff 100%);
            border: 1px solid #c3b6f2;
        }

    .kpi-titulo-anf {
        font-size: 12px;
        letter-spacing: 1px;
        color: #666688;
        font-weight: bold;
    }

    .kpi-valor-anf {
        font-size: 32px;
        font-weight: bold;
        color: #15095f;
        margin: 2px 0;
    }

    .kpi-valor-evento {
        font-size: 20px;
        font-weight: bold;
        color: #15095f;
        margin: 4px 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .tabla-scroll-contenedor {
        max-height: 400px;
        overflow-y: auto;
        border: 1px solid #f0edf5;
        border-radius: 4px;
    }

        .tabla-scroll-contenedor::-webkit-scrollbar {
            width: 8px;
        }

        .tabla-scroll-contenedor::-webkit-scrollbar-track {
            background: #f1edf5;
        }

        .tabla-scroll-contenedor::-webkit-scrollbar-thumb {
            background: #c3b6f2;
            border-radius: 4px;
        }

            .tabla-scroll-contenedor::-webkit-scrollbar-thumb:hover {
                background: #15095f;
            }

    .Custom-tabla-anf {
        border: none;
        width: 100%;
    }

        .Custom-tabla-anf thead th {
            color: #0c2775 !important;
            background-color: #d1e8ff !important;
            font-weight: bold;
            padding: 14px;
            font-size: 15px;
            position: sticky;
            top: 0;
            z-index: 2;
        }

        .Custom-tabla-anf tbody td {
            padding: 15px 14px;
            font-size: 15px;
            color: #333;
        }

    .text-indigo {
        color: #15095f;
    }

    .badge-fecha {
        background-color: #cbdcf7;
        color: #0c2775;
        padding: 5px 12px;
        border-radius: 15px;
        font-weight: 500;
        font-size: 13px;
    }

    @@media (max-width: 900px) {
        .contenido-perfil {
            padding: 20px 15px;
        }

        .titulo-section h1 {
            font-size: 28px;
        }
    }
</style>

@code {
    private List<InventarioEventoDto> listadoInventario = new()
    {
        new InventarioEventoDto(1, "Poemax", "07/05/2026", 80.00m, 300, 0, 300),
        new InventarioEventoDto(2, "Feria Gastronómica \"Sabores Limeños\"", "20/06/2026", 20.00m, 40, 260, 300),
        new InventarioEventoDto(3, "Concierto Rock", "15/06/2026", 85.00m, 210, 90, 300),
        new InventarioEventoDto(4, "Obra de Teatro: Hamlet", "12/07/2026", 120.00m, 132, 168, 300),
        new InventarioEventoDto(5, "Festival de Cine Independiente", "05/08/2026", 35.00m, 0, 300, 300)
    };

    private class InventarioEventoDto
    {
        public int Id { get; set; }
        public string Titulo { get; set; }
        public string FechaTexto { get; set; }
        public decimal Precio { get; set; }
        public int EntradasVendidas { get; set; }
        public int EntradasDisponibles { get; set; }
        public int CapacidadTotal { get; set; }

        public InventarioEventoDto(int id, string titulo, string fechaTexto, decimal precio, int entradasVendidas, int entradasDisponibles, int capacidadTotal)
        {
            Id = id;
            Titulo = titulo;
            FechaTexto = fechaTexto;
            Precio = precio;
            EntradasVendidas = entradasVendidas;
            EntradasDisponibles = entradasDisponibles;
            CapacidadTotal = capacidadTotal;
        }
    }
}
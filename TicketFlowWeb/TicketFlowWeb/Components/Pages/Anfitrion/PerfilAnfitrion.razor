    protected override void OnInitialized()
    {
        // 💡 Datos de prueba que simulan la carga polimórfica desde tu base de datos MySQL
        perfilModel = new PerfilAnfitrionViewModel
        {
            Codigo = "ANF-9842",
            RazonSocial = "Producciones Entretenimiento Perú S.A.C.",
            Ruc = "20765432101",
            Nombre = "Luis",
            ApellidoPaterno = "Ramírez",
            ApellidoMaterno = "Gómez",
            Dni = "76543210",
            Correo = "contacto@entretenimiento.pe",
            Telefono = "987 654 321",
            CuentaBancaria = "BCP - 191-XXXXXXXX-X-XX"
        };
    }
}
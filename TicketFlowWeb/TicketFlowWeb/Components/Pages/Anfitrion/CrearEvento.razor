@page "/anfitrion/crear-evento"
@using System.ComponentModel.DataAnnotations
@using TicketFlowWeb.Models
@inject NavigationManager NavigationManager

<PageTitle>TicketFlow - Crear Evento</PageTitle>

<div class="crear-evento-page d-flex align-items-center justify-content-center min-vh-100 p-3 p-md-5">
    <div class="evento-card container-fluid p-4 p-md-5 rounded-4 shadow-lg">

        <div class="d-flex justify-content-end mb-3">
            <button class="btn-regresar d-flex align-items-center justify-content-center" @onclick="VolverAtras" type="button" title="Volver">
                <span class="flecha-retroceso">&larr;</span>
            </button>
        </div>

        <form @onsubmit="GuardarEvento" autocomplete="off">

            <div class="row g-4">

                <div class="col-lg-6 d-flex flex-column gap-3">

                    <div class="mb-2">
                        <h2 class="subtitulo-explicativo text-uppercase fw-bold text-white-50">Crea tu nuevo evento</h2>
                    </div>

                    <div class="input-contenedor-full">
                        <input type="text" class="custom-input custom-titulo-input" placeholder="Título" @bind="eventoModel.Titulo" required />
                    </div>

                    <div class="input-contenedor-full flex-grow-1 d-flex flex-column">
                        <textarea class="custom-input custom-textarea flex-grow-1" rows="8" placeholder="Descripcion..." @bind="eventoModel.Descripcion" required></textarea>
                    </div>

                    <div class="d-flex gap-3 mt-2">
                        <div class="d-flex align-items-center gap-2 flex-grow-1">
                            <span class="etiqueta-fija text-center">N Entradas</span>
                            <div class="w-100">
                                <input type="number" min="0" class="custom-input text-white" @bind="NumeroEntradasValidado" placeholder="300" required />
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-2 flex-grow-1">
                            <span class="etiqueta-fija text-center">Precio</span>
                            <div class="w-100">
                                <input type="text" class="custom-input text-white" @bind="PrecioFormateado" placeholder="S/. 50.00" required />
                            </div>
                        </div>
                    </div>

                </div>

                <div class="col-lg-6 d-flex flex-column gap-3 justify-content-between">

                    <div class="fila-formulario-derecha">
                        <span class="etiqueta-fija">Imagen</span>
                        <input type="text" class="custom-input" placeholder="Subir Imagen" @bind="eventoModel.ImagenRuta" />
                    </div>

                    <div class="fila-formulario-derecha">
                        <span class="etiqueta-fija">Fecha</span>
                        <input type="text" class="custom-input text-white" placeholder="31/05/2026" @bind="FechaFormateada" required />
                    </div>

                    <div class="fila-formulario-derecha">
                        <span class="etiqueta-fija">Hora de Inicio</span>
                        <input type="text" class="custom-input" placeholder="10:30 am" @bind="eventoModel.HoraInicio" required />
                    </div>

                    <div class="fila-formulario-derecha">
                        <span class="etiqueta-fija">Hora de Fin</span>
                        <input type="text" class="custom-input" placeholder="12:30 am" @bind="eventoModel.HoraFin" required />
                    </div>

                    <div class="fila-formulario-derecha">
                        <span class="etiqueta-fija">Ubicacion</span>
                        <input type="text" class="custom-input" placeholder="Pasaje Porta 132. Miraflores" @bind="eventoModel.Ubicacion" required />
                    </div>

                    <div class="fila-formulario-derecha">
                        <span class="etiqueta-fija">Sitio del Evento</span>
                        <input type="text" class="custom-input" placeholder="El Teatro Teatral" @bind="eventoModel.SitioEvento" required />
                    </div>

                    <div class="fila-formulario-derecha">
                        <span class="etiqueta-fija">Distrito</span>
                        <input type="text" class="custom-input" placeholder="Miraflores" @bind="eventoModel.Distrito" required />
                    </div>

                    <div class="fila-formulario-derecha">
                        <span class="etiqueta-fija">Region</span>
                        <input type="text" class="custom-input" placeholder="Lima" @bind="eventoModel.Region" required />
                    </div>

                </div>

            </div>

            <div class="text-center mt-5">
                <button type="submit" class="btn-crear-evento fw-bold text-uppercase">
                    Crear Evento
                </button>
            </div>

        </form>

    </div>
</div>

<style>
    .crear-evento-page {
        background-color: #121212;
        font-family: system-ui, -apple-system, sans-serif;
    }

    .evento-card {
        background: linear-gradient(145deg, #070724 0%, #100f57 45%, #18239c 100%);
        max-width: 1200px;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .subtitulo-explicativo {
        font-size: 1.1rem;
        letter-spacing: 2px;
        color: rgba(255, 255, 255, 0.6) !important;
        margin: 0;
    }

    .btn-regresar {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background-color: transparent;
        border: 2px solid rgba(255, 255, 255, 0.7);
        color: white !important;
        transition: all 0.2s ease-in-out;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .btn-regresar:hover {
            background-color: rgba(255, 255, 255, 0.15);
            border-color: #ffffff;
        }

    .flecha-retroceso {
        font-size: 34px;
        line-height: 1;
        font-weight: bold;
        display: inline-block;
        margin-top: -6px;
        color: white !important;
    }

    .custom-input {
        width: 100%;
        background-color: transparent;
        border: 2px solid rgba(255, 255, 255, 0.7);
        border-radius: 12px;
        padding: 10px 18px;
        color: white !important;
        font-size: 1rem;
        outline: none;
    }

        .custom-input::placeholder {
            color: rgba(255, 255, 255, 0.5);
        }

        .custom-input:focus {
            border-color: #ffffff;
        }

    .custom-titulo-input {
        font-size: 1.6rem;
        font-weight: bold;
        border-radius: 10px;
    }

    .custom-textarea {
        border-radius: 18px;
        resize: none;
    }

    .etiqueta-fija {
        min-width: 135px;
        max-width: 135px;
        border: 2px solid rgba(255, 255, 255, 0.7);
        border-radius: 12px;
        padding: 10px;
        color: white;
        font-size: 0.95rem;
        font-weight: 500;
        display: inline-block;
    }

    .fila-formulario-derecha {
        display: flex;
        align-items: center;
        gap: 15px;
        width: 100%;
    }

    .btn-crear-evento {
        background-color: #d1e4ff;
        color: #0c0a3e;
        border: none;
        border-radius: 35px;
        padding: 15px 70px;
        font-size: 1.1rem;
        letter-spacing: 1px;
        transition: all 0.2s ease-in-out;
        cursor: pointer;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
    }

        .btn-crear-evento:hover {
            background-color: #ffffff;
            transform: scale(1.03);
        }
</style>

@code {
    private EventoViewModel eventoModel = new EventoViewModel();

    private string FechaFormateada
    {
        get
        {
            return eventoModel.Fecha?.ToString("dd/MM/yyyy") ?? DateTime.Today.ToString("dd/MM/yyyy");
        }
        set
        {
            if (DateTime.TryParseExact(value, "dd/MM/yyyy", null, System.Globalization.DateTimeStyles.None, out DateTime fechaParsed))
            {
                eventoModel.Fecha = fechaParsed;
            }
            else if (DateTime.TryParse(value, out DateTime fechaFlexible))
            {
                eventoModel.Fecha = fechaFlexible;
            }
        }
    }

    private int NumeroEntradasValidado
    {
        get => eventoModel.NumeroEntradas;
        set => eventoModel.NumeroEntradas = value < 0 ? 0 : value;
    }

    private string PrecioFormateado
    {
        get
        {
            return $"S/. {eventoModel.Precio.ToString("0.00")}";
        }
        set
        {
            string limpio = value.Replace("S/.", "").Replace("S/", "").Replace(" ", "").Trim();

            if (decimal.TryParse(limpio, out decimal resultado))
            {
                eventoModel.Precio = resultado < 0 ? 0 : resultado;
            }
            else if (string.IsNullOrEmpty(limpio))
            {
                eventoModel.Precio = 0;
            }
        }
    }

    private void GuardarEvento()
    {
        NavigationManager.NavigateTo("/");
    }

    private void VolverAtras()
    {
        NavigationManager.NavigateTo("/");
    }
}
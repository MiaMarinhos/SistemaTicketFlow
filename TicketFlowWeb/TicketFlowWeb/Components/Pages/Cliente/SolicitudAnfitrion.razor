@page "/solicitud-anfitrion"
@using System.ComponentModel.DataAnnotations
@using TicketFlowWeb.Models
@inject NavigationManager NavigationManager

<PageTitle>TicketFlow - Solicitud de Anfitrión</PageTitle>

<div class="solicitud-page d-flex align-items-center justify-content-center min-vh-100 p-3 p-md-5">
    <div class="solicitud-card container-fluid p-0 rounded-4 overflow-hidden shadow-lg">
        <div class="row g-0 h-100">

            <div class="col-lg-5 d-none d-lg-flex flex-column justify-content-between p-4 posicion-teatro">
            </div>

            <div class="col-lg-7 formulario-seccion p-4 p-md-5 d-flex flex-column justify-content-center">

                <div class="d-flex justify-content-end mb-3">
                    <button class="btn-regresar d-flex align-items-center justify-content-center" @onclick="VolverAtras" type="button" title="Volver al inicio">
                        <span class="flecha-retroceso">&larr;</span>
                    </button>
                </div>

                <h3 class="form-titulo fw-bold mb-4">Envía tu Solicitud para ser un Anfitrión</h3>

                <EditForm Model="@solicitudModel" OnValidSubmit="ProcesarSolicitud" autocomplete="off">
                    <DataAnnotationsValidator />

                    <div class="custom-input-group mb-3">
                        <InputText class="custom-control" placeholder="Razon Social" @bind-Value="solicitudModel.RazonSocial" />
                        <ValidationMessage For="@(() => solicitudModel.RazonSocial)" class="text-warning small mt-1" />
                    </div>

                    <div class="custom-input-group mb-3">
                        <InputText class="custom-control" placeholder="RUC" maxlength="11" @bind-Value="solicitudModel.Ruc" />
                        <ValidationMessage For="@(() => solicitudModel.Ruc)" class="text-warning small mt-1" />
                    </div>

                    <div class="custom-input-group mb-3">
                        <InputText class="custom-control" placeholder="Telefono de contacto" @bind-Value="solicitudModel.Telefono" />
                        <ValidationMessage For="@(() => solicitudModel.Telefono)" class="text-warning small mt-1" />
                    </div>

                    <div class="custom-input-group mb-3">
                        <InputText type="email" class="custom-control" placeholder="Correo de Contacto" @bind-Value="solicitudModel.Correo" />
                        <ValidationMessage For="@(() => solicitudModel.Correo)" class="text-warning small mt-1" />
                    </div>

                    <div class="custom-input-group mb-4">
                        <InputTextArea class="custom-control custom-textarea" rows="4" placeholder="Mi motivo es..." @bind-Value="solicitudModel.Motivo" />
                        <ValidationMessage For="@(() => solicitudModel.Motivo)" class="text-warning small mt-1" />
                    </div>

                    <div class="text-center mt-4">
                        <button type="submit" class="btn-enviar-solicitud text-uppercase fw-bold">
                            Enviar Solicitud
                        </button>
                    </div>

                </EditForm>
            </div>

        </div>
    </div>
</div>

<style>
    .solicitud-page {
        background-color: #1a1a1a;
        font-family: system-ui, -apple-system, sans-serif;
    }

    .solicitud-card {
        background: linear-gradient(135deg, #111042 0%, #17158a 50%, #1e29b1 100%);
        max-width: 1100px;
        min-height: 600px;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .posicion-teatro {
        background-color: #2a1b4e;
        border-right: 1px solid rgba(255, 255, 255, 0.1);
    }

    .formulario-seccion {
        color: white;
    }

    .form-titulo {
        font-size: 1.45rem;
        letter-spacing: 0.5px;
    }

    .btn-regresar {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background-color: transparent;
        border: 2px solid rgba(255, 255, 255, 0.8);
        color: white;
        transition: all 0.2s ease-in-out;
        cursor: pointer;
    }

        .btn-regresar:hover {
            background-color: rgba(255, 255, 255, 0.2);
            border-color: #ffffff;
            transform: scale(1.05);
        }

        .btn-regresar i {
            color: white !important;
            display: inline-block;
        }

        .flecha-retroceso {
            color: white !important;
            font-size: 34px; 
            line-height: 1;
            font-weight: bold;
            display: inline-block;
            margin-top: -6px; 
        }

    .custom-input-group {
        position: relative;
    }

    .custom-control {
        width: 100%;
        background-color: transparent;
        border: 2px solid rgba(255, 255, 255, 0.7);
        border-radius: 25px;
        padding: 10px 22px;
        color: white;
        font-size: 1rem;
        outline: none;
        transition: border-color 0.2s;
    }

        .custom-control::placeholder {
            color: rgba(255, 255, 255, 0.6);
        }

        .custom-control:focus {
            border-color: #ffffff;
        }

    .custom-textarea {
        border-radius: 18px !important;
        resize: none;
    }

    .btn-enviar-solicitud {
        background-color: transparent;
        color: white;
        border: 2px solid #ffffff;
        border-radius: 30px;
        padding: 12px 45px;
        font-size: 0.95rem;
        letter-spacing: 1px;
        transition: all 0.2s ease-in-out;
        cursor: pointer;
    }

        .btn-enviar-solicitud:hover {
            background-color: white;
            color: #17158a;
        }
</style>

@code {
    private SolicitudViewModel solicitudModel = new SolicitudViewModel();

    private void ProcesarSolicitud()
    {
        NavigationManager.NavigateTo("/");
    }

    private void VolverAtras()
    {
        NavigationManager.NavigateTo("/");
    }
}
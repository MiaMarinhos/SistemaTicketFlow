@page "/cliente/confirmar-pago/{Id:int}"
@using Microsoft.AspNetCore.Components
@using System.Collections.Generic

<div class="confirmar-pago-page">

    <div class="confirmar-contenedor">

        <div class="poster-evento @evento.ClasePoster">
            <div class="poster-contenido">
                <p class="poster-fecha">@evento.FechaPoster</p>
                <h2>@evento.TituloPoster</h2>
                <p>@evento.SubtituloPoster</p>
                <p class="poster-lugar">@evento.Ubicacion</p>
            </div>
        </div>

        <div class="panel-pago">
            <h1>@evento.Titulo</h1>

            <div class="resumen-box">
                <h2>Resumen de Pago</h2>

                <div class="fila-dato">
                    <label>Cantidad:</label>
                    <span>@cantidadEntradas</span>
                </div>

                <div class="fila-dato">
                    <label>Precio Unitario:</label>
                    <span>S/. @evento.PrecioUnitario.ToString("0.00")</span>
                </div>

                <div class="fila-dato">
                    <label>Subtotal:</label>
                    <span>S/. @Subtotal.ToString("0.00")</span>
                </div>

                <div class="fila-dato">
                    <label>Descuento aplicado:</label>
                    <span>S/. @descuentoAplicado.ToString("0.00")</span>
                </div>

                <div class="fila-dato total">
                    <label>Total a pagar:</label>
                    <span>S/. @Total.ToString("0.00")</span>
                </div>
            </div>

            <div class="metodos-box">
                <h2>Método de pago:</h2>

                <div class="opciones-pago">

                    <div class="opcion-pago">
                        <input type="radio"
                               name="metodoPago"
                               checked="@(metodoPago == "Yape")"
                               @onchange="@(() => SeleccionarMetodo("Yape"))" />
                        <span>Yape</span>
                    </div>

                    <div class="opcion-pago">
                        <input type="radio"
                               name="metodoPago"
                               checked="@(metodoPago == "Plin")"
                               @onchange="@(() => SeleccionarMetodo("Plin"))" />
                        <span>Plin</span>
                    </div>

                    <div class="opcion-pago">
                        <input type="radio"
                               name="metodoPago"
                               checked="@(metodoPago == "BCP")"
                               @onchange="@(() => SeleccionarMetodo("BCP"))" />
                        <span>BCP</span>
                    </div>

                </div>
            </div>

            <div class="acciones">
                <a href="@($"/cliente/resumen-compra/{evento.Id}")" class="btn-volver">
                    Volver
                </a>

                <a href="@($"/cliente/descargar-entrada/{evento.Id}")" class="btn-confirmar">
                    Confirmar pago
                </a>
            </div>

        </div>

    </div>

</div>

<style>
    .confirmar-pago-page {
        min-height: 100vh;
        background: linear-gradient(90deg, #05051f 0%, #1d1270 45%, #3928d8 100%);
        font-family: Arial, Helvetica, sans-serif;
        color: white;
        padding: 60px 70px;
    }

    .confirmar-contenedor {
        display: grid;
        grid-template-columns: 420px 1fr;
        gap: 60px;
        align-items: center;
        max-width: 1200px;
        margin: 0 auto;
    }

    .poster-evento {
        height: 600px;
        border: 4px solid #111;
        box-shadow: 0 12px 28px rgba(0, 0, 0, 0.45);
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
    }

    .poster-frio {
        background: linear-gradient(135deg, #111111, #4a4a4a);
    }

    .poster-poemax {
        background: linear-gradient(135deg, #000000, #1c1648);
    }

    .poster-teatro {
        background: linear-gradient(135deg, #21083f, #6931b8);
    }

    .poster-concierto {
        background: linear-gradient(135deg, #08213f, #1787b8);
    }

    .poster-contenido {
        padding: 30px;
    }

    .poster-fecha {
        font-size: 18px;
        letter-spacing: 3px;
        margin-bottom: 35px;
    }

    .poster-evento h2 {
        font-size: 62px;
        font-weight: bold;
        margin-bottom: 15px;
    }

    .poster-evento p {
        font-size: 20px;
    }

    .poster-lugar {
        margin-top: 170px;
        font-size: 17px;
        letter-spacing: 2px;
    }

    .panel-pago h1 {
        font-size: 58px;
        font-weight: bold;
        margin-bottom: 30px;
    }

    .resumen-box,
    .metodos-box {
        max-width: 700px;
        margin-bottom: 30px;
    }

        .resumen-box h2,
        .metodos-box h2 {
            font-size: 28px;
            font-weight: bold;
            margin-bottom: 20px;
        }

    .fila-dato {
        display: grid;
        grid-template-columns: 230px 1fr;
        gap: 18px;
        align-items: center;
        margin-bottom: 15px;
    }

        .fila-dato label {
            border: 2px solid white;
            border-radius: 8px;
            padding: 13px;
            font-size: 18px;
            font-weight: bold;
        }

        .fila-dato span {
            border: 2px solid white;
            border-radius: 8px;
            padding: 13px;
            font-size: 18px;
        }

    .total label,
    .total span {
        font-size: 20px;
        font-weight: bold;
    }

    .opciones-pago {
        display: flex;
        flex-direction: column;
        gap: 14px;
        max-width: 350px;
    }

    .opcion-pago {
        display: grid;
        grid-template-columns: 35px 1fr;
        align-items: center;
        gap: 12px;
    }

        .opcion-pago input {
            width: 22px;
            height: 22px;
        }

        .opcion-pago span {
            border: 2px solid white;
            border-radius: 8px;
            padding: 13px;
            font-size: 18px;
        }

    .acciones {
        display: flex;
        justify-content: flex-end;
        gap: 20px;
        margin-top: 40px;
        max-width: 700px;
    }

    .btn-volver,
    .btn-confirmar {
        display: inline-block;
        text-decoration: none;
        border-radius: 30px;
        padding: 15px 36px;
        font-size: 18px;
        font-weight: bold;
    }

    .btn-volver {
        color: white;
        border: 3px solid white;
    }

    .btn-confirmar {
        color: #160b62;
        background-color: white;
        border: 3px solid white;
    }

    .btn-volver:hover {
        background-color: white;
        color: #160b62;
    }

    .btn-confirmar:hover {
        background-color: #dffcff;
        color: #160b62;
    }

    @@media (max-width: 900px) {
        .confirmar-pago-page {
            padding: 35px 25px;
        }

        .confirmar-contenedor {
            grid-template-columns: 1fr;
            gap: 35px;
        }

        .poster-evento {
            height: 420px;
        }

        .poster-lugar {
            margin-top: 100px;
        }

        .panel-pago h1 {
            font-size: 42px;
        }

        .fila-dato {
            grid-template-columns: 1fr;
        }

        .acciones {
            flex-direction: column;
        }

        .btn-volver,
        .btn-confirmar {
            text-align: center;
        }
    }
</style>

@code {
    [Parameter]
    public int Id { get; set; }

    private int cantidadEntradas = 1;
    private decimal descuentoAplicado = 10;
    private string metodoPago = "BCP";

    private EventoPago evento = new EventoPago(
        1,
        "Nombre de un Evento muy Interesante",
        "FRÍOS",
        "1ra Temporada",
        "15 MARZO   8:00 PM",
        "Av. No sé 123, San Miguel",
        45,
        "poster-frio"
    );

    private List<EventoPago> eventos = new List<EventoPago>
    {
        new EventoPago(
            1,
            "Nombre de un Evento muy Interesante",
            "FRÍOS",
            "1ra Temporada",
            "15 MARZO   8:00 PM",
            "Av. No sé 123, San Miguel",
            45,
            "poster-frio"
        ),

        new EventoPago(
            2,
            "Poemax",
            "POEMAX",
            "Stand-up comedy y poesía",
            "07 MAYO   10:30 PM",
            "Pasaje Porta 132, Miraflores",
            50,
            "poster-poemax"
        ),

        new EventoPago(
            3,
            "Obra de Teatro: Hamlet",
            "HAMLET",
            "Obra teatral",
            "12 JULIO   7:30 PM",
            "Teatro Municipal de Lima",
            90,
            "poster-teatro"
        ),

        new EventoPago(
            4,
            "Concierto Rock Nocturno",
            "ROCK",
            "Música en vivo",
            "20 AGOSTO   9:00 PM",
            "Av. La Marina 456, Pueblo Libre",
            75,
            "poster-concierto"
        )
    };

    private decimal Subtotal
    {
        get
        {
            return evento.PrecioUnitario * cantidadEntradas;
        }
    }

    private decimal Total
    {
        get
        {
            decimal total = Subtotal - descuentoAplicado;

            if (total < 0)
            {
                return 0;
            }

            return total;
        }
    }

    protected override void OnParametersSet()
    {
        evento = ObtenerEvento(Id);
    }

    private void SeleccionarMetodo(string metodo)
    {
        metodoPago = metodo;
    }

    private EventoPago ObtenerEvento(int id)
    {
        foreach (EventoPago item in eventos)
        {
            if (item.Id == id)
            {
                return item;
            }
        }

        return eventos[0];
    }

    private class EventoPago
    {
        public int Id { get; set; }
        public string Titulo { get; set; }
        public string TituloPoster { get; set; }
        public string SubtituloPoster { get; set; }
        public string FechaPoster { get; set; }
        public string Ubicacion { get; set; }
        public decimal PrecioUnitario { get; set; }
        public string ClasePoster { get; set; }

        public EventoPago(int id, string titulo, string tituloPoster, string subtituloPoster,
            string fechaPoster, string ubicacion, decimal precioUnitario, string clasePoster)
        {
            Id = id;
            Titulo = titulo;
            TituloPoster = tituloPoster;
            SubtituloPoster = subtituloPoster;
            FechaPoster = fechaPoster;
            Ubicacion = ubicacion;
            PrecioUnitario = precioUnitario;
            ClasePoster = clasePoster;
        }
    }
}
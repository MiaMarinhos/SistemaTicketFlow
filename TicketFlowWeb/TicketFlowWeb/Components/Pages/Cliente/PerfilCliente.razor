@page "/cliente/perfil"
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject AuthenticationStateProvider AuthenticationStateProvider

<div class="perfil-cliente-page">

    <aside class="sidebar-cliente">
        <div class="usuario-box">
            <div class="avatar-cliente">
                👤
            </div>

            <div class="usuario-info">
                <h3>@nombreCliente</h3>
                <p>Cliente</p>
            </div>
        </div>

        <hr />

        <nav class="menu-cliente">
            <a href="/cliente/perfil" class="menu-item activo">
                <span>👤</span>
                Mi Perfil
            </a>

            <a href="/cliente/eventos" class="menu-item">
                <span>🎭</span>
                Eventos
            </a>

            <a href="/cliente/mis-entradas" class="menu-item">
                <span>🎟️</span>
                Mis Entradas
            </a>

            <a href="/auth/logout" class="menu-item logout">
                <span>↩</span>
                LogOut
            </a>
        </nav>
    </aside>

    <main class="contenido-perfil">

        <section class="titulo-section">
            <h1>Mi Perfil</h1>
        </section>

        <section class="tarjeta-perfil">

            <div class="tabla-perfil">

                <div class="fila-perfil">
                    <div class="campo">CÓDIGO:</div>
                    <div class="valor">CL-1234</div>
                </div>

                <div class="fila-perfil">
                    <div class="campo">NOMBRE:</div>
                    <div class="valor">@nombreCliente</div>
                </div>

                <div class="fila-perfil">
                    <div class="campo">APELLIDO PATERNO:</div>
                    <div class="valor">Ramírez</div>
                </div>

                <div class="fila-perfil">
                    <div class="campo">APELLIDO MATERNO:</div>
                    <div class="valor">Gómez</div>
                </div>

                <div class="fila-perfil">
                    <div class="campo">DNI:</div>
                    <div class="valor">76543210</div>
                </div>

                <div class="fila-perfil">
                    <div class="campo">CORREO:</div>
                    <div class="valor">@correoCliente</div>
                </div>

                <div class="fila-perfil">
                    <div class="campo">TELÉFONO:</div>
                    <div class="valor">987 654 321</div>
                </div>

                <div class="fila-perfil">
                    <div class="campo">PUNTOS BONUS:</div>
                    <div class="valor puntos">100 puntos</div>
                </div>

            </div>

            <div class="acciones-perfil">
                <a href="/cliente/mis-entradas" class="btn-perfil secundario">
                    Ver mis entradas
                </a>

                <a href="/cliente/eventos" class="btn-perfil principal">
                    Descubrir eventos
                </a>
            </div>

        </section>

    </main>

</div>

@code {
    private string nombreCliente = "Juan";
    private string correoCliente = "juan@gmail.com";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var usuario = authState.User;

        if (usuario.Identity != null && usuario.Identity.IsAuthenticated)
        {
            nombreCliente = usuario.FindFirst("Nombres")?.Value ?? "Juan";
            correoCliente = usuario.FindFirst(ClaimTypes.Name)?.Value ?? "juan@gmail.com";
        }
    }
}

<style>
    .perfil-cliente-page {
        min-height: 100vh;
        display: grid;
        grid-template-columns: 260px 1fr;
        background-color: #f2edff;
        font-family: Arial, Helvetica, sans-serif;
        color: #110846;
    }

    .sidebar-cliente {
        background-color: #15095f;
        color: white;
        padding: 45px 28px;
        display: flex;
        flex-direction: column;
        min-height: 100vh;
    }

    .usuario-box {
        display: flex;
        align-items: center;
        gap: 18px;
        margin-bottom: 28px;
    }

    .avatar-cliente {
        width: 70px;
        height: 70px;
        background-color: white;
        color: #15095f;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 42px;
        flex-shrink: 0;
    }

    .usuario-info h3 {
        margin: 0;
        font-size: 22px;
        font-weight: bold;
    }

    .usuario-info p {
        margin: 5px 0 0 0;
        font-size: 15px;
        opacity: 0.9;
    }

    .sidebar-cliente hr {
        border: none;
        border-top: 3px solid white;
        margin: 0 0 35px 0;
    }

    .menu-cliente {
        display: flex;
        flex-direction: column;
        gap: 12px;
        flex: 1;
    }

    .menu-item {
        display: flex;
        align-items: center;
        gap: 12px;
        color: white;
        text-decoration: none;
        padding: 14px 12px;
        border-radius: 12px;
        font-size: 17px;
        transition: 0.2s;
    }

        .menu-item:hover,
        .menu-item.activo {
            background-color: rgba(255, 255, 255, 0.15);
        }

        .menu-item span {
            width: 26px;
            text-align: center;
        }

    .logout {
        margin-top: auto;
    }

    .contenido-perfil {
        padding: 55px 65px;
    }

    .titulo-section {
        background-color: white;
        padding: 35px 42px;
        margin-bottom: 25px;
    }

        .titulo-section h1 {
            margin: 0;
            font-size: 42px;
            font-weight: bold;
            letter-spacing: 4px;
            color: #15095f;
        }

    .tarjeta-perfil {
        background-color: white;
        padding: 55px 50px;
        min-height: 520px;
    }

    .tabla-perfil {
        max-width: 760px;
        border: 1px solid #f0edf5;
    }

    .fila-perfil {
        display: grid;
        grid-template-columns: 300px 1fr;
        min-height: 68px;
        border-bottom: 1px solid #f0edf5;
    }

        .fila-perfil:last-child {
            border-bottom: none;
        }

    .campo,
    .valor {
        display: flex;
        align-items: center;
        padding: 0 22px;
        font-size: 17px;
    }

    .campo {
        font-weight: bold;
        background-color: #fffefa;
        color: #111;
    }

    .valor {
        background-color: white;
        color: #333;
    }

    .puntos {
        font-weight: bold;
        color: #15095f;
    }

    .acciones-perfil {
        display: flex;
        gap: 20px;
        margin-top: 35px;
        max-width: 760px;
        justify-content: flex-end;
    }

    .btn-perfil {
        text-decoration: none;
        padding: 14px 30px;
        border-radius: 28px;
        font-size: 17px;
        font-weight: bold;
    }

        .btn-perfil.secundario {
            color: #15095f;
            border: 3px solid #15095f;
            background-color: white;
        }

        .btn-perfil.principal {
            color: white;
            border: 3px solid #15095f;
            background-color: #15095f;
        }

        .btn-perfil.secundario:hover {
            background-color: #f2edff;
        }

        .btn-perfil.principal:hover {
            background-color: #241080;
        }

    @@media (max-width: 900px) {
        .perfil-cliente-page {
            grid-template-columns: 1fr;
        }

        .sidebar-cliente {
            min-height: auto;
        }

        .contenido-perfil {
            padding: 35px 25px;
        }

        .titulo-section h1 {
            font-size: 32px;
        }

        .tarjeta-perfil {
            padding: 35px 25px;
        }

        .fila-perfil {
            grid-template-columns: 1fr;
        }

        .campo,
        .valor {
            min-height: 52px;
        }

        .acciones-perfil {
            flex-direction: column;
        }

        .btn-perfil {
            text-align: center;
        }
    }
</style>
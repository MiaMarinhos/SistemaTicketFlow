@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation

<AuthorizeView Roles="ANFITRION">
    <Authorized>
        @* ==========================================
           VISTA DE ANFITRION: Formato predeterminado con menú izquierdo
           ========================================== *@
        <div class="page">
            <div class="sidebar">
                <NavMenu />
            </div>
            @* se hace un llamado al NavMenu pues alli esta el nuevo formato*@
            <main>
                <div class="top-row px-4 text-end" style="background-color: #f7f7f7; border-bottom: 1px solid #d6d5d5; padding: 0.8rem;">
                    <span class="me-3 fw-bold">
                        ¡Hola Anfitrión, @context.User.FindFirst(c => c.Type == "Nombres")?.Value!
                    </span>
                    <a href="/auth/logout" class="btn btn-sm btn-outline-danger">Cerrar Sesión</a>
                </div>

                <article class="content px-4 py-3">
                    @* cualquiera en su propio formato se dirige al HOME*@
                    @Body
                </article>
            </main>
        </div>
    </Authorized>

    <Authorizing>
        <div class="text-center p-5">Cargando autorización...</div>
    </Authorizing>

    <NotAuthorized>

        @* si no esta autorizado se sobre entiende que el rol es de CLIENTE, entonces se mantiene el mismo formato*@
        @* ==========================================
           VISTA PÚBLICA Y CLIENTE: Navbar superior limpia y @Body completo abajo
           ========================================== *@
        <div class="page">
            <main>
                <div class="top-navbar px-4 shadow-sm d-flex justify-content-between align-items-center" style="background-color: #120e49; height: 60px;">

                    <div class="nav-left">
                        <a href="/" class="brand-link">
                            <img src="images/logo_ticketflow.png" alt="Logo TicketFlow" class="brand-logo" style="max-height: 40px;" />
                        </a>
                    </div>

    <div class="nav-center-wrapper">
    <button class="botonDescubrir @(isDropdownOpen ? "active" : "")" @onclick="ToggleDropdown">
        <span class="texto-descubrir">DESCUBRIR</span>
        <div class="badge-flecha">
            <span class="arrow">@(isDropdownOpen ? "↑" : "↓")</span>
        </div>
    </button>

    @if (isDropdownOpen)
    {
                            <div class="ticketflow-dropdown">
                                <div class="dropdown-header-row d-flex justify-content-between align-items-center w-100">

                                    <a href="/public/descubrir" class="dropdown-link-main" @onclick="ToggleDropdown">
                                        VER TODAS LAS CATEGORIAS
                                        <span class="arrow-circle">→</span>
                                    </a>

                                    <div class="dropdown-search-box d-flex align-items-center">
                                        <div class="search-input-wrapper">
                                            <i class="bi bi-search search-icon"></i> <input type="text" class="search-input" placeholder="" @bind="searchText" />
                                        </div>
                                        <button class="btn-buscar" @onclick="EjecutarBusqueda">Buscar</button>
                                    </div>

                                </div>

                                <div class="dropdown-grid">
                                    <div class="grid-item"><a href="/public/descubrir/Deportes" @onclick="ToggleDropdown">Deportes</a><span class="arrow-circle">→</span></div>
                                    <div class="grid-item"><a href="/public/descubrir/Conciertos" @onclick="ToggleDropdown">Conciertos</a><span class="arrow-circle">→</span></div>
                                    <div class="grid-item"><a href="/public/descubrir/Teatro" @onclick="ToggleDropdown">Teatro</a><span class="arrow-circle">→</span></div>

                                    <div class="grid-item"><a href="/public/descubrir/Entretenimiento" @onclick="ToggleDropdown">Entretenimiento</a><span class="arrow-circle">→</span></div>
                                    <div class="grid-item"><a href="/public/descubrir/Seminarios y conferencias" @onclick="ToggleDropdown">Seminarios y conferencias</a><span class="arrow-circle">→</span></div>
                                    <div class="grid-item"><a href="/public/descubrir/Cursos y Talleres" @onclick="ToggleDropdown">Cursos y Talleres</a><span class="arrow-circle">→</span></div>

                                    <div class="grid-item"><a href="/public/descubrir/Party" @onclick="ToggleDropdown">Party</a><span class="arrow-circle">→</span></div>
                                    <div class="grid-item"><a href="/public/descubrir/Stand Up Comedy" @onclick="ToggleDropdown">Stand Up Comedy</a><span class="arrow-circle">→</span></div>
                                    <div class="grid-item empty"></div>
                                </div>
                            </div>
    }
    </div>


                    <div class="nav-right d-flex align-items-center gap-3">
                        <AuthorizeView Roles="CLIENTE">
                            <NotAuthorized Context="authContext">
                                <a href="/register" class="botonRegistrarse">Regístrate</a>
                                <a href="/login" class="botonIniciarSesion">Iniciar Sesión</a>
                            </NotAuthorized>
                            <Authorized Context="authContext">
                                <a href="/cliente/perfil" class="saludoPerfil fw-medium">
                                    ¡Hola, @authContext.User.FindFirst(c => c.Type == "Nombres")?.Value!
                                </a>

                                <a href="/auth/logout" class="botonLogout">Cerrar Sesión</a>
                            </Authorized>
                        </AuthorizeView>
                    </div>

                </div>

                <div class="content-viewport">
                    @* cualquiera en su propio formato se dirige al HOME*@
                    @Body
                </div>
            </main>
        </div>
    </NotAuthorized>
</AuthorizeView>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

<style>
    .dropdown-search-box {
        gap: 10px;
    }

    /* El input con la lupa simulada adentro */
    .search-input-wrapper {
        position: relative;
        display: flex;
        align-items: center;
    }

    .search-input {
        width: 250px; /* Ajusta el ancho según lo necesites */
        height: 38px;
        padding-left: 40px; /* Espacio para la lupa */
        border: 1px solid #a0a0a0;
        border-radius: 20px; /* Bordes ovalados como la imagen */
        background-color: #e9ecef; /* Fondo ligeramente gris para el input */
        outline: none;
    }

    /* Icono de la lupa */
    .search-icon {
        position: absolute;
        left: 15px;
        font-size: 1.1rem;
        color: #333;
    }

    /* Botón Buscar */
    .btn-buscar {
        background-color: #ffffff;
        color: #000000;
        border: 1px solid #a0a0a0;
        padding: 6px 24px;
        font-weight: bold;
        border-radius: 20px; /* Forma de píldora ovalada */
        cursor: pointer;
        transition: background-color 0.2s;
    }

        .btn-buscar:hover {
            background-color: #f1f1f1;
        }
</style>

@code {
    private string searchText = "";

    private void EjecutarBusqueda()
    {
        if (!string.IsNullOrWhiteSpace(searchText))
        {
            // Lógica para redirigir a los resultados de búsqueda, por ejemplo:
            Navigation.NavigateTo($"/public/descubrir/buscar/{searchText}");
            ToggleDropdown(); // Cierra el menú al buscar
        }
    }
    // Lógica en C# para abrir y cerrar el menú
    private bool isDropdownOpen = false;

    private void ToggleDropdown()
    {
        isDropdownOpen = !isDropdownOpen;
    }
}
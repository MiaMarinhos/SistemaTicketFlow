@page "/admin/perfil"
@layout AdminLayout

<PageTitle>Mi Perfil</PageTitle>

<h1 class="admin-page-title mb-4">Mi Perfil</h1>

<div class="card shadow-sm border-0">
    <div class="card-body p-4">

        <div class="row align-items-center mb-4">

            <div class="col-md-2 text-center">
                <i class="bi bi-person-circle text-primary"
                   style="font-size: 6rem;"></i>
            </div>

            <div class="col-md-10">
                <h3 class="mb-1">Nombrado Persona Apellidado Díaz</h3>
                <p class="text-muted mb-0">
                    Administrador del Sistema
                </p>
            </div>

        </div>

        <hr />

        <div class="row mb-3">
            <div class="col-md-3 fw-bold">
                Código
            </div>
            <div class="col-md-9">
                1234
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-3 fw-bold">
                Nombre
            </div>
            <div class="col-md-9">
                Nombrado Persona
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-3 fw-bold">
                Apellido Paterno
            </div>
            <div class="col-md-9">
                Apellidado
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-3 fw-bold">
                Apellido Materno
            </div>
            <div class="col-md-9">
                Díaz
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-3 fw-bold">
                Correo
            </div>
            <div class="col-md-9">
                admin@ticketflow.com
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-3 fw-bold">
                Rol
            </div>
            <div class="col-md-9">
                <span class="badge bg-primary">
                    Administrador
                </span>
            </div>
        </div>

        <hr />

        <div class="text-end">
            <button class="btn btn-primary">
                <i class="bi bi-pencil-square me-2"></i>
                Editar Perfil
            </button>
        </div>

    </div>
</div>
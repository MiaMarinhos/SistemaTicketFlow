    private DateTime? fechaFiltro;
    private string estadoFiltro = "";

    private Venta? ventaSeleccionada;

    private IEnumerable<Venta> VentasFiltradas =>
        ventas.Where(v =>
            (string.IsNullOrWhiteSpace(textoBusqueda) ||
             v.Usuario.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase))

            &&

            (fechaFiltro == null ||
             v.Fecha.Date == fechaFiltro.Value.Date)


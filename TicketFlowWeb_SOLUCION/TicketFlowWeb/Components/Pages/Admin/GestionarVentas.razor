@page "/admin/ventas"
@using Microsoft.AspNetCore.Authorization
@using TicketFlowWeb.Models.COMPRA
@using TicketFlowWeb.Services.AdministradorRS

@attribute [Authorize(Roles = "ADMIN")]
@layout AdminLayout

@inject AdministradorRestService AdminService

<PageTitle>Panel de Ventas</PageTitle>

<h3>Gestionar Ventas</h3>

<nav class="navbar bg-body-tertiary">
    <div class="filtros-pagos">
        <label>Buscar:</label>
        <input type="text"
               class="form-control filtro-input"
               placeholder="Buscar usuario..."
               @bind="textoBusqueda"
               @bind:event="oninput" />

        <label>Estado:</label>
        <select class="form-select filtro-estado"
                value="@estadoFiltro"
                @onchange="CambiarEstado">
            <option value="0">Todos</option>
            <option value="1">Pendiente</option>
            <option value="2">Confirmada</option>
        </select>

        <button class="btn btn-dark" @onclick="LimpiarFiltros">
            <i class="bi bi-x-circle"></i>
        </button>
    </div>
</nav>

<div class="mt-4">
    @if (!string.IsNullOrWhiteSpace(errorMensaje))
    {
        <div class="alert alert-danger">
            @errorMensaje
        </div>
    }

    @if (cargando)
    {
        <div class="text-center py-5 border rounded bg-light">
            <div class="spinner-border text-primary" role="status"></div>
            <h5 class="mt-3 text-secondary">Cargando ventas...</h5>
        </div>
    }
    else if (ComprasFiltradas.Any())
    {
        <table class="table table-bordered table-hover">
            <thead class="table-primary">
                <tr>
                    <th>ID Venta</th>
                    <th>Usuario</th>
                    <th>Evento</th>
                    <th>Cantidad</th>
                    <th>Total</th>
                    <th>Fecha</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var compra in ComprasFiltradas)
                {
                    <tr>
                        <td>@compra.idCompra</td>
                        <td>@ObtenerNombreCliente(compra)</td>
                        <td>@ObtenerTituloEvento(compra)</td>
                        <td>@compra.entradasCompradas</td>
                        <td>@FormatearMonto(compra.montoTotal)</td>
                        <td>@ObtenerFechaCompra(compra)</td>
                        <td>@ObtenerEstadoCompra(compra).ToUpper()</td>
                        <td>
                            <button class="btn btn-outline-dark btn-sm"
                                    data-bs-toggle="modal"
                                    data-bs-target="#detalleVentaModal"
                                    @onclick="() => SeleccionarCompra(compra)">
                                <i class="bi bi-eye"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="text-center py-5 border rounded bg-light">
            <i class="bi bi-search fs-1 text-secondary"></i>
            <h5 class="mt-3 text-secondary">No se encontraron ventas</h5>
            <p class="text-muted">Intente modificar los filtros de búsqueda.</p>
        </div>
    }
</div>

<div class="modal fade" id="detalleVentaModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">

            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">
                    <i class="bi bi-cart-fill me-2"></i>
                    Detalle de la Venta
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                @if (cargandoDetalle)
                {
                    <div class="text-center py-4">
                        <div class="spinner-border text-primary" role="status"></div>
                        <p class="mt-3 text-muted">Cargando detalle de la venta...</p>
                    </div>
                }
                else if (compraSeleccionada != null)
                {
                    <h6 class="text-muted">Información general</h6>
                    <hr />

                    <div class="row mb-2">
                        <div class="col-5 fw-bold">ID Venta:</div>
                        <div class="col-7">@compraSeleccionada.idCompra</div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-5 fw-bold">Usuario:</div>
                        <div class="col-7">@ObtenerNombreCliente(compraSeleccionada)</div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-5 fw-bold">Evento:</div>
                        <div class="col-7">@ObtenerTituloEvento(compraSeleccionada)</div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-5 fw-bold">Cantidad:</div>
                        <div class="col-7">@compraSeleccionada.entradasCompradas</div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-5 fw-bold">Método de pago:</div>
                        <div class="col-7">@MostrarTexto(compraSeleccionada.metodoPago)</div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-5 fw-bold">Monto parcial:</div>
                        <div class="col-7">@FormatearMonto(compraSeleccionada.montoParcial)</div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-5 fw-bold">Monto total:</div>
                        <div class="col-7">@FormatearMonto(compraSeleccionada.montoTotal)</div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-5 fw-bold">Fecha:</div>
                        <div class="col-7">@ObtenerFechaCompra(compraSeleccionada)</div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-5 fw-bold">Hora:</div>
                        <div class="col-7">@ObtenerHoraCompra(compraSeleccionada)</div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-5 fw-bold">Estado:</div>
                        <div class="col-7">@ObtenerEstadoCompra(compraSeleccionada).ToUpper()</div>
                    </div>

                    <h6 class="text-muted mt-4">Información técnica</h6>
                    <hr />

                    <div class="row mb-2">
                        <div class="col-5 fw-bold">ID Cliente:</div>
                        <div class="col-7">@compraSeleccionada.idCliente</div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-5 fw-bold">ID Evento:</div>
                        <div class="col-7">@compraSeleccionada.idEvento</div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-5 fw-bold">ID Estado:</div>
                        <div class="col-7">@compraSeleccionada.idEstado</div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-5 fw-bold">ID Puntos Bonus:</div>
                        <div class="col-7">@compraSeleccionada.idpuntoBonus</div>
                    </div>

                    @if (compraSeleccionada.puntosBonus != null)
                    {
                        <div class="row mb-2">
                            <div class="col-5 fw-bold">Puntos canjeables:</div>
                            <div class="col-7">@compraSeleccionada.puntosBonus.puntosCanheables</div>
                        </div>

                        <div class="row mb-2">
                            <div class="col-5 fw-bold">Descuento:</div>
                            <div class="col-7">@compraSeleccionada.puntosBonus.descuento</div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-4">
                        <i class="bi bi-exclamation-circle fs-1 text-secondary"></i>
                        <p class="mt-3 text-muted">No se pudo cargar el detalle de la venta.</p>
                    </div>
                }
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    Cerrar
                </button>
            </div>

        </div>
    </div>
</div>

@code {
    private List<CompraViewModel> compras = new();
    private CompraViewModel? compraSeleccionada;

    private string textoBusqueda = "";
    private int estadoFiltro = 0;

    private bool cargando = true;
    private bool cargandoDetalle = false;

    private string? errorMensaje;

    private IEnumerable<CompraViewModel> ComprasFiltradas =>
        compras.Where(c =>
            string.IsNullOrWhiteSpace(textoBusqueda) ||
            ObtenerNombreCliente(c).Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase)
        );

    protected override async Task OnInitializedAsync()
    {
        await CargarCompras();
    }

    private async Task CargarCompras()
    {
        try
        {
            cargando = true;
            errorMensaje = null;

            if (estadoFiltro == 0)
            {
                compras = await AdminService.ListarCompras();
            }
            else
            {
                compras = await AdminService.FiltrarComprasPorEstado(estadoFiltro);
            }
        }
        catch (Exception ex)
        {
            errorMensaje = ex.Message;
            compras = new List<CompraViewModel>();
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task CambiarEstado(ChangeEventArgs e)
    {
        int.TryParse(e.Value?.ToString(), out estadoFiltro);
        await CargarCompras();
    }

    private async Task LimpiarFiltros()
    {
        textoBusqueda = "";
        estadoFiltro = 0;
        await CargarCompras();
    }

    private async Task SeleccionarCompra(CompraViewModel compra)
    {
        try
        {
            cargandoDetalle = true;
            compraSeleccionada = null;
            errorMensaje = null;

            var detalle = await AdminService.ObtenerDetalleCompra(compra.idCompra);

            compraSeleccionada = detalle ?? compra;
        }
        catch (Exception ex)
        {
            errorMensaje = ex.Message;
            compraSeleccionada = compra;
        }
        finally
        {
            cargandoDetalle = false;
        }
    }

    private string ObtenerNombreCliente(CompraViewModel compra)
    {
        if (compra.cliente == null)
            return $"Cliente #{compra.idCliente}";

        var nombre = ObtenerPropiedad(compra.cliente, "nombre", "Nombre");
        var apellidoPaterno = ObtenerPropiedad(compra.cliente, "apellidoPaterno", "ApellidoPaterno");
        var apellidoMaterno = ObtenerPropiedad(compra.cliente, "apellidoMaterno", "ApellidoMaterno");

        var nombreCompleto = $"{nombre} {apellidoPaterno} {apellidoMaterno}".Trim();

        return string.IsNullOrWhiteSpace(nombreCompleto)
            ? $"Cliente #{compra.idCliente}"
            : nombreCompleto;
    }

    private string ObtenerTituloEvento(CompraViewModel compra)
    {
        if (compra.evento == null)
            return $"Evento #{compra.idEvento}";

        var titulo = ObtenerPropiedad(compra.evento, "titulo", "Titulo");

        return string.IsNullOrWhiteSpace(titulo)
            ? $"Evento #{compra.idEvento}"
            : titulo;
    }

    private string ObtenerEstadoCompra(CompraViewModel compra)
    {
        var estado = compra.estado?.estado;

        if (!string.IsNullOrWhiteSpace(estado))
            return estado;

        return compra.idEstado switch
        {
            1 => "PENDIENTE",
            2 => "CONFIRMADA",
            _ => $"ESTADO #{compra.idEstado}"
        };
    }

    private string ObtenerFechaCompra(CompraViewModel compra)
    {
        if (!string.IsNullOrWhiteSpace(compra.fechaCompraS))
            return compra.fechaCompraS;

        return compra.fechaCompra?.ToString("dd/MM/yyyy") ?? "-";
    }

    private string ObtenerHoraCompra(CompraViewModel compra)
    {
        if (!string.IsNullOrWhiteSpace(compra.horaCompraS))
            return compra.horaCompraS;

        return compra.horaCompra?.ToString("HH:mm:ss") ?? "-";
    }

    private string FormatearMonto(double monto)
    {
        return $"S/ {monto:0.00}";
    }

    private string MostrarTexto(string? valor)
    {
        return string.IsNullOrWhiteSpace(valor) ? "-" : valor;
    }

    private string ObtenerPropiedad(object objeto, params string[] nombres)
    {
        var propiedad = objeto.GetType()
            .GetProperties()
            .FirstOrDefault(p => nombres.Any(n =>
                string.Equals(p.Name, n, StringComparison.OrdinalIgnoreCase)));

        var valor = propiedad?.GetValue(objeto);

        return valor?.ToString() ?? string.Empty;
    }
}
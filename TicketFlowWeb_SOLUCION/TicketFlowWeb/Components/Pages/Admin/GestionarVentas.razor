@page "/admin/ventas"
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize(Roles = "ADMIN")]
@layout AdminLayout

<PageTitle>Panel de Ventas</PageTitle>

<h3>Gestionar Ventas</h3>

<nav class="navbar bg-body-tertiary">
    <div class="filtros-pagos">
        <label>Buscar:</label>
        <input type="text"
               class="form-control filtro-input"
               placeholder="Buscar usuario..."
               @bind="textoBusqueda"
               @bind:event="oninput" />

        <label>Fecha:</label>
        <input type="date"
               class="form-control filtro-fecha"
               @bind="fechaFiltro" />

        <label>Estado:</label>
        <select class="form-select filtro-estado"
                @bind="estadoFiltro">
            <option value="">Todos</option>
            <option value="Confirmada">Confirmada</option>
            <option value="Pendiente">Pendiente</option>
            <option value="Cancelada">Cancelada</option>
        </select>

        <button class="btn btn-dark" @onclick="LimpiarFiltros">
            <i class="bi bi-x-circle"></i>
        </button>
    </div>
</nav>

<div class="mt-4">
    @if (VentasFiltradas.Any())
    {
        <table class="table table-bordered table-hover">
            <thead class="table-primary">
                <tr>
                    <th>ID Venta</th>
                    <th>Usuario</th>
                    <th>Evento</th>
                    <th>Cantidad</th>
                    <th>Total</th>
                    <th>Fecha</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var venta in VentasFiltradas)
                {
                    <tr>
                        <td>@venta.IdVenta</td>
                        <td>@venta.Usuario</td>
                        <td>@venta.Evento</td>
                        <td>@venta.Cantidad</td>
                        <td>S/ @venta.Total</td>
                        <td>@venta.Fecha.ToString("dd/MM/yyyy")</td>
                        <td>@venta.Estado</td>
                        <td>
                            <button class="btn btn-outline-dark btn-sm"
                                    data-bs-toggle="modal"
                                    data-bs-target="#detalleVentaModal"
                                    @onclick="() => SeleccionarVenta(venta)">
                                <i class="bi bi-eye"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="text-center py-5 border rounded bg-light">
            <i class="bi bi-search fs-1 text-secondary"></i>
            <h5 class="mt-3 text-secondary">No se encontraron coincidencias</h5>
            <p class="text-muted">Intente modificar los filtros de búsqueda.</p>
        </div>
    }
</div>

<div class="modal fade" id="detalleVentaModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">
                    <i class="bi bi-cart-fill me-2"></i>
                    Detalle de la Venta
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                @if (ventaSeleccionada != null)
                {
                    <h6 class="text-muted">Información general</h6>
                    <hr />

                    <div class="row mb-2">
                        <div class="col-5 fw-bold">ID Venta:</div>
                        <div class="col-7">@ventaSeleccionada.IdVenta</div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-5 fw-bold">Usuario:</div>
                        <div class="col-7">@ventaSeleccionada.Usuario</div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-5 fw-bold">Evento:</div>
                        <div class="col-7">@ventaSeleccionada.Evento</div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-5 fw-bold">Cantidad:</div>
                        <div class="col-7">@ventaSeleccionada.Cantidad</div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-5 fw-bold">Total:</div>
                        <div class="col-7">S/ @ventaSeleccionada.Total</div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-5 fw-bold">Fecha:</div>
                        <div class="col-7">@ventaSeleccionada.Fecha.ToString("dd/MM/yyyy")</div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-5 fw-bold">Estado:</div>
                        <div class="col-7">
                            <span class="badge bg-secondary">@ventaSeleccionada.Estado</span>
                        </div>
                    </div>
                }
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    Cerrar
                </button>
            </div>

        </div>
    </div>
</div>

@code {

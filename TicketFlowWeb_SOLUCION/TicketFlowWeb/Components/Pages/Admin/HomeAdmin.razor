@page "/admin"
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize(Roles = "ADMIN")]
@layout AdminLayout

<PageTitle>Panel de Administración</PageTitle>

<h3>¡BIENVENIDO!</h3>

<div class="container mt-4 mb-5">
    <!-- Encabezado del Panel -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
        <div>
            <h2 class="fw-bold mb-0">Panel de Control</h2>
        </div>
        <div>
            <!--<button class="btn btn-outline-danger"><i class="bi bi-box-arrow-right me-2"></i>Cerrar Sesión</button>-->
            <NavLink class="nav-link" href="/auth/logout?deDonde=admin">
                <span class="bi bi-box-arrow-right" aria-hidden="true"></span> Cerrar Sesion
            </NavLink>
        </div>
    </div>

    <!-- Cuadrícula de Funciones -->
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        
        <!-- Tarjeta: Usuarios -->
        <div class="col">
            <a href="/admin/usuarios" class="text-decoration-none">
                <div class="card h-100 border-0 shadow-sm admin-card">
                    <div class="card-body text-center p-4">
                        <div class="icon-circle bg-primary-subtle text-primary mx-auto mb-3">
                            <i class="bi bi-people-fill"></i>
                        </div>
                        <h4 class="card-title fw-bold text-dark">Usuarios</h4>
                        <p class="card-text text-muted">Gestiona cuentas de clientes, anfitriones y sus permisos.</p>
                    </div>
                </div>
            </a>
        </div>

        <!-- Tarjeta: Eventos -->
        <div class="col">
            <a href="/admin/eventos" class="text-decoration-none">
                <div class="card h-100 border-0 shadow-sm admin-card">
                    <div class="card-body text-center p-4">
                        <div class="icon-circle bg-success-subtle text-success mx-auto mb-3">
                            <i class="bi bi-calendar-event-fill"></i>
                        </div>
                        <h4 class="card-title fw-bold text-dark">Eventos</h4>
                        <p class="card-text text-muted">Supervisa y audita la cartelera de eventos publicados.</p>
                    </div>
                </div>
            </a>
        </div>

        <!-- Tarjeta: Solicitudes -->
        <div class="col">
            <a href="/admin/solicitudes" class="text-decoration-none">
                <div class="card h-100 border-0 shadow-sm admin-card">
                    <div class="card-body text-center p-4">
                        <div class="icon-circle bg-warning-subtle text-warning mx-auto mb-3">
                            <i class="bi bi-ui-checks"></i>
                        </div>
                        <h4 class="card-title fw-bold text-dark">Solicitudes</h4>
                        <p class="card-text text-muted">Aprueba o rechaza nuevos anfitriones.</p>
                    </div>
                </div>
            </a>
        </div>

        <!-- Tarjeta: Pagos -->
        <div class="col">
            <a href="/admin/pagos" class="text-decoration-none">
                <div class="card h-100 border-0 shadow-sm admin-card">
                    <div class="card-body text-center p-4">
                        <div class="icon-circle bg-info-subtle text-info mx-auto mb-3">
                            <i class="bi bi-cash-coin"></i>
                        </div>
                        <h4 class="card-title fw-bold text-dark">Pagos</h4>
                        <p class="card-text text-muted">Revisa las transacciones y liquidaciones a los anfitriones.</p>
                    </div>
                </div>
            </a>
        </div>

        <!-- Tarjeta: Ventas -->
        <div class="col">
            <a href="/admin/ventas" class="text-decoration-none">
                <div class="card h-100 border-0 shadow-sm admin-card">
                    <div class="card-body text-center p-4">
                        <div class="icon-circle bg-danger-subtle text-danger mx-auto mb-3">
                            <i class="bi bi-cart-check-fill"></i>
                        </div>
                        <h4 class="card-title fw-bold text-dark">Ventas globales</h4>
                        <p class="card-text text-muted">Monitorea la cantidad de tickets vendidos en la plataforma.</p>
                    </div>
                </div>
            </a>
        </div>

        <!-- Tarjeta: Reportes -->
        <div class="col">
            <a href="/admin/reportes" class="text-decoration-none">
                <div class="card h-100 border-0 shadow-sm admin-card">
                    <div class="card-body text-center p-4">
                        <div class="icon-circle bg-secondary-subtle text-secondary mx-auto mb-3">
                            <i class="bi bi-bar-chart-line-fill"></i>
                        </div>
                        <h4 class="card-title fw-bold text-dark">Reportes</h4>
                        <p class="card-text text-muted">Genera y descarga informes estadísticos del sistema.</p>
                    </div>
                </div>
            </a>
        </div>

    </div>
</div>
@page "/admin/pagos"
@using Microsoft.AspNetCore.Authorization
@using TicketFlowWeb.Models
@using TicketFlowWeb.Services.AdministradorRS

@attribute [Authorize(Roles = "ADMIN")]
@layout AdminLayout

@inject AdministradorRestService AdminService

<PageTitle>Panel de Pagos</PageTitle>

<h3>Gestionar Pagos a Anfitriones</h3>

<nav class="navbar bg-body-tertiary">
    <div class="filtros-pagos">
        <label>Buscar:</label>
        <input type="text"
               class="form-control filtro-input"
               placeholder="Buscar usuario..."
               @bind="textoBusqueda"
               @bind:event="oninput" />

        <label>Fecha:</label>
        <input type="date"
               class="form-control filtro-fecha"
               value="@fechaFiltro"
               @onchange="CambiarFiltroFecha" />

        <label>Estado Pago:</label>
        <select class="form-select filtro-estado"
                value="@estadoFiltro"
                @onchange="CambiarFiltroEstado">
            <option value="0">Todos</option>
            <option value="1">Pendiente</option>
            <option value="2">Pagado</option>
            <option value="3">Rechazado</option>
            <option value="4">Reembolso</option>
        </select>

        <button class="btn btn-dark" @onclick="LimpiarFiltros">
            <i class="bi bi-x-circle"></i>
        </button>
    </div>
</nav>

<div class="mt-4">

    @if (!string.IsNullOrWhiteSpace(errorCarga))
    {
        <div class="alert alert-danger">
            @errorCarga
        </div>
    }

    @if (cargando)
    {
        <div class="text-center py-5 border rounded bg-light">
            <div class="spinner-border" role="status"></div>
            <p class="mt-3 text-muted">Cargando pagos...</p>
        </div>
    }
    else if (PagosFiltrados.Any())
    {
        <table class="table table-bordered table-hover">
            <thead class="table-primary">
                <tr>
                    <th>ID Pago</th>
                    <th>Usuario</th>
                    <th>Evento</th>
                    <th>Estado Evento</th>
                    <th>Banco</th>
                    <th>Monto</th>
                    <th>Fecha</th>
                    <th>Estado Pago</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var pago in PagosFiltrados)
                {
                    <tr>
                        <td>@pago.idPago</td>
                        <td>@pago.usuario</td>
                        <td>@pago.evento?.titulo</td>
                        <td>@ObtenerEstadoEvento(pago)</td>
                        <td>@pago.banco</td>
                        <td>S/ @pago.totalAPagar</td>
                        <td>@FormatearFecha(pago.fechaPago)</td>
                        <td>@pago.estado?.estado</td>

                        <td>
                            <button class="btn btn-outline-dark btn-sm"
                                    data-bs-toggle="modal"
                                    data-bs-target="#detallePagoModal"
                                    @onclick="() => VerDetallePago(pago.idPago)">
                                <i class="bi bi-eye"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="text-center py-5 border rounded bg-light">
            <i class="bi bi-search fs-1 text-secondary"></i>

            <h5 class="mt-3 text-secondary">
                No se encontraron coincidencias
            </h5>

            <p class="text-muted">
                Intente modificar los filtros de búsqueda.
            </p>
        </div>
    }

</div>

<!-- MODAL DETALLE PAGO -->
<div class="modal fade" id="detallePagoModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">

            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">
                    <i class="bi bi-receipt me-2"></i>
                    Detalle del Pago
                </h5>
                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                @if (cargandoDetalle)
                {
                    <div class="text-center py-4">
                        <div class="spinner-border" role="status"></div>
                        <p class="mt-3 text-muted">Cargando detalle del pago...</p>
                    </div>
                }
                else if (pagoDetalle != null)
                {
                    <div class="mb-3">
                        <h6 class="text-muted">Información general</h6>
                        <hr />
                    </div>

                    <div class="row mb-2">
                        <div class="col-5 fw-bold">ID Pago:</div>
                        <div class="col-7">@pagoDetalle.idPago</div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-5 fw-bold">Usuario / Anfitrión:</div>
                        <div class="col-7">@pagoDetalle.usuario</div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-5 fw-bold">Banco:</div>
                        <div class="col-7">@pagoDetalle.banco</div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-5 fw-bold">Monto:</div>
                        <div class="col-7">S/ @pagoDetalle.totalAPagar</div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-5 fw-bold">Fecha de pago:</div>
                        <div class="col-7">@FormatearFecha(pagoDetalle.fechaPago)</div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-5 fw-bold">Fecha límite:</div>
                        <div class="col-7">@FormatearFecha(pagoDetalle.fechaLimitePago)</div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-5 fw-bold">Comprobante:</div>
                        <div class="col-7">@pagoDetalle.comprobante</div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-5 fw-bold">Estado Pago:</div>
                        <div class="col-7">
                            <span class="badge bg-secondary">
                                @pagoDetalle.estado?.estado
                            </span>
                        </div>
                    </div>

                    <div class="mt-4 mb-3">
                        <h6 class="text-muted">Información del evento</h6>
                        <hr />
                    </div>

                    <div class="row mb-2">
                        <div class="col-5 fw-bold">ID Evento:</div>
                        <div class="col-7">@pagoDetalle.idEvento</div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-5 fw-bold">Evento:</div>
                        <div class="col-7">@pagoDetalle.evento?.titulo</div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-5 fw-bold">Estado Evento:</div>
                        <div class="col-7">@ObtenerEstadoEvento(pagoDetalle)</div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-5 fw-bold">Fecha del evento:</div>
                        <div class="col-7">@FormatearFechaTexto(pagoDetalle.evento?.fecha)</div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-5 fw-bold">Ubicación:</div>
                        <div class="col-7">@pagoDetalle.evento?.ubicacion</div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-5 fw-bold">Establecimiento:</div>
                        <div class="col-7">@pagoDetalle.evento?.nombre_establecimiento</div>
                    </div>
                }
                else
                {
                    <p>No se pudo cargar el detalle del pago.</p>
                }
            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cerrar
                </button>
            </div>

        </div>
    </div>
</div>

@code {
    private string textoBusqueda = "";
    private string fechaFiltro = "";
    private int estadoFiltro = 0;

    private bool cargando = true;
    private bool cargandoDetalle = false;
    private string errorCarga = "";

    private List<PagoViewModel> pagos = new();
    private PagoViewModel? pagoDetalle;

    protected override async Task OnInitializedAsync()
    {
        await CargarPagos();
    }

    private IEnumerable<PagoViewModel> PagosFiltrados =>
        pagos
            .Where(p =>
                string.IsNullOrWhiteSpace(textoBusqueda)
                ||
                (p.usuario ?? "").Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase)
                ||
                (p.evento?.titulo ?? "").Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase)
                ||
                ObtenerEstadoEvento(p).Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase)
                ||
                (p.banco ?? "").Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase)
                ||
                (p.estado?.estado ?? "").Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase)
            )
            .Where(p =>
                estadoFiltro == 0 || p.idEstado == estadoFiltro
            )
            .OrderBy(p => p.idPago);

    private async Task CargarPagos()
    {
        try
        {
            cargando = true;
            errorCarga = "";

            pagos = await AdminService.ListarPagos();
        }
        catch (Exception ex)
        {
            errorCarga = "No se pudieron cargar los pagos: " + ex.Message;
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task CambiarFiltroFecha(ChangeEventArgs e)
    {
        fechaFiltro = e.Value?.ToString() ?? "";
        await AplicarFiltros();
    }

    private async Task CambiarFiltroEstado(ChangeEventArgs e)
    {
        int.TryParse(e.Value?.ToString(), out estadoFiltro);
        await AplicarFiltros();
    }

    private async Task AplicarFiltros()
    {
        try
        {
            cargando = true;
            errorCarga = "";

            if (!string.IsNullOrWhiteSpace(fechaFiltro))
            {
                pagos = await AdminService.FiltrarPagosPorFecha(fechaFiltro);
            }
            else if (estadoFiltro > 0)
            {
                pagos = await AdminService.FiltrarPagosPorEstado(estadoFiltro);
            }
            else
            {
                pagos = await AdminService.ListarPagos();
            }
        }
        catch (Exception ex)
        {
            errorCarga = "No se pudieron aplicar los filtros: " + ex.Message;
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task VerDetallePago(int idPago)
    {
        try
        {
            cargandoDetalle = true;
            pagoDetalle = null;

            pagoDetalle = await AdminService.ObtenerDetallePago(idPago);
        }
        catch (Exception ex)
        {
            errorCarga = "No se pudo cargar el detalle del pago: " + ex.Message;
        }
        finally
        {
            cargandoDetalle = false;
        }
    }

    private async Task LimpiarFiltros()
    {
        textoBusqueda = "";
        fechaFiltro = "";
        estadoFiltro = 0;

        await CargarPagos();
    }

    private string ObtenerEstadoEvento(PagoViewModel pago)
    {
        if (pago.evento == null)
            return "";

        var estadoEvento = ObtenerPropiedadObjeto(
            pago.evento,
            "estadoEvento",
            "EstadoEvento"
        );

        if (estadoEvento != null)
        {
            var estado = ObtenerPropiedadTexto(
                estadoEvento,
                "estado",
                "Estado"
            );

            if (!string.IsNullOrWhiteSpace(estado))
                return estado;
        }

        var idEstadoEvento = ObtenerPropiedadTexto(
            pago.evento,
            "FK_idEstadoEvento",
            "fK_idEstadoEvento",
            "idEstadoEvento",
            "IdEstadoEvento"
        );

        if (!string.IsNullOrWhiteSpace(idEstadoEvento) && idEstadoEvento != "0")
            return $"Estado #{idEstadoEvento}";

        return "";
    }

    private object? ObtenerPropiedadObjeto(object objeto, params string[] nombres)
    {
        var propiedad = objeto.GetType()
            .GetProperties()
            .FirstOrDefault(p => nombres.Any(n =>
                string.Equals(p.Name, n, StringComparison.OrdinalIgnoreCase)));

        return propiedad?.GetValue(objeto);
    }

    private string ObtenerPropiedadTexto(object objeto, params string[] nombres)
    {
        var valor = ObtenerPropiedadObjeto(objeto, nombres);

        return valor?.ToString() ?? "";
    }

    private string FormatearFecha(DateTime? fecha)
    {
        if (fecha == null)
            return "";

        return fecha.Value.ToString("MM/dd/yyyy");
    }

    private string FormatearFechaTexto(string? fecha)
    {
        if (string.IsNullOrWhiteSpace(fecha))
            return "";

        if (DateTime.TryParse(fecha, out DateTime fechaConvertida))
            return fechaConvertida.ToString("dd/MM/yyyy");

        return fecha;
    }
}
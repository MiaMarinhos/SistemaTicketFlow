@page "/admin/pagos"
@using Microsoft.AspNetCore.Authorization
@using TicketFlowWeb.Models
@using TicketFlowWeb.Services.AdministradorRS

@attribute [Authorize(Roles = "ADMIN")]
@layout AdminLayout

@inject AdministradorRestService AdminService

<PageTitle>Panel de Pagos</PageTitle>

<h3>Gestionar Pagos a Anfitriones</h3>

<nav class="navbar bg-body-tertiary">
    <div class="filtros-pagos">
        <label>Buscar:</label>
        <input type="text"
               class="form-control filtro-input"
               placeholder="Buscar usuario..."
               @bind="textoBusqueda"
               @bind:event="oninput" />

        <label>Fecha:</label>
        <input type="date"
               class="form-control filtro-fecha"
               value="@fechaFiltro"
               @onchange="CambiarFiltroFecha" />

        <label>Estado Pago:</label>
        <select class="form-select filtro-estado"
                value="@estadoFiltro"
                @onchange="CambiarFiltroEstado">
            <option value="0">Todos</option>
            <option value="1">Pendiente</option>
            <option value="2">Pagado</option>
            <option value="3">Rechazado</option>
            <option value="4">Reembolso</option>
        </select>

        <button class="btn btn-dark" @onclick="LimpiarFiltros">
            <i class="bi bi-x-circle"></i>
        </button>
    </div>
</nav>

<div class="mt-4">

    @if (!string.IsNullOrWhiteSpace(errorCarga))
    {
        <div class="alert alert-danger">
            @errorCarga
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(mensajeGeneral))
    {
        <div class="alert alert-success">
            @mensajeGeneral
        </div>
    }

    @if (cargando)
    {
        <div class="text-center py-5 border rounded bg-light">
            <div class="spinner-border" role="status"></div>
            <p class="mt-3 text-muted">Cargando pagos...</p>
        </div>
    }
    else if (PagosFiltrados.Any())
    {
        <table class="table table-bordered table-hover">
            <thead class="table-primary">
                <tr>
                    <th>ID Pago</th>
                    <th>Usuario</th>
                    <th>Evento</th>
                    <th>Estado Evento</th>
                    <th>Banco</th>
                    <th>Monto</th>
                    <th>Fecha</th>
                    <th>Estado Pago</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var pago in PagosFiltrados)
                {
                    <tr>
                        <td>@pago.idPago</td>
                        <td>@pago.usuario</td>
                        <td>@pago.evento?.titulo</td>
                        <td>@ObtenerEstadoEvento(pago).ToUpper()</td>
                        <td>@pago.banco</td>
                        <td>S/ @pago.totalAPagar</td>
                        <td>@FormatearFecha(pago.fechaPago)</td>
                        <td>@MostrarTexto(pago.estado?.estado).ToUpper()</td>

                        <td>
                            <button class="btn btn-outline-dark btn-sm"
                                    title="Ver detalle"
                                    data-bs-toggle="modal"
                                    data-bs-target="#detallePagoModal"
                                    @onclick="() => VerDetallePago(pago.idPago)">
                                <i class="bi bi-eye"></i>
                            </button>

                            @if (PuedeConfirmarPago(pago))
                            {
                                <button class="btn btn-outline-success btn-sm ms-1"
                                        title="Confirmar transferencia"
                                        data-bs-toggle="modal"
                                        data-bs-target="#confirmarPagoModal"
                                        @onclick="() => PrepararConfirmacionPago(pago)">
                                    <i class="bi bi-check-circle"></i>
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="text-center py-5 border rounded bg-light">
            <i class="bi bi-search fs-1 text-secondary"></i>

            <h5 class="mt-3 text-secondary">
                No se encontraron coincidencias
            </h5>

            <p class="text-muted">
                Solo se muestran pagos de eventos finalizados.
            </p>
        </div>
    }

</div>

<!-- MODAL DETALLE PAGO -->
<div class="modal fade" id="detallePagoModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">

            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">
                    <i class="bi bi-receipt me-2"></i>
                    Detalle del Pago
                </h5>
                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                @if (cargandoDetalle)
                {
                    <div class="text-center py-4">
                        <div class="spinner-border" role="status"></div>
                        <p class="mt-3 text-muted">Cargando detalle del pago...</p>
                    </div>
                }
                else if (pagoDetalle != null)
                {
                    <div class="mb-3">
                        <h6 class="text-muted">Información general</h6>
                        <hr />
                    </div>

                    <div class="row mb-2">
                        <div class="col-5 fw-bold">ID Pago:</div>
                        <div class="col-7">@pagoDetalle.idPago</div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-5 fw-bold">Usuario / Anfitrión:</div>
                        <div class="col-7">@pagoDetalle.usuario</div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-5 fw-bold">Banco:</div>
                        <div class="col-7">@pagoDetalle.banco</div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-5 fw-bold">Monto:</div>
                        <div class="col-7">S/ @pagoDetalle.totalAPagar</div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-5 fw-bold">Fecha de pago:</div>
                        <div class="col-7">@FormatearFecha(pagoDetalle.fechaPago)</div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-5 fw-bold">Fecha límite:</div>
                        <div class="col-7">@FormatearFecha(pagoDetalle.fechaLimitePago)</div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-5 fw-bold">Comprobante:</div>
                        <div class="col-7">
                            @if (!string.IsNullOrWhiteSpace(pagoDetalle.comprobante))
                            {
                                <a href="@pagoDetalle.comprobante" target="_blank">
                                    Ver comprobante
                                </a>
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-5 fw-bold">Estado Pago:</div>
                        <div class="col-7">
                            <span class="badge bg-secondary">
                                @MostrarTexto(pagoDetalle.estado?.estado).ToUpper()
                            </span>
                        </div>
                    </div>

                    <div class="mt-4 mb-3">
                        <h6 class="text-muted">Información del evento</h6>
                        <hr />
                    </div>

                    <div class="row mb-2">
                        <div class="col-5 fw-bold">ID Evento:</div>
                        <div class="col-7">@pagoDetalle.idEvento</div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-5 fw-bold">Evento:</div>
                        <div class="col-7">@pagoDetalle.evento?.titulo</div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-5 fw-bold">Estado Evento:</div>
                        <div class="col-7">@ObtenerEstadoEvento(pagoDetalle).ToUpper()</div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-5 fw-bold">Fecha del evento:</div>
                        <div class="col-7">@FormatearFechaTexto(pagoDetalle.evento?.fecha)</div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-5 fw-bold">Ubicación:</div>
                        <div class="col-7">@pagoDetalle.evento?.ubicacion</div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-5 fw-bold">Establecimiento:</div>
                        <div class="col-7">@pagoDetalle.evento?.nombre_establecimiento</div>
                    </div>
                }
                else
                {
                    <p>No se pudo cargar el detalle del pago.</p>
                }
            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cerrar
                </button>
            </div>

        </div>
    </div>
</div>

<!-- MODAL CONFIRMAR PAGO -->
<div class="modal fade" id="confirmarPagoModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header bg-success text-white">
                <h5 class="modal-title">
                    <i class="bi bi-check-circle me-2"></i>
                    Confirmar transferencia bancaria
                </h5>
                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                @if (pagoParaConfirmar != null)
                {
                    <div class="mb-3">
                        <h6 class="text-muted">Datos del pago</h6>
                        <hr />
                    </div>

                    <div class="row mb-2">
                        <div class="col-5 fw-bold">ID Pago:</div>
                        <div class="col-7">@pagoParaConfirmar.idPago</div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-5 fw-bold">Anfitrión:</div>
                        <div class="col-7">@pagoParaConfirmar.usuario</div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-5 fw-bold">Evento:</div>
                        <div class="col-7">@pagoParaConfirmar.evento?.titulo</div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-5 fw-bold">Banco:</div>
                        <div class="col-7">@pagoParaConfirmar.banco</div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-5 fw-bold">Estado Evento:</div>
                        <div class="col-7">@ObtenerEstadoEvento(pagoParaConfirmar).ToUpper()</div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-5 fw-bold">Estado Pago:</div>
                        <div class="col-7">@MostrarTexto(pagoParaConfirmar.estado?.estado).ToUpper()</div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-5 fw-bold">Monto a pagar:</div>
                        <div class="col-7">S/ @pagoParaConfirmar.totalAPagar</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Link del comprobante JPG:</label>
                        <input type="text"
                               class="form-control"
                               placeholder="Ejemplo: /uploads/comprobantes/pago_1.jpg"
                               @bind="comprobanteConfirmacion"
                               @bind:event="oninput" />

                        <div class="form-text">
                            Ingresa la ruta o URL del comprobante en formato .jpg o .jpeg.
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(errorConfirmacion))
                    {
                        <div class="alert alert-danger">
                            @errorConfirmacion
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(mensajeConfirmacion))
                    {
                        <div class="alert alert-success">
                            @mensajeConfirmacion
                        </div>
                    }
                }
                else
                {
                    <p>No se seleccionó ningún pago para confirmar.</p>
                }
            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cancelar
                </button>

                <button type="button"
                        class="btn btn-success"
                        disabled="@confirmandoPago"
                        @onclick="ConfirmarPago">
                    @if (confirmandoPago)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                        <span>Confirmando...</span>
                    }
                    else
                    {
                        <i class="bi bi-check-circle me-1"></i>
                        <span>Confirmar pago</span>
                    }
                </button>
            </div>

        </div>
    </div>
</div>

@code {
    private string textoBusqueda = "";
    private string fechaFiltro = "";
    private int estadoFiltro = 0;

    private bool cargando = true;
    private bool cargandoDetalle = false;
    private bool confirmandoPago = false;

    private string errorCarga = "";
    private string mensajeGeneral = "";
    private string errorConfirmacion = "";
    private string mensajeConfirmacion = "";
    private string comprobanteConfirmacion = "";

    private List<PagoViewModel> pagos = new();
    private PagoViewModel? pagoDetalle;
    private PagoViewModel? pagoParaConfirmar;

    protected override async Task OnInitializedAsync()
    {
        await CargarPagos();
    }

    private IEnumerable<PagoViewModel> PagosFiltrados =>
        pagos
            .Where(p =>
                ObtenerEstadoEvento(p).Equals("FINALIZADO", StringComparison.OrdinalIgnoreCase)
            )
            .Where(p =>
                string.IsNullOrWhiteSpace(textoBusqueda)
                ||
                (p.usuario ?? "").Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase)
                ||
                (p.evento?.titulo ?? "").Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase)
                ||
                ObtenerEstadoEvento(p).Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase)
                ||
                (p.banco ?? "").Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase)
                ||
                (p.estado?.estado ?? "").Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase)
            )
            .Where(p =>
                estadoFiltro == 0 || p.idEstado == estadoFiltro
            )
            .OrderBy(p => p.idPago);

    private async Task CargarPagos()
    {
        try
        {
            cargando = true;
            errorCarga = "";
            mensajeGeneral = "";

            await AdminService.GenerarPagosEventosFinalizados();

            pagos = await AdminService.ListarPagos();
        }
        catch (Exception ex)
        {
            errorCarga = "No se pudieron cargar los pagos: " + ex.Message;
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task CambiarFiltroFecha(ChangeEventArgs e)
    {
        fechaFiltro = e.Value?.ToString() ?? "";
        await AplicarFiltros();
    }

    private async Task CambiarFiltroEstado(ChangeEventArgs e)
    {
        int.TryParse(e.Value?.ToString(), out estadoFiltro);
        await AplicarFiltros();
    }

    private async Task AplicarFiltros()
    {
        try
        {
            cargando = true;
            errorCarga = "";

            await AdminService.GenerarPagosEventosFinalizados();

            if (!string.IsNullOrWhiteSpace(fechaFiltro))
            {
                pagos = await AdminService.FiltrarPagosPorFecha(fechaFiltro);
            }
            else if (estadoFiltro > 0)
            {
                pagos = await AdminService.FiltrarPagosPorEstado(estadoFiltro);
            }
            else
            {
                pagos = await AdminService.ListarPagos();
            }
        }
        catch (Exception ex)
        {
            errorCarga = "No se pudieron aplicar los filtros: " + ex.Message;
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task VerDetallePago(int idPago)
    {
        try
        {
            cargandoDetalle = true;
            pagoDetalle = null;
            errorCarga = "";

            pagoDetalle = await AdminService.ObtenerDetallePago(idPago);
        }
        catch (Exception ex)
        {
            errorCarga = "No se pudo cargar el detalle del pago: " + ex.Message;
        }
        finally
        {
            cargandoDetalle = false;
        }
    }

    private void PrepararConfirmacionPago(PagoViewModel pago)
    {
        pagoParaConfirmar = pago;
        comprobanteConfirmacion = "";
        errorConfirmacion = "";
        mensajeConfirmacion = "";
        mensajeGeneral = "";
    }

    private async Task ConfirmarPago()
    {
        try
        {
            errorConfirmacion = "";
            mensajeConfirmacion = "";
            mensajeGeneral = "";

            if (pagoParaConfirmar == null)
            {
                errorConfirmacion = "Debe seleccionar un pago.";
                return;
            }

            if (string.IsNullOrWhiteSpace(comprobanteConfirmacion))
            {
                errorConfirmacion = "Debe ingresar el link del comprobante.";
                return;
            }

            if (!EsComprobanteJpg(comprobanteConfirmacion))
            {
                errorConfirmacion = "El comprobante debe ser un archivo JPG o JPEG.";
                return;
            }

            confirmandoPago = true;

            var pagoActualizado = await AdminService.ConfirmarTransferenciaPago(
                pagoParaConfirmar.idPago,
                comprobanteConfirmacion.Trim()
            );

            if (pagoActualizado != null)
            {
                pagoParaConfirmar = pagoActualizado;
                pagoDetalle = pagoActualizado;
            }

            mensajeConfirmacion = "Pago confirmado correctamente.";
            mensajeGeneral = "Pago confirmado correctamente.";

            await AplicarFiltros();
        }
        catch (Exception ex)
        {
            errorConfirmacion = ex.Message;
        }
        finally
        {
            confirmandoPago = false;
        }
    }

    private bool PuedeConfirmarPago(PagoViewModel pago)
    {
        var estadoPago = pago.estado?.estado ?? "";
        var estadoEvento = ObtenerEstadoEvento(pago);

        return estadoEvento.Equals("FINALIZADO", StringComparison.OrdinalIgnoreCase)
               && estadoPago.Equals("PENDIENTE", StringComparison.OrdinalIgnoreCase);
    }

    private bool EsComprobanteJpg(string comprobante)
    {
        var valor = comprobante.Trim().ToLower();

        return valor.EndsWith(".jpg")
               || valor.EndsWith(".jpeg")
               || valor.Contains(".jpg?")
               || valor.Contains(".jpeg?");
    }

    private async Task LimpiarFiltros()
    {
        textoBusqueda = "";
        fechaFiltro = "";
        estadoFiltro = 0;

        await CargarPagos();
    }

    private string ObtenerEstadoEvento(PagoViewModel pago)
    {
        if (pago.evento == null)
            return "";

        var estadoEvento = ObtenerPropiedadObjeto(
            pago.evento,
            "estadoEvento",
            "EstadoEvento"
        );

        if (estadoEvento != null)
        {
            var estado = ObtenerPropiedadTexto(
                estadoEvento,
                "estado",
                "Estado"
            );

            if (!string.IsNullOrWhiteSpace(estado))
                return estado;
        }

        var idEstadoEvento = ObtenerPropiedadTexto(
            pago.evento,
            "FK_idEstadoEvento",
            "fK_idEstadoEvento",
            "idEstadoEvento",
            "IdEstadoEvento"
        );

        if (!string.IsNullOrWhiteSpace(idEstadoEvento) && idEstadoEvento != "0")
            return $"Estado #{idEstadoEvento}";

        return "";
    }

    private object? ObtenerPropiedadObjeto(object objeto, params string[] nombres)
    {
        var propiedad = objeto.GetType()
            .GetProperties()
            .FirstOrDefault(p => nombres.Any(n =>
                string.Equals(p.Name, n, StringComparison.OrdinalIgnoreCase)));

        return propiedad?.GetValue(objeto);
    }

    private string ObtenerPropiedadTexto(object objeto, params string[] nombres)
    {
        var valor = ObtenerPropiedadObjeto(objeto, nombres);

        return valor?.ToString() ?? "";
    }

    private string FormatearFecha(DateTime? fecha)
    {
        if (fecha == null)
            return "";

        return fecha.Value.ToString("MM/dd/yyyy");
    }

    private string FormatearFechaTexto(string? fecha)
    {
        if (string.IsNullOrWhiteSpace(fecha))
            return "";

        if (DateTime.TryParse(fecha, out DateTime fechaConvertida))
            return fechaConvertida.ToString("dd/MM/yyyy");

        return fecha;
    }

    private string MostrarTexto(string? texto)
    {
        return string.IsNullOrWhiteSpace(texto) ? "-" : texto;
    }
}
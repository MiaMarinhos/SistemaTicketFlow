@page "/admin/usuarios"
@using Microsoft.AspNetCore.Authorization
@using TicketFlowWeb.Models
@using TicketFlowWeb.Services.AdministradorRS
@attribute [Authorize(Roles = "ADMIN")]
@layout AdminLayout
@inject AdministradorRestService AdminService

<PageTitle>Panel de Usuarios</PageTitle>

<h3>Gestionar Usuarios</h3>

<nav class="navbar bg-body-tertiary">
    <div class="filtros-pagos">
        <label>Buscar:</label>
        <input type="text"
               class="form-control filtro-input"
               placeholder="Buscar usuario..."
               @bind="textoBusqueda"
               @bind:event="oninput" />

        <button class="btn btn-dark" @onclick="LimpiarFiltros">
            <i class="bi bi-x-circle"></i>
        </button>
    </div>
</nav>

<div class="mt-4">
    @if (usuarios == null)
    {
        <p>Cargando usuarios...</p>
    }
    else
    {
        <table class="table table-bordered table-hover">
            <thead class="table-primary">
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Correo</th>
                    <th>Tipo</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var usuario in UsuariosFiltrados)
                {
                    <tr>
                        <td>@usuario.idUsuario</td>
                        <td>@usuario.nombre @usuario.apellidoPaterno @usuario.apellidoMaterno</td>
                        <td>@usuario.correoElectronico</td>
                        <td>@usuario.tipo?.tipoUsuario</td>
                        <td>@usuario.estado?.Nombre</td>
                        <td>
                            <button class="btn btn-outline-dark btn-sm">
                                <i class="bi bi-eye"></i>
                            </button>

                            <button class="btn btn-outline-dark btn-sm">
                                <i class="bi bi-brush"></i>
                            </button>

                            <button class="btn btn-outline-dark btn-sm">
                                <i class="bi bi-lock"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private string textoBusqueda = "";
    private string estadoFiltro = "";
    private List<Usuario>? usuarios;

    protected override async Task OnInitializedAsync()
    {
        usuarios = await AdminService.ListarUsuarios();
    }

    private IEnumerable<Usuario> UsuariosFiltrados =>
        usuarios == null
            ? Enumerable.Empty<Usuario>()
            : usuarios.Where(u =>
                string.IsNullOrWhiteSpace(textoBusqueda) ||
                $"{u.nombre} {u.apellidoPaterno} {u.apellidoMaterno} {u.correoElectronico}"
                    .Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase));

    private void LimpiarFiltros()
    {
        textoBusqueda = "";
        estadoFiltro = "";
    }
}
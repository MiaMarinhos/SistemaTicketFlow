@page "/admin/usuarios"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.JSInterop
@using TicketFlowWeb.Models
@using TicketFlowWeb.Services.AdministradorRS

@attribute [Authorize(Roles = "ADMIN")]
@layout AdminLayout

@inject AdministradorRestService AdminService
@inject IJSRuntime JS

<PageTitle>Panel de Usuarios</PageTitle>

<div class="d-flex align-items-center gap-3 mb-3">
    <h3 class="mb-0">Gestionar Usuarios</h3>

    <button class="btn btn-success"
            data-bs-toggle="modal"
            data-bs-target="#registrarUsuarioModal"
            @onclick="PrepararNuevoUsuario">
        <i class="bi bi-plus-circle"></i>
        Registrar
    </button>
</div>

<nav class="navbar bg-body-tertiary">
    <div class="filtros-pagos">
        <label>Buscar:</label>
        <input type="text"
               class="form-control filtro-input"
               placeholder="Buscar usuario..."
               @bind="textoBusqueda"
               @bind:event="oninput" />

        <label>Tipo:</label>
        <select class="form-select filtro-input"
                value="@tipoFiltro"
                @onchange="CambiarFiltroTipo">
            <option value="0">Todos</option>
            <option value="1">Cliente</option>
            <option value="2">Anfitrión</option>
            <option value="3">Admin</option>
        </select>

        <label>Estado:</label>
        <select class="form-select filtro-input"
                value="@estadoFiltro"
                @onchange="CambiarFiltroEstado">
            <option value="0">Todos</option>
            <option value="1">Activo</option>
            <option value="2">Eliminado</option>
        </select>

        <button class="btn btn-dark" @onclick="LimpiarFiltros">
            <i class="bi bi-x-circle"></i>
        </button>
    </div>
</nav>

<div class="mt-4">
    @if (usuarios == null)
    {
        <p>Cargando usuarios...</p>
    }
    else
    {
        <table class="table table-bordered table-hover">
            <thead class="table-primary">
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Correo</th>
                    <th>Tipo</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var usuario in UsuariosFiltrados)
                {
                    <tr>
                        <td>@usuario.idUsuario</td>
                        <td>@usuario.nombre @usuario.apellidoPaterno @usuario.apellidoMaterno</td>
                        <td>@usuario.correoElectronico</td>
                        <td>@usuario.tipo?.tipoUsuario</td>
                        <td>@usuario.estado?.Nombre</td>

                        <td>
                            <button class="btn btn-outline-dark btn-sm"
                                    data-bs-toggle="modal"
                                    data-bs-target="#verUsuarioModal"
                                    @onclick="() => VerUsuario(usuario.idUsuario)">
                                <i class="bi bi-eye"></i>
                            </button>

                            <button class="btn btn-outline-dark btn-sm"
                                    data-bs-toggle="modal"
                                    data-bs-target="#editarUsuarioModal"
                                    @onclick="() => EditarUsuario(usuario.idUsuario)">
                                <i class="bi bi-brush"></i>
                            </button>

                            @if (usuario.estado?.Nombre == "ELIMINADO")
                            {
                                <button class="btn btn-outline-success btn-sm"
                                        data-bs-toggle="modal"
                                        data-bs-target="#bloquearUsuarioModal"
                                        @onclick="() => SeleccionarUsuario(usuario)">
                                    <i class="bi bi-unlock"></i>
                                </button>
                            }
                            else
                            {
                                <button class="btn btn-outline-danger btn-sm"
                                        data-bs-toggle="modal"
                                        data-bs-target="#bloquearUsuarioModal"
                                        @onclick="() => SeleccionarUsuario(usuario)">
                                    <i class="bi bi-lock"></i>
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<!-- MODAL REGISTRAR USUARIO -->
<div class="modal fade" id="registrarUsuarioModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Registrar Usuario</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                @if (!string.IsNullOrWhiteSpace(errorRegistro))
                {
                    <div class="alert alert-danger">
                        @errorRegistro
                    </div>
                }

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">DNI</label>
                        <input class="form-control" @bind="nuevoDni" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Nombre</label>
                        <input class="form-control" @bind="nuevoNombre" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Apellido Paterno</label>
                        <input class="form-control" @bind="nuevoApellidoPaterno" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Apellido Materno</label>
                        <input class="form-control" @bind="nuevoApellidoMaterno" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Teléfono</label>
                        <input class="form-control" @bind="nuevoTelefono" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Edad</label>
                        <input type="number" class="form-control" @bind="nuevaEdad" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Correo electrónico</label>
                        <input type="email" class="form-control" @bind="nuevoCorreo" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Contraseña</label>
                        <input type="password" class="form-control" @bind="nuevaContrasena" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Fecha de nacimiento</label>
                        <input type="date"
                               class="form-control"
                               @bind="nuevaFechaNacimiento"
                               @bind:format="yyyy-MM-dd" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Tipo de usuario</label>
                        <select class="form-select" @bind="nuevoIdTipoUsuario">
                            <option value="1">Cliente</option>
                            <option value="2">Anfitrión</option>
                            <option value="3">Admin</option>
                        </select>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Género</label>
                        <select class="form-select" @bind="nuevoIdGenero">
                            <option value="0">Seleccione un género</option>

                            @foreach (var genero in generos)
                            {
                                <option value="@genero.IdGenero">
                                    @genero.Nombre
                                </option>
                            }
                        </select>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Distrito</label>
                        <select class="form-select" @bind="nuevoIdDistrito">
                            <option value="0">Seleccione un distrito</option>

                            @foreach (var distrito in distritos)
                            {
                                <option value="@distrito.IdDistrito">
                                    @distrito.Nombre
                                </option>
                            }
                        </select>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">
                    Cancelar
                </button>

                <button class="btn btn-primary" @onclick="RegistrarNuevoUsuario">
                    Guardar
                </button>
            </div>

        </div>
    </div>
</div>

<!-- MODAL VER USUARIO -->
<div class="modal fade" id="verUsuarioModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Información del Usuario</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                @if (usuarioSeleccionado != null)
                {
                    <p><strong>ID:</strong> @usuarioSeleccionado.idUsuario</p>
                    <p><strong>DNI:</strong> @usuarioSeleccionado.dni</p>
                    <p><strong>Nombre:</strong> @usuarioSeleccionado.nombre</p>
                    <p><strong>Apellido Paterno:</strong> @usuarioSeleccionado.apellidoPaterno</p>
                    <p><strong>Apellido Materno:</strong> @usuarioSeleccionado.apellidoMaterno</p>
                    <p><strong>Correo:</strong> @usuarioSeleccionado.correoElectronico</p>
                    <p><strong>Teléfono:</strong> @usuarioSeleccionado.telefono</p>
                    <p><strong>Edad:</strong> @usuarioSeleccionado.edad</p>
                    <p><strong>Tipo:</strong> @usuarioSeleccionado.tipo?.tipoUsuario</p>
                    <p><strong>Estado:</strong> @usuarioSeleccionado.estado?.Nombre</p>
                }
                else
                {
                    <p>Cargando información...</p>
                }
            </div>

        </div>
    </div>
</div>

<!-- MODAL EDITAR USUARIO -->
<div class="modal fade" id="editarUsuarioModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Editar Usuario</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                @if (usuarioSeleccionado != null)
                {
                    <div class="mb-3">
                        <label class="form-label">DNI</label>
                        <input class="form-control" @bind="usuarioSeleccionado.dni" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Nombre</label>
                        <input class="form-control" @bind="usuarioSeleccionado.nombre" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Apellido Paterno</label>
                        <input class="form-control" @bind="usuarioSeleccionado.apellidoPaterno" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Apellido Materno</label>
                        <input class="form-control" @bind="usuarioSeleccionado.apellidoMaterno" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Correo</label>
                        <input class="form-control" @bind="usuarioSeleccionado.correoElectronico" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Teléfono</label>
                        <input class="form-control" @bind="usuarioSeleccionado.telefono" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Edad</label>
                        <input type="number" class="form-control" @bind="usuarioSeleccionado.edad" />
                    </div>
                }
                else
                {
                    <p>Cargando usuario...</p>
                }
            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">
                    Cancelar
                </button>

                <button class="btn btn-primary"
                        data-bs-dismiss="modal"
                        @onclick="GuardarCambiosUsuario">
                    Guardar cambios
                </button>
            </div>

        </div>
    </div>
</div>

<!-- MODAL BLOQUEAR / DESBLOQUEAR USUARIO -->
<div class="modal fade" id="bloquearUsuarioModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                @if (usuarioSeleccionado?.estado?.Nombre == "ELIMINADO")
                {
                    <h5 class="modal-title">Desbloquear Usuario</h5>
                }
                else
                {
                    <h5 class="modal-title">Eliminar Usuario</h5>
                }

                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                @if (usuarioSeleccionado != null)
                {
                    @if (usuarioSeleccionado.estado?.Nombre == "ELIMINADO")
                    {
                        <p>
                            ¿Desea desbloquear al usuario
                            <strong>@usuarioSeleccionado.nombre @usuarioSeleccionado.apellidoPaterno</strong>?
                        </p>
                        <p class="text-muted mb-0">
                            El usuario volverá a estar ACTIVO.
                        </p>
                    }
                    else
                    {
                        <p>
                            ¿Desea eliminar al usuario
                            <strong>@usuarioSeleccionado.nombre @usuarioSeleccionado.apellidoPaterno</strong>?
                        </p>
                        <p class="text-muted mb-0">
                            Esta acción cambiará su estado a ELIMINADO.
                        </p>
                    }
                }
            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">
                    Cancelar
                </button>

                @if (usuarioSeleccionado?.estado?.Nombre == "ELIMINADO")
                {
                    <button class="btn btn-success"
                            data-bs-dismiss="modal"
                            @onclick="BloquearUsuario">
                        Desbloquear
                    </button>
                }
                else
                {
                    <button class="btn btn-danger"
                            data-bs-dismiss="modal"
                            @onclick="BloquearUsuario">
                        Eliminar
                    </button>
                }
            </div>

        </div>
    </div>
</div>

@code {
    private string textoBusqueda = "";
    private int tipoFiltro = 0;
    private int estadoFiltro = 0;

    private List<Usuario>? usuarios;
    private Usuario? usuarioSeleccionado;
    private List<GeneroViewModel> generos = new();
    private List<DistritoViewModel> distritos = new();

    private string nuevoDni = "";
    private string nuevoNombre = "";
    private string nuevoApellidoPaterno = "";
    private string nuevoApellidoMaterno = "";
    private string nuevoTelefono = "";
    private int nuevaEdad = 18;
    private string nuevoCorreo = "";
    private string nuevaContrasena = "";
    private DateTime nuevaFechaNacimiento = DateTime.Today.AddYears(-18);
    private int nuevoIdGenero = 1;
    private int nuevoIdDistrito = 1;
    private int nuevoIdTipoUsuario = 1;
    private string errorRegistro = "";

    protected override async Task OnInitializedAsync()
    {
        usuarios = await AdminService.ListarUsuarios();
        generos = await AdminService.ListarGeneros();
        distritos = await AdminService.ListarDistritos();

        nuevoIdGenero = generos.FirstOrDefault()?.IdGenero ?? 0;
        nuevoIdDistrito = distritos.FirstOrDefault()?.IdDistrito ?? 0;
    }

    private IEnumerable<Usuario> UsuariosFiltrados =>
        usuarios == null
            ? Enumerable.Empty<Usuario>()
            : usuarios.Where(u =>
                CoincideBusqueda(u) &&
                CoincideTipo(u) &&
                CoincideEstado(u)
            );

    private bool CoincideBusqueda(Usuario u)
    {
        if (string.IsNullOrWhiteSpace(textoBusqueda))
            return true;

        string textoUsuario =
            $"{u.nombre} {u.apellidoPaterno} {u.apellidoMaterno} {u.correoElectronico}";

        return textoUsuario.Contains(
            textoBusqueda,
            StringComparison.OrdinalIgnoreCase
        );
    }

    private bool CoincideTipo(Usuario u)
    {
        if (tipoFiltro == 0)
            return true;

        string tipo = u.tipo?.tipoUsuario?.Trim().ToUpperInvariant() ?? "";

        return tipoFiltro switch
        {
            1 => tipo == "CLIENTE",
            2 => tipo == "ANFITRION",
            3 => tipo == "ADMIN",
            _ => true
        };
    }

    private bool CoincideEstado(Usuario u)
    {
        if (estadoFiltro == 0)
            return true;

        string estado = u.estado?.Nombre?.Trim().ToUpperInvariant() ?? "";

        return estadoFiltro switch
        {
            1 => estado == "ACTIVO",
            2 => estado == "ELIMINADO",
            _ => true
        };
    }

    private async Task CambiarFiltroTipo(ChangeEventArgs e)
    {
        int.TryParse(e.Value?.ToString(), out tipoFiltro);
        await AplicarFiltros();
    }

    private async Task CambiarFiltroEstado(ChangeEventArgs e)
    {
        int.TryParse(e.Value?.ToString(), out estadoFiltro);
        await AplicarFiltros();
    }

    private async Task AplicarFiltros()
    {
        if (tipoFiltro > 0)
        {
            usuarios = await AdminService.FiltrarUsuariosPorTipo(tipoFiltro);
        }
        else if (estadoFiltro > 0)
        {
            usuarios = await AdminService.FiltrarUsuariosPorEstado(estadoFiltro);
        }
        else
        {
            usuarios = await AdminService.ListarUsuarios();
        }
    }

    private void PrepararNuevoUsuario()
    {
        nuevoDni = "";
        nuevoNombre = "";
        nuevoApellidoPaterno = "";
        nuevoApellidoMaterno = "";
        nuevoTelefono = "";
        nuevaEdad = 18;
        nuevoCorreo = "";
        nuevaContrasena = "";
        nuevaFechaNacimiento = DateTime.Today.AddYears(-18);
        nuevoIdGenero = generos.FirstOrDefault()?.IdGenero ?? 0;
        nuevoIdDistrito = distritos.FirstOrDefault()?.IdDistrito ?? 0;
        nuevoIdTipoUsuario = 1;
        errorRegistro = "";
    }

    private async Task RegistrarNuevoUsuario()
    {
        try
        {
            errorRegistro = "";

            if (string.IsNullOrWhiteSpace(nuevoDni) ||
                string.IsNullOrWhiteSpace(nuevoNombre) ||
                string.IsNullOrWhiteSpace(nuevoApellidoPaterno) ||
                string.IsNullOrWhiteSpace(nuevoApellidoMaterno) ||
                string.IsNullOrWhiteSpace(nuevoTelefono) ||
                string.IsNullOrWhiteSpace(nuevoCorreo) ||
                string.IsNullOrWhiteSpace(nuevaContrasena))
            {
                errorRegistro = "Debe completar todos los campos obligatorios.";
                return;
            }

            var usuarioRegistro = new
            {
                dni = nuevoDni.Trim(),
                nombre = nuevoNombre.Trim(),
                apellidoPaterno = nuevoApellidoPaterno.Trim(),
                apellidoMaterno = nuevoApellidoMaterno.Trim(),
                telefono = nuevoTelefono.Trim(),
                edad = nuevaEdad,
                correoElectronico = nuevoCorreo.Trim(),
                contrasena = nuevaContrasena,
                fechaNacimiento = nuevaFechaNacimiento.ToString("yyyy-MM-dd"),
                idGenero = nuevoIdGenero,
                idDistrito = nuevoIdDistrito,
                idTipoUsuario = nuevoIdTipoUsuario
            };

            await AdminService.RegistrarUsuario(usuarioRegistro);

            await AplicarFiltros();

            await JS.InvokeVoidAsync(
                "eval",
                "bootstrap.Modal.getInstance(document.getElementById('registrarUsuarioModal'))?.hide();"
            );
            if (nuevoIdGenero <= 0)
            {
                errorRegistro = "Debe seleccionar un género.";
                return;
            }

            if (nuevoIdDistrito <= 0)
            {
                errorRegistro = "Debe seleccionar un distrito.";
                return;
            }

            PrepararNuevoUsuario();
        }
        catch (Exception ex)
        {
            errorRegistro = "No se pudo registrar el usuario: " + ex.Message;
        }
    }

    private async Task VerUsuario(int id)
    {
        usuarioSeleccionado = null;
        usuarioSeleccionado = await AdminService.ObtenerUsuario(id);
    }

    private async Task EditarUsuario(int id)
    {
        usuarioSeleccionado = null;
        usuarioSeleccionado = await AdminService.ObtenerUsuario(id);
    }

    private void SeleccionarUsuario(Usuario usuario)
    {
        usuarioSeleccionado = usuario;
    }

    private async Task GuardarCambiosUsuario()
    {
        if (usuarioSeleccionado == null)
            return;

        if (usuarioSeleccionado.idDistrito <= 0)
            usuarioSeleccionado.idDistrito = 1;

        if (usuarioSeleccionado.distrito == null ||
            usuarioSeleccionado.distrito.IdDistrito <= 0)
        {
            usuarioSeleccionado.distrito = new DistritoViewModel
            {
                IdDistrito = usuarioSeleccionado.idDistrito
            };
        }

        usuarioSeleccionado.genero ??= new GeneroViewModel
        {
            IdGenero = 1
        };

        usuarioSeleccionado.estado ??= new EstadoUsuarioViewModel
        {
            IdEstadoUsuario = 1
        };

        await AdminService.ActualizarUsuario(
            usuarioSeleccionado.idUsuario,
            usuarioSeleccionado
        );

        await AplicarFiltros();
    }

    private async Task BloquearUsuario()
    {
        if (usuarioSeleccionado == null)
            return;

        if (usuarioSeleccionado.estado?.Nombre == "ELIMINADO")
        {
            await AdminService.DesbloquearUsuario(usuarioSeleccionado.idUsuario);
        }
        else
        {
            await AdminService.BloquearUsuario(usuarioSeleccionado.idUsuario);
        }

        await AplicarFiltros();
    }

    private async Task LimpiarFiltros()
    {
        textoBusqueda = "";
        tipoFiltro = 0;
        estadoFiltro = 0;

        usuarios = await AdminService.ListarUsuarios();
    }
}
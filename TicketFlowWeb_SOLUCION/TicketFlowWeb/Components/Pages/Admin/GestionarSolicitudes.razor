@page "/admin/solicitudes"
@using Microsoft.AspNetCore.Authorization
@using TicketFlowWeb.Models
@using TicketFlowWeb.Services.AdministradorRS

@attribute [Authorize(Roles = "ADMIN")]
@layout AdminLayout

@inject AdministradorRestService AdminService

<PageTitle>Panel de Solicitudes</PageTitle>

<h3>Gestión de Solicitudes</h3>

<nav class="navbar bg-body-tertiary">
    <div class="filtros-pagos">
        <label>Buscar:</label>
        <input type="text"
               class="form-control filtro-input"
               placeholder="Buscar por nombre..."
               @bind="textoBusqueda"
               @bind:event="oninput" />

        <label>Estado:</label>
        <select class="form-select filtro-input"
                value="@estadoFiltro"
                @onchange="CambiarFiltroEstado">
            <option value="0">Todos</option>
            <option value="1">Pendiente</option>
            <option value="2">Aprobada</option>
            <option value="3">Rechazada</option>
        </select>

        <button class="btn btn-dark" @onclick="LimpiarFiltros">
            <i class="bi bi-x-circle"></i>
        </button>
    </div>
</nav>

<div class="mt-4">
    @if (SolicitudesFiltradas.Any())
    {
        <div class="table-responsive">
            <table class="table table-bordered table-hover">
                <thead class="table-primary">
                    <tr>
                        <th>ID</th>
                        <th>Nombre</th>
                        <th>Apellido Paterno</th>
                        <th>Contacto</th>
                        <th>Motivo</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var solicitud in SolicitudesFiltradas)
                    {
                        <tr>
                            <td>@solicitud.IdSolicitudes</td>
                            <td>@solicitud.Cliente?.nombre</td>
                            <td>@solicitud.Cliente?.apellidoPaterno</td>
                            <td>@solicitud.TelefonoContacto</td>
                            <td>@solicitud.Motivo</td>
                            <td>@solicitud.EstadoSolicitud?.Estado</td>

                            <td>
                                <button class="btn btn-outline-dark btn-sm"
                                        data-bs-toggle="modal"
                                        data-bs-target="#verSolicitudModal"
                                        @onclick="() => SeleccionarSolicitud(solicitud)">
                                    <i class="bi bi-eye"></i>
                                </button>

                                @if (solicitud.IdEstadoSolicitud == 1)
                                {
                                    <button class="btn btn-outline-success btn-sm"
                                            data-bs-toggle="modal"
                                            data-bs-target="#aprobarSolicitudModal"
                                            @onclick="() => SeleccionarSolicitud(solicitud)">
                                        <i class="bi bi-check-lg"></i>
                                    </button>

                                    <button class="btn btn-outline-danger btn-sm"
                                            data-bs-toggle="modal"
                                            data-bs-target="#rechazarSolicitudModal"
                                            @onclick="() => SeleccionarSolicitud(solicitud)">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-outline-success btn-sm"
                                            data-bs-toggle="modal"
                                            data-bs-target="#eliminarSolicitudModal"
                                            @onclick="() => SeleccionarSolicitud(solicitud)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center py-5 border rounded bg-light">
            <i class="bi bi-search fs-1 text-secondary"></i>
            <h5 class="mt-3 text-secondary">No se encontraron coincidencias</h5>
        </div>
    }
</div>

<!-- MODAL VER -->
<div class="modal fade" id="verSolicitudModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Detalle de Solicitud</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                @if (solicitudSeleccionada != null)
                {
                    <p><strong>ID:</strong> @solicitudSeleccionada.IdSolicitudes</p>
                    <p><strong>ID Cliente:</strong> @solicitudSeleccionada.IdCliente</p>
                    <p><strong>Nombre:</strong> @solicitudSeleccionada.Cliente?.nombre</p>
                    <p><strong>Apellido Paterno:</strong> @solicitudSeleccionada.Cliente?.apellidoPaterno</p>
                    <p><strong>Apellido Materno:</strong> @solicitudSeleccionada.Cliente?.apellidoMaterno</p>
                    <p><strong>Correo:</strong> @solicitudSeleccionada.CorreoContacto</p>
                    <p><strong>Teléfono:</strong> @solicitudSeleccionada.TelefonoContacto</p>
                    <p><strong>Motivo:</strong> @solicitudSeleccionada.Motivo</p>
                    <p><strong>Estado:</strong> @solicitudSeleccionada.EstadoSolicitud?.Estado</p>
                }
            </div>

        </div>
    </div>
</div>

<!-- MODAL APROBAR -->
<div class="modal fade" id="aprobarSolicitudModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Aprobar Solicitud</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                @if (solicitudSeleccionada != null)
                {
                    <p>
                        ¿Desea aprobar la solicitud de
                        <strong>@solicitudSeleccionada.Cliente?.nombre @solicitudSeleccionada.Cliente?.apellidoPaterno</strong>?
                    </p>
                }
            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">
                    Cancelar
                </button>

                <button class="btn btn-success"
                        data-bs-dismiss="modal"
                        @onclick="ConfirmarAprobacion">
                    Aceptar
                </button>
            </div>

        </div>
    </div>
</div>

<!-- MODAL RECHAZAR -->
<div class="modal fade" id="rechazarSolicitudModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Rechazar Solicitud</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                @if (solicitudSeleccionada != null)
                {
                    <p>
                        ¿Desea rechazar la solicitud de
                        <strong>@solicitudSeleccionada.Cliente?.nombre @solicitudSeleccionada.Cliente?.apellidoPaterno</strong>?
                    </p>
                }
            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">
                    Cancelar
                </button>

                <button class="btn btn-danger"
                        data-bs-dismiss="modal"
                        @onclick="ConfirmarRechazo">
                    Aceptar
                </button>
            </div>

        </div>
    </div>
</div>

<!-- MODAL ELIMINAR -->
<div class="modal fade" id="eliminarSolicitudModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Eliminar Solicitud</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                @if (solicitudSeleccionada != null)
                {
                    <p>
                        ¿Desea eliminar esta solicitud?
                    </p>
                }
            </div>

        </div>
    </div>
</div>

@code {

    private string textoBusqueda = "";
    private int estadoFiltro = 0;

    private SolicitudViewModel? solicitudSeleccionada;

    private List<SolicitudViewModel> solicitudes = new();

    protected override async Task OnInitializedAsync()
    {
        solicitudes = await AdminService.ListarSolicitudes();
    }

    private IEnumerable<SolicitudViewModel> SolicitudesFiltradas =>
        solicitudes.Where(s =>
            string.IsNullOrWhiteSpace(textoBusqueda)
            ||
            (s.Cliente?.nombre ?? "").Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase)
            ||
            (s.Cliente?.apellidoPaterno ?? "").Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase)
            ||
            (s.Cliente?.apellidoMaterno ?? "").Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase)
        );

    private async Task CambiarFiltroEstado(ChangeEventArgs e)
    {
        int.TryParse(e.Value?.ToString(), out estadoFiltro);
        await AplicarFiltroEstado();
    }

    private async Task AplicarFiltroEstado()
    {
        if (estadoFiltro > 0)
        {
            solicitudes = await AdminService.FiltrarSolicitudesPorEstado(estadoFiltro);
        }
        else
        {
            solicitudes = await AdminService.ListarSolicitudes();
        }
    }

    private void SeleccionarSolicitud(SolicitudViewModel solicitud)
    {
        solicitudSeleccionada = solicitud;
    }

    private async Task LimpiarFiltros()
    {
        textoBusqueda = "";
        estadoFiltro = 0;
        solicitudes = await AdminService.ListarSolicitudes();
    }

    private async Task ConfirmarAprobacion()
    {
        if (solicitudSeleccionada == null)
            return;

        await AdminService.AprobarSolicitud(solicitudSeleccionada.IdSolicitudes);

        await AplicarFiltroEstado();
    }

    private async Task ConfirmarRechazo()
    {
        if (solicitudSeleccionada == null)
            return;

        await AdminService.RechazarSolicitud(solicitudSeleccionada.IdSolicitudes);

        await AplicarFiltroEstado();
    }
}
@page "/admin/solicitudes"
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize(Roles = "ADMIN")]
@layout AdminLayout

<PageTitle>Panel de Solicitudes</PageTitle>

<h3>Gestión de Solicitudes</h3>

<nav class="navbar bg-body-tertiary">
    <div class="filtros-pagos">
        <label>Buscar:</label>
        <input type="text"
               class="form-control filtro-input"
               placeholder="Buscar nombre..."
               @bind="textoBusqueda"
               @bind:event="oninput" />

        <button class="btn btn-dark" @onclick="LimpiarFiltros">
            <i class="bi bi-funnel-fill"></i>
        </button>
    </div>
</nav>

<div class="mt-4">
    @if (SolicitudesFiltradas.Any())
    {
        <div class="table-responsive">
            <table class="table table-bordered table-hover">
                <thead class="table-primary">
                    <tr>
                        <th>ID</th>
                        <th>Nombre</th>
                        <th>Apellido Paterno</th>
                        <th>Contacto</th>
                        <th>Motivo</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var solicitud in SolicitudesFiltradas)
                    {
                        <tr>
                            <td>@solicitud.Id</td>
                            <td>@solicitud.Nombre</td>
                            <td>@solicitud.ApellidoPaterno</td>
                            <td>@solicitud.Contacto</td>
                            <td>@solicitud.Motivo</td>
                            <td>@solicitud.Estado</td>

                            <td>
                                <!-- Ver -->
                                <button class="btn btn-outline-dark btn-sm"
                                        data-bs-toggle="modal"
                                        data-bs-target="#verSolicitudModal"
                                        @onclick="() => SeleccionarSolicitud(solicitud)">
                                    <i class="bi bi-eye"></i>
                                </button>

                                <!-- Editar -->
                                <button class="btn btn-outline-warning btn-sm"
                                        data-bs-toggle="modal"
                                        data-bs-target="#editarSolicitudModal"
                                        @onclick="() => SeleccionarSolicitud(solicitud)">
                                    <i class="bi bi-pencil"></i>
                                </button>

                                @if (solicitud.Estado == "Pendiente")
                                {
                                    <!-- Aprobar -->
                                    <button class="btn btn-outline-success btn-sm"
                                            data-bs-toggle="modal"
                                            data-bs-target="#aprobarSolicitudModal"
                                            @onclick="() => SeleccionarSolicitud(solicitud)">
                                        <i class="bi bi-check-lg"></i>
                                    </button>

                                    <!-- Rechazar -->
                                    <button class="btn btn-outline-danger btn-sm"
                                            data-bs-toggle="modal"
                                            data-bs-target="#rechazarSolicitudModal"
                                            @onclick="() => SeleccionarSolicitud(solicitud)">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                }
                                else
                                {
                                    <!-- Eliminar -->
                                    <button class="btn btn-outline-success btn-sm"
                                            data-bs-toggle="modal"
                                            data-bs-target="#eliminarSolicitudModal"
                                            @onclick="() => SeleccionarSolicitud(solicitud)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center py-5 border rounded bg-light">
            <i class="bi bi-search fs-1 text-secondary"></i>
            <h5 class="mt-3 text-secondary">No se encontraron coincidencias</h5>
        </div>
    }
</div>

<!-- MODAL VER -->

<div class="modal fade" id="verSolicitudModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Detalle de Solicitud</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                @if (solicitudSeleccionada != null)
                {
                    <p><strong>ID:</strong> @solicitudSeleccionada.Id</p>
                    <p><strong>Nombre:</strong> @solicitudSeleccionada.Nombre</p>
                    <p><strong>Apellido:</strong> @solicitudSeleccionada.ApellidoPaterno</p>
                    <p><strong>Contacto:</strong> @solicitudSeleccionada.Contacto</p>
                    <p><strong>Motivo:</strong> @solicitudSeleccionada.Motivo</p>
                    <p><strong>Estado:</strong> @solicitudSeleccionada.Estado</p>
                }
            </div>

        </div>
    </div>
</div>

<!-- MODAL EDITAR -->

<div class="modal fade" id="editarSolicitudModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Editar Solicitud</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <p>Formulario de edición pendiente.</p>
            </div>

        </div>
    </div>
</div>

<!-- MODAL APROBAR -->

<div class="modal fade" id="aprobarSolicitudModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Aprobar Solicitud</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                ¿Desea aprobar esta solicitud?
            </div>

        </div>
    </div>
</div>

<!-- MODAL RECHAZAR -->

<div class="modal fade" id="rechazarSolicitudModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Rechazar Solicitud</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                ¿Desea rechazar esta solicitud?
            </div>

        </div>
    </div>
</div>

<!-- MODAL ELIMINAR -->

<div class="modal fade" id="eliminarSolicitudModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Eliminar Solicitud</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                ¿Desea eliminar esta solicitud?
            </div>

        </div>
    </div>
</div>


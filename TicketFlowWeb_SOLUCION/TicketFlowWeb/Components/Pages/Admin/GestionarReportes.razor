@page "/admin/reportes"
@using Microsoft.AspNetCore.Authorization
@inject TicketFlow.Services.ReporteRS.ReporteService ReporteService

@attribute [Authorize(Roles = "ADMIN")]
@layout AdminLayout

<PageTitle>Panel de Reportes</PageTitle>

<h3>Gestión de Reportes</h3>

<div class="mt-4">
    <table class="table table-bordered table-hover">
        <thead class="table-primary">
            <tr>
                <th>Reporte</th>
                <th>Descripción</th>
                <th>Acción</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var reporte in reportes)
            {
                <tr>
                    <td>@reporte.Nombre</td>
                    <td>@reporte.Descripcion</td>
                    <td>
                        <button class="btn btn-outline-dark btn-sm"
                                data-bs-toggle="modal"
                                data-bs-target="#reporteModal"
                                @onclick="() => SeleccionarReporte(reporte)">
                            Generar
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="modal fade" id="reporteModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">

            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">
                    <i class="bi bi-file-earmark-bar-graph me-2"></i>
                    Reporte
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                @if (reporteSeleccionado != null)
                {
                    <h5>@reporteSeleccionado.Nombre</h5>
                    <p class="text-muted">@reporteSeleccionado.Descripcion</p>

                    <div class="border rounded p-4 text-center text-muted">
                        Contenido del reporte pendiente.
                    </div>
                }
            </div>

            <div class="modal-footer">
                @if (reporteSeleccionado?.Nombre == "Fidelización")
                {
                    <button class="btn btn-primary btn-sm"
                            @onclick="GenerarPdfFidelizacion"
                            disabled="@cargando">
                        @if (cargando)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            <span>Generando...</span>
                        }
                        else
                        {
                            <i class="bi bi-file-earmark-pdf me-1"></i>
                            <span>Descargar PDF</span>
                        }
                    </button>
                }
                @if (reporteSeleccionado?.Nombre == "Ocupación de Eventos")
                {
                    <button class="btn btn-primary btn-sm"
                            @onclick="GenerarPdfOcupacion"
                            disabled="@cargando">
                        @if (cargando)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            <span>Generando...</span>
                        }
                        else
                        {
                            <i class="bi bi-file-earmark-pdf me-1"></i>
                            <span>Descargar PDF</span>
                        }
                    </button>
                }
                @if (errorMensaje != null)
                {
                    <span class="text-danger small me-auto">@errorMensaje</span>
                }
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"
                        @onclick="LimpiarEstado">
                    Cerrar
                </button>
            </div>

        </div>
    </div>
</div>

@code {
    private Reporte? reporteSeleccionado;
    private bool cargando = false;
    private string? errorMensaje;

    private List<Reporte> reportes = new()
    {
        new Reporte
        {
            Nombre = "Ventas Totales",
            Descripcion = "Ventas por categoría y fechas"
        },
        new Reporte
        {
            Nombre = "Fidelización",
            Descripcion = "Usuarios con más puntos acumulados y canjeados"
        },
        new Reporte
        {
            Nombre = "Ocupación de Eventos",
            Descripcion = "Eventos con mayor y menor ocupación"
        }
    };

    private void SeleccionarReporte(Reporte reporte)
    {
        reporteSeleccionado = reporte;
        errorMensaje = null;
    }

    private void LimpiarEstado()
    {
        errorMensaje = null;
        cargando = false;
    }

    private async Task GenerarPdfOcupacion()
{
    cargando = true;
    errorMensaje = null;

    try
    {
        await ReporteService.DescargarReporteOcupacionAsync();
    }
    catch (Exception ex)
    {
        errorMensaje = ex.Message;
    }
    finally
    {
        cargando = false;
    }
}

    private async Task GenerarPdfFidelizacion()
    {
        cargando = true;
        errorMensaje = null;

        try
        {
            await ReporteService.DescargarReporteFidelizacionAsync();
        }
        catch (Exception ex)
        {
            errorMensaje = ex.Message;
        }
        finally
        {
            cargando = false;
        }
    }

    public class Reporte
    {
        public string Nombre { get; set; } = "";
        public string Descripcion { get; set; } = "";
    }
}

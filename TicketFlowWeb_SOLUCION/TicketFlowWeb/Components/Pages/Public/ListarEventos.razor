@code {

    public class categoriaEvento
    {
        public List<EventoDTO> eventos { get; set; } = new();
        public string Categoria { get; set; } = "";
        public int PosicionActual { get; set; } = 0;
    }

    [Parameter]
    [SupplyParameterFromQuery(Name = "criterio")]
    public string? CriterioActual { get; set; }

    // Captura el precio máximo desde la URL si existe (?precio=150)
    [Parameter]
    [SupplyParameterFromQuery(Name = "precio")]
    public double? PrecioMaximoUrl { get; set; }

    // Variable vinculada al input numérico
    private double? precioMaximoInput;

    private List<categoriaEvento> ListaDeCategorias = new List<categoriaEvento>();
    private const int anchoTarjeta = 365;
    private bool mostrarMenuFiltro = false;

    private void ToggleFilterMenu()
    {
        mostrarMenuFiltro = !mostrarMenuFiltro;
    }

    private void AplicarFiltro(string criterio)
    {
        mostrarMenuFiltro = false;
        precioMaximoInput = null; // Limpiamos el input si eligen otra opción
        Navigation.NavigateTo($"/public/descubrir?criterio={criterio}");
    }

    private void AplicarFiltroPrecio()
    {
        mostrarMenuFiltro = false;
        if (precioMaximoInput.HasValue && precioMaximoInput > 0)
        {
            // Redirige pasando el criterio de precio y el valor introducido
            Navigation.NavigateTo($"/public/descubrir?criterio=precioMax&precio={precioMaximoInput}");
        }
        else
        {
            // Si el input está vacío o es 0, mostramos todos
            Navigation.NavigateTo($"/public/descubrir?criterio=todos");
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        // Sincroniza el input con el valor actual de la URL al recargar
        if (CriterioActual == "precioMax")
        {
            precioMaximoInput = PrecioMaximoUrl;
        }
        await CargarEventosFiltrados();
    }

    private async Task CargarEventosFiltrados()
    {
        try
        {
            List<EventoDTO> eventos = new List<EventoDTO>();

            switch (CriterioActual?.ToLower())
            {
                case "preciomax":
                    // Opción A: Si tu API soporta filtrar por precio en el backend:
                    // eventos = await EventoService.ListarEventosPorPrecioMaxAsync(PrecioMaximoUrl ?? 0);

                    // Opción B: Si prefieres filtrarlo en memoria con los eventos base:
                    var todosLosEventos = await EventoService.ListarEventosAsync();
                    eventos = todosLosEventos.Where(e => e.precio <= (PrecioMaximoUrl ?? double.MaxValue)).ToList();
                    break;
                case "todos":
                default:
                    eventos = await EventoService.ListarEventosAsync();
                    break;
            }

            if (eventos != null)
            {
                ListaDeCategorias = eventos
                    .GroupBy(e => e.categoria ?? "SIN")
                    .Select(g => new categoriaEvento
                    {
                        Categoria = g.Key,
                        eventos = g.ToList(),
                        PosicionActual = 0
                    })
                    .ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"ERROR AL CARGAR FILTROS: {ex.Message}");
        }
    }

    // Mantén tus métodos ScrollLeft, ScrollRight, RedirigirADetalles y clase categoriaEvento abajo...

    private void ScrollLeft(categoriaEvento categoria) => categoria.PosicionActual = Math.Max(0, categoria.PosicionActual - anchoTarjeta);
    private void ScrollRight(categoriaEvento categoria) => categoria.PosicionActual = Math.Min(anchoTarjeta * (categoria.eventos.Count - 3), categoria.PosicionActual + anchoTarjeta);
    private void RedirigirADetalles(EventoDTO evento) => Navigation.NavigateTo($"/public/detalle-evento/" + evento.idEvento);
}
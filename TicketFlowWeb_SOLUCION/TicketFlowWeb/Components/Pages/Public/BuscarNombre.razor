@page "/public/descubrir/buscar/{nombre}"

@inject HttpClient Http
@inject NavigationManager Navigation
@using TicketFlowWeb.Services.EventoRS
@inject EventoRestService EventoService
@using TicketFlowWeb.Models.DTO;
@using Newtonsoft.Json;

<div class="portal-container">

    <div class="header-container">
        <h1 class="main-page-title">Resultados de Busqueda</h1>

        <div class="filter-dropdown">
            <button class="btn-filter" @onclick="ToggleFilterMenu">
                <span class="filter-icon">⏳</span> Filtrar por
            </button>

            @if (mostrarMenuFiltro)
            {
                <div class="dropdown-menu-content">
                    <button class="dropdown-item" @onclick="LimpiarFiltro">Ver todos los precios</button>

                    <div class="dropdown-divider"></div>

                    <div class="price-filter-container">
                        <label class="price-label">Precio Máximo (S/):</label>
                        <div class="price-input-group">
                            <input type="number" class="price-input" min="0" @bind="precioMaximoInput" placeholder="Ej. 100" />
                            <button class="btn-aplicar-precio" @onclick="AplicarFiltroPrecio">Ok</button>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    @if (cargando)
    {
        <div class="no-events">
            <p>Cargando resultados ...</p>
        </div>
    }
    else if (EventosPaginados.Any())
    {
        <div class="events-grid">
            @foreach (var evento in EventosPaginados)
            {
                <div class="event-card">
                    <div class="card-image-box">
                        <img src="@evento.img"
                             alt="@evento.titulo"
                             class="event-image"
                             onerror="this.src='/images/no-image.png';" />
                    </div>
                    <div class="card-body">
                        <h3 class="event-name">@evento.titulo</h3>
                        <div class="event-details">
                            <p class="event-info"><strong>Fecha:</strong> @evento.fecha</p>
                            <p class="event-info"><strong>Hora:</strong> @evento.hora_inicio</p>
                            <p class="event-info"><strong>Precio:</strong> S/ @evento.precio.ToString("F2")</p>
                        </div>
                        <a href="/public/detalle-evento/@evento.idEvento" class="btn-mas-informacion">
                            MAS INFORMACION
                        </a>
                    </div>
                </div>
            }
        </div>

        <div class="pagination-container">
            <button class="page-btn" @onclick="PaginaAnterior" disabled="@(paginaActual == 1)">
                ← Anterior
            </button>

            <span class="page-indicator">
                Página <strong>@paginaActual</strong> de <strong>@TotalPaginas</strong>
            </span>

            <button class="page-btn" @onclick="PaginaSiguiente" disabled="@(paginaActual == TotalPaginas)">
                Siguiente →
            </button>
        </div>
    }
    else
    {
        <div class="no-events">
            <p>No se encontraron eventos disponibles que concuerden con tu busqueda.</p>
        </div>
    }
</div>

<style>

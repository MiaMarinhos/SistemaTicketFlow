        margin-top: 40px;
        padding-top: 20px;
        border-top: 1px solid #e5e7eb;
    }

    .page-btn {
        background-color: #12192c;
        color: #ffffff;
        border: none;
        padding: 10px 20px;
        font-weight: bold;
        border-radius: 6px;
        cursor: pointer;
        transition: opacity 0.2s;
    }

        .page-btn:hover:not(:disabled) {
            background-color: #1e294b;
        }

        .page-btn:disabled {
            background-color: #d1d5db;
            color: #9ca3af;
            cursor: not-allowed;
        }

    .page-indicator {
        font-size: 1rem;
        color: #374151;
    }

    .no-events {
        text-align: center;
        padding: 60px;
        color: #6b7280;
        font-size: 1.2rem;
    }
</style>

@code {
    private bool cargando = true;

    [Parameter]
    public string nombre { get; set; } = string.Empty;

    // Lee el precio desde la URL (?precio=120) sin afectar el parámetro de ruta 'nombre'
    [Parameter]
    [SupplyParameterFromQuery(Name = "precio")]
    public double? PrecioMaximoUrl { get; set; }

    private double? precioMaximoInput;
    private bool mostrarMenuFiltro = false;

    // Variables de paginación
    private int paginaActual = 1;
    private const int ElementosPorPagina = 6;
    private List<EventoDTO> TodosLosEventos = new List<EventoDTO>();

    // Filtramos localmente usando LINQ antes de aplicar la paginación matemática
    private IEnumerable<EventoDTO> EventosFiltrados =>
        PrecioMaximoUrl.HasValue && PrecioMaximoUrl > 0
            ? TodosLosEventos.Where(e => e.precio <= PrecioMaximoUrl.Value)
            : TodosLosEventos;

    private IEnumerable<EventoDTO> EventosPaginados =>
        EventosFiltrados
            .Skip((paginaActual - 1) * ElementosPorPagina)
            .Take(ElementosPorPagina);

    private int TotalPaginas => (int)Math.Ceiling((double)EventosFiltrados.Count() / ElementosPorPagina);

    private void PaginaAnterior() => paginaActual = Math.Max(1, paginaActual - 1);
    private void PaginaSiguiente() => paginaActual = Math.Min(TotalPaginas, paginaActual + 1);

    private void ToggleFilterMenu() => mostrarMenuFiltro = !mostrarMenuFiltro;

    private void AplicarFiltroPrecio()
    {
        mostrarMenuFiltro = false;
        paginaActual = 1; // Reseteamos la página

        if (precioMaximoInput.HasValue && precioMaximoInput > 0)
        {
            Navigation.NavigateTo($"/public/descubrir/buscar/{nombre}?precio={precioMaximoInput}");
        }
        else
        {
            LimpiarFiltro();
        }
    }

    private void LimpiarFiltro()
    {
        mostrarMenuFiltro = false;
        precioMaximoInput = null;
        paginaActual = 1;
        Navigation.NavigateTo($"/public/descubrir/buscar/{nombre}");
    }

    protected override async Task OnParametersSetAsync()
    {
        cargando = true;

        // Mantenemos sincronizada la caja de texto con el query string de la URL
        precioMaximoInput = PrecioMaximoUrl;

        try
        {
            // Ejecuta la búsqueda por nombre en tu API
            TodosLosEventos = await EventoService.BuscarPorNombreAsync(nombre);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al buscar eventos: {ex.Message}");
        }
        finally
        {
            cargando = false;
        }
    }
}
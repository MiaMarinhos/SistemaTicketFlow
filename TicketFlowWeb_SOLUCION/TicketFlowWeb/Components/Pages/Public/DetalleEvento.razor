@page "/public/detalle-evento/{Id:int}"

@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization
@using System.Collections.Generic
@using TicketFlowWeb.Models.DTO
@using TicketFlowWeb.Services.EventoRS
@inject EventoRestService EventoService


@if (evento == null)
{
    <p>Cargando...</p>
}
else
{
    <div class="detalle-evento-page">

        <div class="detalle-contenedor">

            <div class="poster-evento @evento.categoria">
                <div class="poster-contenido">
                    <p class="poster-fecha">@evento.fecha</p>
                    <h2>@evento.titulo</h2>
                    <p class="poster-lugar">@evento.ubicacion</p>
                </div>
            </div>

            <div class="info-evento">
                <h1>@evento.titulo</h1>

                <div class="descripcion">
                    @evento.descripcion;
                </div>

                <div class="datos-evento">
                    <div class="fila-dato">
                        <label>Fecha</label>
                        <span>@evento.fecha</span>
                    </div>

                    <div class="fila-dato">
                        <label>Ubicación</label>
                        <span>@evento.ubicacion</span>
                    </div>

                    <div class="fila-dato">
                        <label>Precio</label>
                        <span>@evento.precio</span>
                    </div>
                </div>

                <div class="acciones">
                    <a href="/" class="btn-volver">Volver</a>

                    <AuthorizeView>
                        <Authorized>
                            <a href="@($"/cliente/resumen-compra/{evento.idEvento}")" class="btn-comprar">
                                Comprar entrada
                            </a>
                        </Authorized>

                        <NotAuthorized>
                            <a href="/login" class="btn-comprar">
                                Comprar entrada
                            </a>
                        </NotAuthorized>
                    </AuthorizeView>
                </div>
            </div>

        </div>

    </div>
}



<style>
    .detalle-evento-page {
        min-height: 100vh;
        background: linear-gradient(90deg, #05051f 0%, #1d1270 45%, #3928d8 100%);
        font-family: Arial, Helvetica, sans-serif;
        color: white;
        padding: 60px 70px;
    }

    .detalle-contenedor {
        display: grid;
        grid-template-columns: 420px 1fr;
        gap: 60px;
        align-items: center;
        max-width: 1200px;
        margin: 0 auto;
    }

    .poster-evento {
        height: 600px;
        border: 4px solid #111;
        box-shadow: 0 12px 28px rgba(0, 0, 0, 0.45);
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
    }

    .poster-frio {
        background: linear-gradient(135deg, #111111, #4a4a4a);
    }

    .poster-poemax {
        background: linear-gradient(135deg, #000000, #1c1648);
    }

    .poster-teatro {
        background: linear-gradient(135deg, #21083f, #6931b8);
    }

    .poster-concierto {
        background: linear-gradient(135deg, #08213f, #1787b8);
    }

    .poster-contenido {
        padding: 30px;
    }

    .poster-fecha {
        font-size: 18px;
        letter-spacing: 3px;
        margin-bottom: 35px;
    }

    .poster-evento h2 {
        font-size: 62px;
        font-weight: bold;
        margin-bottom: 15px;
    }

    .poster-evento p {
        font-size: 20px;
    }

    .poster-lugar {
        margin-top: 170px;
        font-size: 17px;
        letter-spacing: 2px;
    }

    .info-evento h1 {
        font-size: 64px;
        font-weight: bold;
        margin-bottom: 35px;
    }

    .descripcion {
        border: 3px solid white;
        border-radius: 20px;
        padding: 30px;
        min-height: 180px;
        font-size: 22px;
        line-height: 1.5;
        margin-bottom: 35px;
    }

    .datos-evento {
        display: flex;
        flex-direction: column;
        gap: 18px;
    }

    .fila-dato {
        display: grid;
        grid-template-columns: 160px 1fr;
        gap: 15px;
        align-items: center;
    }

        .fila-dato label {
            border: 2px solid white;
            border-radius: 8px;
            padding: 14px;
            font-size: 18px;
            font-weight: bold;
        }

        .fila-dato span {
            border: 2px solid white;
            border-radius: 8px;
            padding: 14px;
            font-size: 18px;
        }

    .acciones {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 20px;
        margin-top: 45px;
    }

    .btn-volver,
    .btn-comprar {
        display: inline-block;
        text-decoration: none;
        border-radius: 30px;
        padding: 15px 38px;
        font-size: 18px;
        font-weight: bold;
    }

    .btn-volver {
        color: white;
        border: 3px solid white;
    }

    .btn-comprar {
        color: #160b62;
        background-color: white;
        border: 3px solid white;
    }

    .btn-volver:hover {
        background-color: white;
        color: #160b62;
    }

    .btn-comprar:hover {
        background-color: #dffcff;
        color: #160b62;
    }

    @@media (max-width: 900px) {
        .detalle-evento-page {
            padding: 35px 25px;
        }

        .detalle-contenedor {
            grid-template-columns: 1fr;
            gap: 35px;
        }

        .poster-evento {
            height: 420px;
        }

        .poster-lugar {
            margin-top: 100px;
        }

        .info-evento h1 {
            font-size: 46px;
        }

        .fila-dato {
            grid-template-columns: 1fr;
        }

        .acciones {
            justify-content: center;
            flex-direction: column;
        }

        .btn-volver,
        .btn-comprar {
            text-align: center;
        }
    }
</style>

@code {
    [Parameter]
    public int Id { get; set; }

    private EventoDTO? evento;

    protected override async Task OnInitializedAsync()
    {
        evento = await EventoService.BuscarEventoAsync(Id);
    }
}
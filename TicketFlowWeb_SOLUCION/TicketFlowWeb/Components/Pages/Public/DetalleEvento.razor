@page "/public/detalle-evento/{Id:int}"

@using TicketFlowWeb.Services.EventoRS
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Authorization

@inject EventoRestService EventoService
@inject AuthenticationStateProvider AuthStateProvider

<div class="detalle-evento-page">
    @if (eventoReal == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-light" role="status"></div>
            <p class="mt-2">Cargando detalles del evento...</p>
        </div>
    }
    else
    {
        <div class="detalle-grid-principal">

            <div class="columna-portada">
                <img src="@eventoReal.img" alt="Portada del Evento" class="img-portada" />
            </div>

            <div class="columnas-info-cabecera">
                <div class="grid-cabecera-datos">
                    <div class="bloque-cabecera">
                        <label class="etiqueta-mini">CATEGORÍA</label>
                        <h2>@(eventoReal.categoria?.nombre ?? "Sin Categoría")</h2>
                    </div>
                    <div class="bloque-cabecera">
                        <label class="etiqueta-mini">EVENTO</label>
                        <h1>@eventoReal.titulo</h1>
                    </div>
                    <div class="bloque-cabecera">
                        <label class="etiqueta-mini">PRECIO</label>
                        <h2 class="texto-precio">S/. @eventoReal.precio.ToString("F2")</h2>
                    </div>
                    <br />
                    <div class="bloque-cabecera">
                        <div class="descripcion-caja">
                            @eventoReal.descripcion
                        </div>
                    </div>
                    <br />
                    <div class="acciones-nuevas">
                        @if (esAnfitrion)
                        {
                            <button class="btn-comprar btn-deshabilitado" disabled title="Los anfitriones no pueden comprar entradas.">Comprar entrada</button>
                        }
                        else
                        {
                            <a href="@($"/cliente/compra/{Id}")" class="btn-comprar">Comprar entrada</a>
                        }
                    </div>
                </div>
            </div>

            <div class="columna-vacia-izq">
                <div class="recuadro-anfitrion">
                    <div class="anfitrion-titulo">ORGANIZADO POR</div>
                    <h3>@(eventoReal.anfitrion?.nombre ?? "Anfitrión Desconocido")</h3>
                    @if (!string.IsNullOrEmpty(eventoReal.anfitrion?.razonSocial))
                    {
                        <p class="mb-0 text-white-50">@eventoReal.anfitrion.razonSocial</p>
                    }
                </div>
            </div>

            <div class="columna-datos-tiempo">
                <div class="datos-evento-lista">
                    <div class="fila-dato-nuevo">
                        <label>Entradas Restantes</label>
                        <span>@eventoReal.capacidad_entradas</span>
                    </div>
                    <div class="fila-dato-nuevo">
                        <label>Fecha</label>
                        <span>@(string.IsNullOrEmpty(eventoReal.fecha) ? "---" : eventoReal.fecha)</span>
                    </div>
                    <div class="fila-dato-nuevo">
                        <label>Hora</label>
                        <span>@eventoReal.hora_inicio - @eventoReal.hora_fin</span>
                    </div>

                    <div class="acciones-nuevas">
                        @if (esAnfitrion)
                        {
                            <a href="/anfitrion/gestionar-evento" class="btn-volver">Volver</a>
                            <button class="btn-comprar btn-deshabilitado" disabled title="Los anfitriones no pueden comprar entradas.">Comprar entrada</button>
                        }
                        else
                        {
                            <a href="/public/descubrir" class="btn-volver">Volver</a>
                            <a href="@($"/cliente/compra/{Id}")" class="btn-comprar">Comprar entrada</a>
                        }
                    </div>

                </div>
            </div>

            <div class="columna-datos-ubicacion">
                <div class="datos-evento-lista">
                    <div class="fila-dato-nuevo">
                        <label>Local</label>
                        <span>@eventoReal.nombre_establecimiento</span>
                    </div>
                    <div class="fila-dato-nuevo">
                        <label>Ubicación</label>
                        <span>@eventoReal.ubicacion</span>
                    </div>
                    <div class="fila-dato-nuevo">
                        <label>Lugar</label>
                        <span>@(eventoReal.distrito?.nombre ?? "---") - @(eventoReal.distrito?.region?.nombre ?? "---")</span>
                    </div>
                </div>
            </div>

        </div>
    }
</div>

<style>
    .detalle-evento-page {
        min-height: 100vh;
        background: linear-gradient(90deg, #05051f 0%, #1d1270 45%, #3928d8 100%);
        font-family: Arial, Helvetica, sans-serif;
        color: white;
        padding: 50px;
    }

    /* 🟢 REJILLA EN 3 COLUMNAS IGUALES */
    .detalle-grid-principal {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 40px;
        max-width: 1300px;
        margin: 0 auto;
    }

    .columna-portada {
        grid-column: 1;
    }

    .img-portada {
        width: 100%;
        height: 500px;
        object-fit: cover;
        border: 4px solid white;
        border-radius: 15px;
        background-color: #222;
    }

    .columnas-info-cabecera {
        grid-column: 2 / span 2;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .grid-cabecera-datos {
        display: flex;
        flex-direction: column;
        gap: 15px;
    }

    .etiqueta-mini {
        font-size: 12px;
        letter-spacing: 2px;
        color: #00ffcc;
        font-weight: bold;
        display: block;
        margin-bottom: 2px;
    }

    .columnas-info-cabecera h1 {
        font-size: 48px;
        font-weight: bold;
        margin: 0;
    }

    .columnas-info-cabecera h2 {
        font-size: 28px;
        margin: 0;
    }

    .texto-precio {
        color: #ffcc00;
        font-weight: bold;
    }

    .columna-descripcion-completa {
        grid-column: 1 / span 3;
    }

    .descripcion-caja {
        border: 3px solid white;
        border-radius: 20px;
        padding: 25px;
        font-size: 20px;
        line-height: 1.5;
        background: rgba(255, 255, 255, 0.05);
    }

    .columna-vacia-izq {
        grid-column: 1;
    }

    .columna-datos-tiempo {
        grid-column: 2;
    }

    .columna-datos-ubicacion {
        grid-column: 3;
    }

    .datos-evento-lista {
        display: flex;
        flex-direction: column;
        gap: 15px;
        margin-bottom: 20px;
    }

    .fila-dato-nuevo {
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

        .fila-dato-nuevo label {
            font-size: 14px;
            font-weight: bold;
            text-transform: uppercase;
            color: #a5a2e6;
        }

        .fila-dato-nuevo span {
            border: 2px solid white;
            border-radius: 8px;
            padding: 10px 15px;
            font-size: 17px;
            background: rgba(0, 0, 0, 0.2);
        }

    .recuadro-anfitrion {
        border: 3px dashed #00ffcc;
        border-radius: 12px;
        padding: 18px;
        background: rgba(0, 255, 204, 0.05);
        margin-top: 15px;
        margin-bottom: 25px;
    }

    .anfitrion-titulo {
        font-size: 11px;
        letter-spacing: 1.5px;
        color: #00ffcc;
        font-weight: bold;
        margin-bottom: 5px;
    }

    .recuadro-anfitrion h3 {
        margin: 0;
        font-size: 20px;
        font-weight: bold;
    }

    .acciones-nuevas {
        display: flex;
        gap: 15px;
        margin-top: 20px;
    }

    .btn-volver, .btn-comprar {
        flex: 1;
        text-align: center;
        text-decoration: none;
        border-radius: 25px;
        padding: 12px 20px;
        font-size: 16px;
        font-weight: bold;
        display: inline-block;
        border: 3px solid white;
    }

    .btn-volver {
        color: white;
    }

    .btn-comprar {
        color: #160b62;
        background-color: white;
        cursor: pointer;
    }

    .btn-volver:hover {
        background: white;
        color: #160b62;
    }

    .btn-comprar:hover:not(.btn-deshabilitado) {
        background: #dffcff;
    }

    /* 🚫 ESTILO PARA EL BOTÓN BLOQUEADO */
    .btn-deshabilitado {
        opacity: 0.4;
        cursor: not-allowed;
        background-color: #cccccc !important;
        border-color: #aaaaaa !important;
        color: #666666 !important;
    }

    @@media (max-width: 900px) {
        .detalle-grid-principal {
            grid-template-columns: 1fr;
        }

        .columna-portada, .columnas-info-cabecera, .columna-descripcion-completa,
        .columna-datos-tiempo, .columna-datos-ubicacion {
            grid-column: 1 / span 1;
        }

        .columna-vacia-izq {
            display: none;
        }

        .img-portada {
            height: 350px;
        }
    }
</style>

@code {
    [Parameter]
    public int Id { get; set; }

    private Models.EventoViewModel eventoReal;
    private bool esAnfitrion = false;

    protected override async Task OnInitializedAsync()
    {
        // 1. Cargamos el evento
        eventoReal = await EventoService.verDetalleEventoAsync(Id);

        // 2. Revisamos los credenciales de quien está viendo la página
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        // 3. Verificamos si tiene el rol "ANFITRION"
        if (user.Identity != null && user.Identity.IsAuthenticated)
        {
            esAnfitrion = user.IsInRole("ANFITRION");
        }
    }
}
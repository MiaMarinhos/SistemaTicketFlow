        letter-spacing: 1px;
        color: #666688;
        font-weight: bold;
    }

    .kpi-valor-anf {
        font-size: 32px;
        font-weight: bold;
        color: #15095f;
        margin: 5px 0;
    }

    .contenedor-tabla-anf {
        background: #ffffff;
        border: 1px solid #e1dbf5;
        border-radius: 14px;
        padding: 24px;
        margin-top: 25px;
        box-shadow: 0 4px 15px rgba(21, 9, 95, 0.04);
    }
</style>

@code {
    private bool cargando = true;
    private PerfilAnfitrionViewModel? perfilActual;
    private string nombreAnfitrion = "Cargando...";
    private List<EventoViewModel> misEventos = new();
    private List<EventoDTO> ultimosEventos = new();
    private bool cargandoUltimosEventos = true;

    // Variables para los KPIs (Tarjetas superiores)
    private int totalEventos = 0;
    private int entradasVendidas = 0;
    private int totalEmitidas = 0;
    private decimal ingresosGenerados = 0;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await CargarUltimosEventosAsync();
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity is not null && user.Identity.IsAuthenticated)
            {
                // 1. Asignar el nombre directamente desde la sesión
                nombreAnfitrion = user.Identity.Name ?? "Anfitrión";

                // 2. Continuar con la carga de métricas y eventos
                var idClaim = user.FindFirst("IdUsuario")?.Value;

                if (int.TryParse(idClaim, out int idAnfitrion))
                {
                    // Traer el perfil para el saludo
                    //perfilActual = await AnfitrionService.BuscarAnfitrionAsync(idAnfitrion);
                    //if (perfilActual != null)
                    //{
                    //    nombreAnfitrion = string.IsNullOrWhiteSpace(perfilActual.Nombre) ? "Anfitrión" : perfilActual.Nombre;
                    //}

                    // 1. Descargar y filtrar SOLO tus eventos
                    var todosLosEventos = await AnfitrionService.VerTodosLosEventosAsync();
                    misEventos = await AnfitrionService.VerMisEventosAsync(idAnfitrion) ?? new();

                    // Calculamos métricas básicas
                    totalEventos = misEventos.Count;
                    totalEmitidas = misEventos.Sum(e => e.capacidad_entradas);

                    // 2. Descargar compras para calcular dinero y tickets
                    var compras = await AnfitrionService.VerComprasDeSusEventosAsync(idAnfitrion);

                    entradasVendidas = 0;
                    ingresosGenerados = 0;

                    if (compras != null)
                    {
                        foreach (var compra in compras)
                        {
                            entradasVendidas += compra.entradasCompradas;

                            // Buscamos cuánto costaba la entrada de este evento específico
                            var eventoRelacionado = misEventos.FirstOrDefault(e => e.idEvento == compra.idEvento);
                            if (eventoRelacionado != null)
                            {
                                ingresosGenerados += (compra.entradasCompradas * eventoRelacionado.precio);
                            }
                        }
                    }
                }
            }
        }
        catch (Exception ex)
        {
            nombreAnfitrion = "Crash: " + ex.Message;
        }
        finally
        {
            cargando = false;
        }
    }
    private async Task CargarUltimosEventosAsync()
    {
        try
        {
            cargandoUltimosEventos = true;

            var eventos = await EventoService.ListarEventosAsync();

            ultimosEventos = eventos
                .OrderByDescending(e => e.idEvento)
                .Take(2)
                .ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando últimos eventos: {ex.Message}");
            ultimosEventos = new List<EventoDTO>();
        }
        finally
        {
            cargandoUltimosEventos = false;
        }
    }
}
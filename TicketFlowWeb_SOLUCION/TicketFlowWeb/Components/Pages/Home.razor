@page "/"
@using Microsoft.AspNetCore.Components.Authorization
@using TicketFlowWeb.Models
@using TicketFlowWeb.Models.DTO
@using TicketFlowWeb.Services.AnfitrionRS
@using TicketFlowWeb.Services.EventoRS

@inject AnfitrionRestService AnfitrionService
@inject EventoRestService EventoService
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Home</PageTitle>
<div class="home">
    <div class="cabezera">
        <div class="cabezera-contenido">
            <h1 class="display-4 fw-bold">TicketFlow</h1>
        </div>
    </div>
    <br />
</div>

<AuthorizeView Roles="ANFITRION">
    <Authorized Context="authContext">
        <div class="seccion-anfitrion-interna">

            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-2">
                <div>
                    <h2 class="titulo-dash-anf">¡Bienvenido de nuevo, @nombreAnfitrion!</h2>
                    <p class="subtitulo-dash-anf">Resumen y rendimiento de tus espectáculos en TicketFlow.</p>
                </div>
                <div>
                    <a href="/anfitrion/crear-evento" class="btn-publicar-dash-anf">
                        Publicar Nuevo Evento
                    </a>
                </div>
            </div>

            <div class="row g-4 mb-4">
                <div class="col-md-4">
                    <div class="tarjeta-kpi-anf">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="kpi-titulo-anf">EVENTOS PUBLICADOS</span>
                            <span>🎭</span>
                        </div>
                        <div class="kpi-valor-anf">@totalEventos</div>
                        <p class="m-0 text-success small">● Todos los shows activos</p>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="tarjeta-kpi-anf">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="kpi-titulo-anf">ENTRADAS VENDIDAS</span>
                            <span>🎟️</span>
                        </div>
                        <div class="kpi-valor-anf">@entradasVendidas <span class="fs-6 text-muted">/ @totalEmitidas</span></div>
                        <div class="progress mt-2" style="height: 6px; background-color: #e9e6f5;">
                            <div class="progress-bar bg-primary" style="width: @(totalEmitidas > 0 ? (entradasVendidas * 100 / totalEmitidas) : 0)%"></div>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="tarjeta-kpi-anf destacada-anf">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="kpi-titulo-anf">INGRESOS GENERADOS</span>
                            <span>💰</span>
                        </div>
                        <div class="kpi-valor-anf text-primary">S/. @ingresosGenerados.ToString("N2")</div>
                        <p class="m-0 text-muted small">Monto bruto de tus ventas</p>
                    </div>
                </div>
            </div>

            <div class="contenedor-tabla-anf">
                <h4 class="mb-3 fw-bold" style="color: #15095f;">Estado en Vivo de tus Shows</h4>
                <div class="table-responsive">
                    <table class="table align-middle m-0" style="color: #333355;">
                        <thead>
                            <tr class="text-muted border-bottom">
                                <th class="pb-2">Espectáculo</th>
                                <th class="pb-2">Fecha</th>
                                <th class="pb-2">Capacidad</th>
                                <th class="pb-2 text-center">Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (cargando)
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-4 text-muted">Cargando tu información...</td>
                                </tr>
                            }
                            else if (!misEventos.Any())
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-4 text-muted">Aún no tienes eventos publicados. ¡Crea el primero!</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var evento in misEventos)
                                {
                                    <tr class="border-bottom">
                                        <td class="py-2 fw-bold" style="color: #15095f;">@evento.titulo</td>
                                        <td class="py-2 text-muted">
                                            @(string.IsNullOrEmpty(evento.fecha) ? "Por definir" : evento.fecha)
                                        </td>
                                        <td class="py-2">
                                            <span class="small text-muted d-block mb-1">Capacidad: @evento.capacidad_entradas personas</span>
                                        </td>
                                        <td class="py-2 text-center">
                                            <span class="badge bg-success text-white rounded-pill px-3">
                                                Publicado
                                            </span>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </Authorized>

    <NotAuthorized Context="authContext">
        <div class="inicio-cliente-page">
            <section class="hero-cliente">
                <div class="hero-content">
                    <h1>Ticket Flow</h1>
                    <p>Da clic aquí si quieres organizar tus propios eventos</p>
                    <a href="/solicitud-anfitrion" class="btn-anfitrion">Quiero ser anfitrión</a>
                </div>
            </section>

            <section class="shows-section">
                <h2>ÚLTIMOS SHOWS</h2>

                @if (cargandoUltimosEventos)
                {
                    <p class="text-center fw-bold">Cargando eventos...</p>
                }
                else if (!ultimosEventos.Any())
                {
                    <p class="text-center fw-bold">No hay eventos disponibles por el momento.</p>
                }
                else
                {
                    <div class="shows-grid">
                        @foreach (var evento in ultimosEventos)
                        {
                            <div class="show-card">
                                <div class="show-img show-img-uno">
                                    <span>@evento.titulo</span>
                                </div>

                                <div class="show-info">
                                    <h3>@evento.titulo</h3>

                                    <p class="autor">
                                        ---------- @(string.IsNullOrWhiteSpace(evento.categoria) ? "EVENTO" : evento.categoria.ToUpper())
                                    </p>

                                    <p>
                                        <strong>Fecha:</strong>
                                        @(string.IsNullOrWhiteSpace(evento.fecha) ? "Por definir" : evento.fecha)
                                    </p>

                                    <p>
                                        <strong>Hora:</strong>
                                        @(string.IsNullOrWhiteSpace(evento.hora_inicio) ? "Por definir" : evento.hora_inicio)
                                    </p>

                                    <p>
                                        <strong>Lugar:</strong>
                                        @(string.IsNullOrWhiteSpace(evento.ubicacion) ? "Por definir" : evento.ubicacion)
                                    </p>

                                    <p class="precio">S/. @evento.precio.ToString("F2")</p>

                                    <a href="@($"/public/detalle-evento/{evento.idEvento}")" class="btn-detalle">
                                        Ver detalle
                                    </a>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="puntos">
                        @foreach (var evento in ultimosEventos)
                        {
                            <span></span>
                        }
                    </div>
                }

                <div class="ver-mas-home">
                    <a href="/public/descubrir" class="btn-ver-mas-home">
                        Ver más eventos
                    </a>
                </div>
            </section>

            <section class="testimonios-section">
                <h2>TESTIMONIOS DE USUARIOS</h2>
                <div class="testimonios-grid">
                    <div class="testimonio">
                        <div class="avatar">A</div>
                        <div class="globo">
                            <h4>Andrea R.</h4>
                            <p>"Compré mis entradas y todo fue súper fluido. Me encantó la rapidez de TicketFlow."</p>
                        </div>
                    </div>
                    <div class="testimonio">
                        <div class="avatar">M</div>
                        <div class="globo">
                            <h4>María E.</h4>
                            <p>"Siempre busco qué hacer los fines de semana y aquí encuentro buenas opciones."</p>
                        </div>
                    </div>
                    <div class="testimonio">
                        <div class="avatar">C</div>
                        <div class="globo">
                            <h4>Carlos T.</h4>
                            <p>"Lo que más me gusta de TicketFlow es la seguridad."</p>
                        </div>
                    </div>
                    <div class="testimonio">
                        <div class="avatar">J</div>
                        <div class="globo">
                            <h4>Jorge L.</h4>
                            <p>"Excelente plataforma. Transparente con los precios y muy intuitiva."</p>
                        </div>
                    </div>
                </div>
            </section>

            <section class="conocenos-section">
                <div class="conocenos-texto">
                    <h2>CONÓCENOS UN POCO</h2>
                    <p>Somos TicketFlow, una plataforma dedicada a transformar la manera en que conectas con el entretenimiento y la cultura en nuestra ciudad.</p>
                    <p>Nuestra misión es facilitar el acceso a las mejores experiencias mediante un sistema de gestión integral, seguro y transparente.</p>
                    <p>Nos apasiona potenciar el talento de los organizadores locales brindándoles herramientas para la administración de sus eventos, mientras garantizamos a cada asistente un proceso de compra rápido y confiable.</p>
                </div>
                <div class="conocenos-imagen">
                    <div class="cuadro-red">
                        <h3>TicketFlow</h3>
                        <span>Eventos</span>
                        <span>Usuarios</span>
                        <span>Pagos</span>
                        <span>Entradas</span>
                    </div>
                </div>
            </section>
        </div>
    </NotAuthorized>
</AuthorizeView>

<style>

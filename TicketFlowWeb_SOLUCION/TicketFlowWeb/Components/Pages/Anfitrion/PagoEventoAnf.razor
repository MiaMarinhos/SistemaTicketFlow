@page "/anfitrion/pagos_evento"
@using Microsoft.AspNetCore.Authorization
@using TicketFlowWeb.Models
@using TicketFlowWeb.Services.AnfitrionRS
@using Microsoft.AspNetCore.Components.Authorization

@attribute [Authorize(Roles = "ANFITRION")]

@inject NavigationManager NavigationManager
@inject AnfitrionRestService AnfitrionService
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>TicketFlow - Pagos de Mis Eventos</PageTitle>

<div class="pagos-eventos-contenedor">
    <main class="contenido-perfil">

        <section class="titulo-section mb-4">
            <h1>Pagos de Mis Eventos</h1>
        </section>

        <section class="tarjeta-control mb-4 p-4 rounded-4 bg-white shadow-sm">
            <div class="d-flex align-items-center gap-3">
                <label class="fs-5 fw-bold text-dark m-0">Buscar:</label>
                <div class="position-relative flex-grow-1" style="max-width: 400px;">
                    <input type="text" class="form-control buscador-input" placeholder="Buscar por nombre de evento..." @bind="criterioBusqueda" @bind:event="oninput" />
                </div>
            </div>
        </section>

        <section class="tarjeta-perfil p-4 rounded-4 bg-white shadow-sm">
            <div class="tabla-scroll-contenedor">
                <table class="table table-striped table-hover align-middle m-0 Custom-tabla-anf">
                    <thead>
                        <tr>
                            <th>ID Pago</th>
                            <th>Evento</th>
                            <th>Cliente</th>
                            <th>Método</th>
                            <th>Fecha</th>
                            <th>Monto</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (cargando)
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5">
                                    <div class="spinner-border text-primary" role="status">
                                        <span class="visually-hidden">Cargando pagos...</span>
                                    </div>
                                </td>
                            </tr>
                        }
                        else if (!PagosFiltrados.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    No se encontraron pagos registrados para tus eventos.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var pago in PagosFiltrados)
                            {
                                <tr>
                                    <td class="fw-bold text-muted" style="width: 120px;">@pago.IdPagoFormat</td>
                                    <td class="fw-bold text-indigo">@pago.NombreEvento</td>
                                    <td>@pago.NombreCliente</td>
                                    <td><span class="metodo-badge">@pago.MetodoPago</span></td>
                                    <td><span class="badge-fecha">@pago.FechaPago</span></td>
                                    <td class="fw-bold text-dark">S/. @pago.MontoTotal.ToString("0.00")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </section>

    </main>
</div>

<style>
    /* Se mantienen exactamente tus mismos estilos */
    .pagos-eventos-contenedor {
        min-height: 100vh;
        background-color: #f2edff;
        font-family: Arial, Helvetica, sans-serif;
        color: #110846;
    }

    .contenido-perfil {
        padding: 40px 50px;
    }

    .titulo-section {
        background-color: white;
        padding: 35px 42px;
        border-radius: 8px;
    }

        .titulo-section h1 {
            margin: 0;
            font-size: 38px;
            font-weight: bold;
            letter-spacing: 2px;
            color: #15095f;
        }

    .buscador-input {
        background-color: #d1e8ff !important;
        border: 1px solid #a3c7f5 !important;
        border-radius: 6px !important;
        padding: 8px 14px;
        color: #333 !important;
    }

    .tabla-scroll-contenedor {
        max-height: 440px;
        overflow-y: auto;
        border: 1px solid #f0edf5;
        border-radius: 4px;
    }

        .tabla-scroll-contenedor::-webkit-scrollbar {
            width: 8px;
        }

        .tabla-scroll-contenedor::-webkit-scrollbar-track {
            background: #f1edf5;
        }

        .tabla-scroll-contenedor::-webkit-scrollbar-thumb {
            background: #c3b6f2;
            border-radius: 4px;
        }

            .tabla-scroll-contenedor::-webkit-scrollbar-thumb:hover {
                background: #15095f;
            }

    .Custom-tabla-anf {
        border: none;
        width: 100%;
    }

        .Custom-tabla-anf thead th {
            color: #0c2775 !important;
            background-color: #d1e8ff !important;
            font-weight: bold;
            padding: 14px;
            font-size: 16px;
            position: sticky;
            top: 0;
            z-index: 2;
        }

        .Custom-tabla-anf tbody td {
            padding: 16px 14px;
            font-size: 15px;
            color: #333;
        }

    .text-indigo {
        color: #15095f;
    }

    .badge-fecha {
        background-color: #cbdcf7;
        color: #0c2775;
        padding: 6px 14px;
        border-radius: 15px;
        font-weight: 500;
        font-size: 14px;
    }

    .metodo-badge {
        font-weight: 500;
        color: #444;
    }

    @@media (max-width: 900px) {
        .contenido-perfil {
            padding: 20px 15px;
        }

        .titulo-section h1 {
            font-size: 28px;
        }
    }
</style>

@code {
    private string criterioBusqueda = string.Empty;
    private bool cargando = true;

    // Aquí guardamos la lista transformada para la tabla
    private List<PagoFilaDto> listadoPagos = new();

    // Filtro dinámico en tiempo real
    private IEnumerable<PagoFilaDto> PagosFiltrados =>
        listadoPagos.Where(p => string.IsNullOrEmpty(criterioBusqueda) ||
                                p.NombreEvento.Contains(criterioBusqueda, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity is not null && user.Identity.IsAuthenticated)
        {
            var idClaim = user.FindFirst("IdUsuario")?.Value;

            if (int.TryParse(idClaim, out int idAnfitrion))
            {
                // 1. Traemos todas las compras hechas a los eventos de este anfitrión
                var comprasBackend = await AnfitrionService.VerComprasDeSusEventosAsync(idAnfitrion);

                // 2. Traemos la lista de eventos para poder buscar sus títulos (ya que el CompraViewModel solo trae IDs a veces)
                var eventosBackend = await AnfitrionService.VerTodosLosEventosAsync();

                if (comprasBackend != null)
                {
                    listadoPagos.Clear();

                    foreach (var compra in comprasBackend)
                    {
                        // Buscamos el nombre del evento cruzando el idEvento de la compra con la lista de eventos
                        var eventoRelacionado = eventosBackend?.FirstOrDefault(e => e.id == compra.idEvento);
                        string nombreEvento = eventoRelacionado?.titulo ?? "Evento Desconocido";

                        // El nombre del cliente asumo que el backend te lo manda dentro del objeto anidado `cliente`.
                        // Como tu modelo `cliente` es un "object?", no podemos acceder a sus propiedades directamente.
                        // Por ahora pondremos su ID, pero más adelante puedes ajustar esto si creas un ClienteViewModel.
                        string nombreCliente = $"Cliente ID: {compra.idCliente}";

                        // Damos formato visual al ID del Pago (ej. de 1 a PG-001)
                        string pagoIdFormateado = $"PG-{compra.idCompra.ToString("D3")}";

                        listadoPagos.Add(new PagoFilaDto
                        {
                            IdPagoFormat = pagoIdFormateado,
                            NombreEvento = nombreEvento,
                            NombreCliente = nombreCliente,
                            MetodoPago = string.IsNullOrEmpty(compra.metodoPago ) ? "No especificado" : compra.metodoPago,
                            FechaPago = string.IsNullOrEmpty(compra?.fechaCompraS) ? "Pendiente" : compra.fechaCompraS,
                            MontoTotal = compra.montoTotal
                        });
                    }

                    // Ordenamos los pagos por los más recientes (basado en el ID, o podrías usar la fecha)
                    listadoPagos = listadoPagos.OrderByDescending(p => p.IdPagoFormat).ToList();
                }
            }
        }

        cargando = false;
    }

    private class PagoFilaDto
    {
        public string IdPagoFormat { get; set; } = string.Empty;
        public string NombreEvento { get; set; } = string.Empty;
        public string NombreCliente { get; set; } = string.Empty;
        public string MetodoPago { get; set; } = string.Empty;
        public string FechaPago { get; set; } = string.Empty;
        public double MontoTotal { get; set; }
    }
}
@page "/anfitrion/editar-evento/{Id:int}"
@using Microsoft.AspNetCore.Authorization
@using System.ComponentModel.DataAnnotations
@using TicketFlowWeb.Models
@using TicketFlowWeb.Services.AnfitrionRS
@using TicketFlowWeb.Services

@attribute [Authorize(Roles = "ANFITRION")]

@inject NavigationManager NavigationManager
@inject AnfitrionRestService AnfitrionService
@inject UbicacionRestService UbicacionService

<PageTitle>TicketFlow - Editar Evento</PageTitle>

<div class="crear-evento-page d-flex align-items-center justify-content-center min-vh-100 p-3 p-md-5">
    <div class="evento-card container-fluid p-4 p-md-5 rounded-4 shadow-lg">

        <div class="d-flex justify-content-end mb-3">
            <button class="btn-regresar d-flex align-items-center justify-content-center" @onclick="VolverAtras" type="button" title="Volver">
                <span class="flecha-retroceso">&larr;</span>
            </button>
        </div>

        @if (cargando)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-light" role="status">
                    <span class="visually-hidden">Cargando evento...</span>
                </div>
                <p class="mt-3 text-white-50">Cargando datos del evento...</p>
            </div>
        }
        else if (!string.IsNullOrEmpty(mensajeErrorGeneral))
        {
            <div class="alert alert-danger text-center">
                @mensajeErrorGeneral
            </div>
        }
        else
        {
            <form @onsubmit="ActualizarEvento" autocomplete="off">

                @if (!string.IsNullOrEmpty(mensajeErrorActualizacion))
                {
                    <div class="alert alert-danger">@mensajeErrorActualizacion</div>
                }

                <div class="row g-4">

                    <div class="col-lg-6 d-flex flex-column gap-3">

                        <div class="mb-2">
                            <h2 class="subtitulo-explicativo text-uppercase fw-bold text-white-50">Edita tu evento</h2>
                        </div>

                        <div class="input-contenedor-full">
                            <input type="text" class="custom-input custom-titulo-input" placeholder="Título" @bind="eventoModel.titulo" required />
                        </div>

                        <div class="input-contenedor-full flex-grow-1 d-flex flex-column">
                            <textarea class="custom-input custom-textarea flex-grow-1" rows="8" placeholder="Descripcion..." @bind="eventoModel.descripcion" required></textarea>
                        </div>

                        <div class="d-flex gap-3 mt-2">
                            <div class="d-flex align-items-center gap-2 flex-grow-1">
                                <span class="etiqueta-fija text-center">N Entradas</span>
                                <div class="w-100">
                                    <input type="number" min="0" class="custom-input text-white" @bind="NumeroEntradasValidado" placeholder="300" required />
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-2 flex-grow-1">
                                <span class="etiqueta-fija text-center">Precio</span>
                                <div class="w-100">
                                    <input type="text" class="custom-input text-white" @bind="PrecioFormateado" placeholder="S/. 50.00" required />
                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="col-lg-6 d-flex flex-column gap-3 justify-content-between">

                        <div class="fila-formulario-derecha">
                            <span class="etiqueta-fija">Imagen</span>
                            <input type="text" class="custom-input" placeholder="Subir Imagen URL" @bind="eventoModel.img" />
                        </div>

                        <div class="fila-formulario-derecha">
                            <span class="etiqueta-fija">Fecha</span>
                            <input type="text" class="custom-input text-white" placeholder="31/05/2026" @bind="eventoModel.fecha" required />
                        </div>

                        <div class="fila-formulario-derecha">
                            <span class="etiqueta-fija">Hora de Inicio</span>
                            <input type="text" class="custom-input" placeholder="10:30 am" @bind="eventoModel.hora_inicio" required />
                        </div>

                        <div class="fila-formulario-derecha">
                            <span class="etiqueta-fija">Hora de Fin</span>
                            <input type="text" class="custom-input" placeholder="12:30 pm" @bind="eventoModel.hora_fin" required />
                        </div>

                        <div class="fila-formulario-derecha">
                            <span class="etiqueta-fija">Ubicacion</span>
                            <input type="text" class="custom-input" placeholder="Pasaje Porta 132. Miraflores" @bind="eventoModel.ubicacion" required />
                        </div>

                        <div class="fila-formulario-derecha">
                            <span class="etiqueta-fija">Sitio del Evento</span>
                            <input type="text" class="custom-input" placeholder="El Teatro Teatral" @bind="eventoModel.nombre_establecimiento" required />
                        </div>

                        <div class="fila-formulario-derecha">
                            <span class="etiqueta-fija">Distrito</span>
                            <select class="custom-input custom-select" @bind="idDistritoSeleccionado" required>
                                <option value="0" disabled>Selecciona un distrito</option>
                                @foreach (var d in listaDistritos)
                                {
                                    <option value="@d.idDistrito">@d.nombre</option>
                                }
                            </select>
                        </div>

                        <div class="fila-formulario-derecha">
                            <span class="etiqueta-fija">Region</span>
                            <input type="text" class="custom-input bg-bloqueado" value="Lima Metropolitana" readonly />
                        </div>

                    </div>

                </div>

                <div class="text-center mt-5">
                    <button type="submit" class="btn-crear-evento fw-bold text-uppercase" disabled="@guardando">
                        @(guardando ? "Guardando..." : "Editar Evento")
                    </button>
                </div>

            </form>
        }
    </div>
</div>

<style>
    .crear-evento-page {
        background-color: #121212;
        font-family: system-ui, -apple-system, sans-serif;
    }

    .evento-card {
        background: linear-gradient(145deg, #070724 0%, #100f57 45%, #18239c 100%);
        max-width: 1200px;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

    /* Estilo para el campo bloqueado */
    .bg-bloqueado {
        background-color: rgba(255, 255, 255, 0.05) !important;
        cursor: not-allowed;
        color: rgba(255, 255, 255, 0.5) !important;
    }

    /* Estilo para el select desplegable */
    .custom-select option {
        background-color: #100f57;
        color: white;
    }

    .subtitulo-explicativo {
        font-size: 1.1rem;
        letter-spacing: 2px;
        color: rgba(255, 255, 255, 0.6) !important;
        margin: 0;
    }

    .btn-regresar {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background-color: transparent;
        border: 2px solid rgba(255, 255, 255, 0.7);
        color: white !important;
        transition: all 0.2s ease-in-out;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .btn-regresar:hover {
            background-color: rgba(255, 255, 255, 0.15);
            border-color: #ffffff;
        }

    .flecha-retroceso {
        font-size: 34px;
        line-height: 1;
        font-weight: bold;
        display: inline-block;
        margin-top: -6px;
        color: white !important;
    }

    .custom-input {
        width: 100%;
        background-color: transparent;
        border: 2px solid rgba(255, 255, 255, 0.7);
        border-radius: 12px;
        padding: 10px 18px;
        color: white !important;
        font-size: 1rem;
        outline: none;
    }

        .custom-input::placeholder {
            color: rgba(255, 255, 255, 0.5);
        }

        .custom-input:focus {
            border-color: #ffffff;
        }

    .custom-titulo-input {
        font-size: 1.6rem;
        font-weight: bold;
        border-radius: 10px;
    }

    .custom-textarea {
        border-radius: 18px;
        resize: none;
    }

    .etiqueta-fija {
        min-width: 135px;
        max-width: 135px;
        border: 2px solid rgba(255, 255, 255, 0.7);
        border-radius: 12px;
        padding: 10px;
        color: white;
        font-size: 0.95rem;
        font-weight: 500;
        display: inline-block;
    }

    .fila-formulario-derecha {
        display: flex;
        align-items: center;
        gap: 15px;
        width: 100%;
    }

    .btn-crear-evento {
        background-color: #d1e4ff;
        color: #0c0a3e;
        border: none;
        border-radius: 35px;
        padding: 15px 70px;
        font-size: 1.1rem;
        letter-spacing: 1px;
        transition: all 0.2s ease-in-out;
        cursor: pointer;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
    }

        .btn-crear-evento:hover:not(:disabled) {
            background-color: #ffffff;
            transform: scale(1.03);
        }

        .btn-crear-evento:disabled {
            opacity: 0.7;
            cursor: not-allowed;
        }
</style>

@code {
    [Parameter] public int Id { get; set; }

    private EventoViewModel eventoModel = new EventoViewModel();

    // Lista dinámica obtenida desde el backend
    private List<Distrito> listaDistritos = new();

    private int idDistritoSeleccionado = 0;

    private bool cargando = true;
    private bool guardando = false;
    private string mensajeErrorGeneral = "";
    private string mensajeErrorActualizacion = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            cargando = true;

            // 1. PRIMERO CARGAMOS LOS DISTRITOS DINÁMICOS
            listaDistritos = await UbicacionService.ListarDistritosAsync();

            // 2. LUEGO CARGAMOS EL EVENTO
            var eventoDesdeBd = await AnfitrionService.ObtenerEventoAsync(Id);

            if (eventoDesdeBd != null)
            {
                eventoModel = eventoDesdeBd;

                // Intentamos recuperar el ID del distrito guardado en la BD
                idDistritoSeleccionado = eventoModel.FK_idDistrito;

                // Fallback por si la BD nos trae el nombre del objeto pero no el FK_idDistrito directo
                if (idDistritoSeleccionado == 0 && eventoModel.distrito != null && !string.IsNullOrEmpty(eventoModel.distrito.nombre))
                {
                    var match = listaDistritos.FirstOrDefault(d => d.nombre.Equals(eventoModel.distrito.nombre, StringComparison.OrdinalIgnoreCase));
                    if (match != null && match.idDistrito != 0) idDistritoSeleccionado = match.idDistrito;
                }
            }
            else
            {
                mensajeErrorGeneral = "No se encontró el evento solicitado en la base de datos.";
            }
        }
        catch (Exception ex)
        {
            mensajeErrorGeneral = $"Error de conexión: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private int NumeroEntradasValidado
    {
        get => eventoModel.capacidad_entradas;
        set => eventoModel.capacidad_entradas = value < 0 ? 0 : value;
    }

    private string PrecioFormateado
    {
        get => $"S/. {eventoModel.precio.ToString("0.00")}";
        set
        {
            string limpio = value.Replace("S/.", "").Replace("S/", "").Replace(" ", "").Trim();
            if (decimal.TryParse(limpio, out decimal resultado))
                eventoModel.precio = resultado < 0 ? 0 : resultado;
        }
    }

    private async Task ActualizarEvento()
    {
        mensajeErrorActualizacion = "";

        if (idDistritoSeleccionado == 0)
        {
            mensajeErrorActualizacion = "Por favor, selecciona un distrito.";
            return;
        }

        guardando = true;

        try
        {
            // Asignamos el distrito al modelo antes de enviar
            eventoModel.FK_idDistrito = idDistritoSeleccionado;

            bool exito = await AnfitrionService.ActualizarEventoAsync(Id, eventoModel);

            if (exito)
            {
                NavigationManager.NavigateTo("/anfitrion/gestionar-evento");
            }
            else
            {
                mensajeErrorActualizacion = "Ocurrió un error al guardar. Revisa la consola o tu backend en Java.";
            }
        }
        catch (Exception ex)
        {
            mensajeErrorActualizacion = $"Excepción al guardar: {ex.Message}";
        }
        finally
        {
            guardando = false;
        }
    }

    private void VolverAtras()
    {
        NavigationManager.NavigateTo("/anfitrion/gestionar-evento");
    }
}
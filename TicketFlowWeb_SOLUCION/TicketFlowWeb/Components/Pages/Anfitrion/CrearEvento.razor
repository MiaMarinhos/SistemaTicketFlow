@page "/anfitrion/crear-evento"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.ComponentModel.DataAnnotations
@using TicketFlowWeb.Models
@using TicketFlowWeb.Services.AnfitrionRS

@attribute [Authorize(Roles = "ANFITRION")]

@inject NavigationManager NavigationManager
@inject AnfitrionRestService AnfitrionService
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>TicketFlow - Crear Evento</PageTitle>

<div class="crear-evento-page d-flex align-items-center justify-content-center min-vh-100 p-3 p-md-5">
    <div class="evento-card container-fluid p-4 p-md-5 rounded-4 shadow-lg">

        <div class="d-flex justify-content-end mb-3">
            <button class="btn-regresar d-flex align-items-center justify-content-center" @onclick="VolverAtras" type="button" title="Volver">
                <span class="flecha-retroceso">&larr;</span>
            </button>
        </div>

        <form @onsubmit="GuardarEventoAsync" autocomplete="off">

            <div class="row g-4">

                <div class="col-lg-6 d-flex flex-column gap-3">

                    <div class="mb-2">
                        <h2 class="subtitulo-explicativo text-uppercase fw-bold text-white-50">Crea tu nuevo evento</h2>
                    </div>

                    <div class="input-contenedor-full">
                        <input type="text" class="custom-input custom-titulo-input" placeholder="Título" @bind="eventoModel.titulo" required />
                    </div>

                    <div class="input-contenedor-full flex-grow-1 d-flex flex-column">
                        <textarea class="custom-input custom-textarea flex-grow-1" rows="8" placeholder="Descripcion..." @bind="eventoModel.descripcion" required></textarea>
                    </div>

                    <div class="d-flex gap-3 mt-2">
                        <div class="d-flex align-items-center gap-2 flex-grow-1">
                            <span class="etiqueta-fija text-center">N Entradas</span>
                            <div class="w-100">
                                <input type="number" min="0" class="custom-input text-white" @bind="NumeroEntradasValidado" placeholder="300" required />
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-2 flex-grow-1">
                            <span class="etiqueta-fija text-center">Precio</span>
                            <div class="w-100">
                                <input type="text" class="custom-input text-white" @bind="PrecioFormateado" placeholder="S/. 50.00" required />
                            </div>
                        </div>
                    </div>

                </div>

                <div class="col-lg-6 d-flex flex-column gap-3 justify-content-between">

                    <div class="fila-formulario-derecha">
                        <span class="etiqueta-fija">Imagen URL</span>
                        <input type="text" class="custom-input" placeholder="Ej: https://mi-imagen.com/foto.jpg" @bind="eventoModel.img" />
                    </div>

                    <div class="fila-formulario-derecha">
                        <span class="etiqueta-fija">Fecha</span>
                        <input type="text" class="custom-input text-white" placeholder="31/05/2026" @bind="FechaFormateada" required />
                    </div>

                    <div class="fila-formulario-derecha">
                        <span class="etiqueta-fija">Hora de Inicio</span>
                        <input type="text" class="custom-input" placeholder="10:30 am" @bind="eventoModel.horaInicioModerna" required />
                    </div>

                    <div class="fila-formulario-derecha">
                        <span class="etiqueta-fija">Hora de Fin</span>
                        <input type="text" class="custom-input" placeholder="12:30 pm" @bind="eventoModel.horaFinModerna" required />
                    </div>

                    <div class="fila-formulario-derecha">
                        <span class="etiqueta-fija">Ubicacion</span>
                        <input type="text" class="custom-input" placeholder="Pasaje Porta 132. Miraflores" @bind="eventoModel.ubicacion" required />
                    </div>

                    <div class="fila-formulario-derecha">
                        <span class="etiqueta-fija">Sitio del Evento</span>
                        <input type="text" class="custom-input" placeholder="El Teatro Teatral" @bind="eventoModel.nombre_establecimiento" required />
                    </div>

                    <div class="fila-formulario-derecha">
                        <span class="etiqueta-fija">Distrito</span>
                        <input type="text" class="custom-input" placeholder="Miraflores" @bind="nombreDistrito" required />
                    </div>

                    <div class="fila-formulario-derecha">
                        <span class="etiqueta-fija">Region</span>
                        <input type="text" class="custom-input" placeholder="Lima" @bind="nombreRegion" required />
                    </div>

                </div>

            </div>

            <div class="text-center mt-5">
                <button type="submit" class="btn-crear-evento fw-bold text-uppercase" disabled="@estaGuardando">
                    @(estaGuardando ? "Guardando..." : "Crear Evento")
                </button>
            </div>

        </form>

    </div>
</div>

<style>
    /* SE MANTIENEN TODOS TUS ESTILOS EXACTAMENTE IGUAL */
    .crear-evento-page {
        background-color: #121212;
        font-family: system-ui, -apple-system, sans-serif;
    }

    .evento-card {
        background: linear-gradient(145deg, #070724 0%, #100f57 45%, #18239c 100%);
        max-width: 1200px;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .subtitulo-explicativo {
        font-size: 1.1rem;
        letter-spacing: 2px;
        color: rgba(255, 255, 255, 0.6) !important;
        margin: 0;
    }

    .btn-regresar {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background-color: transparent;
        border: 2px solid rgba(255, 255, 255, 0.7);
        color: white !important;
        transition: all 0.2s ease-in-out;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .btn-regresar:hover {
            background-color: rgba(255, 255, 255, 0.15);
            border-color: #ffffff;
        }

    .flecha-retroceso {
        font-size: 34px;
        line-height: 1;
        font-weight: bold;
        display: inline-block;
        margin-top: -6px;
        color: white !important;
    }

    .custom-input {
        width: 100%;
        background-color: transparent;
        border: 2px solid rgba(255, 255, 255, 0.7);
        border-radius: 12px;
        padding: 10px 18px;
        color: white !important;
        font-size: 1rem;
        outline: none;
    }

        .custom-input::placeholder {
            color: rgba(255, 255, 255, 0.5);
        }

        .custom-input:focus {
            border-color: #ffffff;
        }

    .custom-titulo-input {
        font-size: 1.6rem;
        font-weight: bold;
        border-radius: 10px;
    }

    .custom-textarea {
        border-radius: 18px;
        resize: none;
    }

    .etiqueta-fija {
        min-width: 135px;
        max-width: 135px;
        border: 2px solid rgba(255, 255, 255, 0.7);
        border-radius: 12px;
        padding: 10px;
        color: white;
        font-size: 0.95rem;
        font-weight: 500;
        display: inline-block;
    }

    .fila-formulario-derecha {
        display: flex;
        align-items: center;
        gap: 15px;
        width: 100%;
    }

    .btn-crear-evento {
        background-color: #d1e4ff;
        color: #0c0a3e;
        border: none;
        border-radius: 35px;
        padding: 15px 70px;
        font-size: 1.1rem;
        letter-spacing: 1px;
        transition: all 0.2s ease-in-out;
        cursor: pointer;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
    }

        .btn-crear-evento:hover:not(:disabled) {
            background-color: #ffffff;
            transform: scale(1.03);
        }

        .btn-crear-evento:disabled {
            opacity: 0.7;
            cursor: not-allowed;
        }
</style>

@code {
    private EventoViewModel eventoModel = new EventoViewModel();
    private bool estaGuardando = false;

    // Variables temporales para evitar errores de enlace (Binding) en Blazor
    private string nombreDistrito = string.Empty;
    private string nombreRegion = string.Empty;

    private string FechaFormateada
    {
        get => eventoModel.fechaModerna?.ToString("dd/MM/yyyy") ?? DateTime.Today.ToString("dd/MM/yyyy");
        set
        {
            if (DateTime.TryParseExact(value, "dd/MM/yyyy", null, System.Globalization.DateTimeStyles.None, out DateTime fechaParsed))
                eventoModel.fechaModerna = fechaParsed;
            else if (DateTime.TryParse(value, out DateTime fechaFlexible))
                eventoModel.fechaModerna = fechaFlexible;
        }
    }

    private int NumeroEntradasValidado
    {
        get => eventoModel.capacidad_entradas;
        set => eventoModel.capacidad_entradas = value < 0 ? 0 : value;
    }

    private string PrecioFormateado
    {
        get => $"S/. {eventoModel.precio.ToString("0.00")}";
        set
        {
            string limpio = value.Replace("S/.", "").Replace("S/", "").Replace(" ", "").Trim();
            if (decimal.TryParse(limpio, out decimal resultado))
                eventoModel.precio = resultado < 0 ? 0 : resultado;
            else if (string.IsNullOrEmpty(limpio))
                eventoModel.precio = 0;
        }
    }

    private async Task GuardarEventoAsync()
    {
        estaGuardando = true;

        try
        {
            // 1. Identificar al usuario logueado
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity is not null && user.Identity.IsAuthenticated)
            {
                var idClaim = user.FindFirst("IdUsuario")?.Value;

                if (int.TryParse(idClaim, out int idAnfitrion))
                {
                    // 2. Le asignamos al evento quién es su dueño (Anfitrión)
                    eventoModel.anfitrion = new Anfitrion { idUsuario = idAnfitrion };

                    // Opcional: Configurar Distrito si tienes un modelo para enviarlo
                    // eventoModel.distrito = new Distrito { nombre = nombreDistrito, region = nombreRegion };

                    // 3. Lo mandamos al Backend Java
                    // NOTA: Asegúrate de tener este método CrearEventoAsync en tu AnfitrionRestService.cs
                    await AnfitrionService.CrearEventoAsync(eventoModel);

                    // 4. Si todo sale bien, lo redirigimos a "Mis Eventos" para que vea su nuevo show
                    NavigationManager.NavigateTo("/anfitrion/gestionar-evento");
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error al guardar: " + ex.Message);
        }
        finally
        {
            estaGuardando = false;
        }
    }

    private void VolverAtras()
    {
        NavigationManager.NavigateTo("/anfitrion/gestionar-evento");
    }
}
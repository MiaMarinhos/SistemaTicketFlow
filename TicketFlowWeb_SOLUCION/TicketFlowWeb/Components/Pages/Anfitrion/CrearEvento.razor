@page "/anfitrion/crear-evento"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.ComponentModel.DataAnnotations
@using TicketFlowWeb.Models
@using TicketFlowWeb.Services.AnfitrionRS
@using TicketFlowWeb.Services

@attribute [Authorize(Roles = "ANFITRION")]

@inject NavigationManager NavigationManager
@inject AnfitrionRestService AnfitrionService
@inject AuthenticationStateProvider AuthStateProvider
@inject UbicacionRestService UbicacionService
@inject CategoriaRestService CategoriaService

<PageTitle>TicketFlow - Crear Evento</PageTitle>

<div class="crear-evento-page d-flex align-items-center justify-content-center min-vh-100 p-3 p-md-5">
    <div class="evento-card container-fluid p-4 p-md-5 rounded-4 shadow-lg">

        <div class="d-flex justify-content-end mb-3">
            <button class="btn-regresar d-flex align-items-center justify-content-center" @onclick="VolverAtras" type="button" title="Volver">
                <span class="flecha-retroceso">&larr;</span>
            </button>
        </div>

        <form @onsubmit="GuardarEventoAsync" autocomplete="off">

            <div class="row g-4">

                <div class="col-lg-6 d-flex flex-column gap-3">

                    <div class="mb-2">
                        <h2 class="subtitulo-explicativo text-uppercase fw-bold text-white-50">Crea tu nuevo evento</h2>
                    </div>

                    @if (!string.IsNullOrEmpty(mensajeError))
                    {
                        <div class="alert alert-danger p-2 mt-2 fw-bold" style="border-radius: 8px;">
                            @mensajeError
                        </div>
                    }

                    <div class="input-contenedor-full">
                        <input type="text" class="custom-input custom-titulo-input" placeholder="Título" @bind="eventoModel.titulo" required />
                    </div>

                    <div class="fila-formulario-derecha">
                        <span class="etiqueta-fija">Categoría</span>
                        <select class="custom-input custom-select" @bind="idCategoriaSeleccionada" required>
                            <option value="0" disabled selected>Selecciona una categoría</option>
                            @foreach (var c in listaCategorias)
                            {
                                <option value="@c.idCategoria_evento">@c.nombre</option>
                            }
                        </select>
                    </div>

                    <div class="input-contenedor-full flex-grow-1 d-flex flex-column">
                        <textarea class="custom-input custom-textarea flex-grow-1" rows="6" placeholder="Descripcion..." @bind="eventoModel.descripcion" required></textarea>
                    </div>

                    <div class="d-flex gap-3 mt-2">
                        <div class="d-flex align-items-center gap-2 flex-grow-1">
                            <span class="etiqueta-fija text-center">N Entradas</span>
                            <div class="w-100">
                                <input type="number" min="0" class="custom-input text-white" @bind="NumeroEntradasValidado" placeholder="300" required />
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-2 flex-grow-1">
                            <span class="etiqueta-fija text-center">Precio</span>
                            <div class="w-100">
                                <input type="text" class="custom-input text-white" @bind="PrecioFormateado" placeholder="S/. 50.00" required />
                            </div>
                        </div>
                    </div>

                </div>

                <div class="col-lg-6 d-flex flex-column gap-3 justify-content-between">

                    <div class="fila-formulario-derecha">
                        <span class="etiqueta-fija">Imagen URL</span>
                        <input type="text" class="custom-input" placeholder="Ej: https://drive/d/id" @bind="eventoModel.img" />
                    </div>

                    <div class="fila-formulario-derecha">
                        <span class="etiqueta-fija">Fecha</span>
                        <input type="text" class="custom-input text-white" placeholder="31/05/2026" @bind="fechaUI" required />
                    </div>

                    <div class="fila-formulario-derecha">
                        <span class="etiqueta-fija">Hora de Inicio</span>
                        <input type="text" class="custom-input" placeholder="10:30 am" @bind="horaInicioUI" required />
                    </div>

                    <div class="fila-formulario-derecha">
                        <span class="etiqueta-fija">Hora de Fin</span>
                        <input type="text" class="custom-input" placeholder="12:30 pm" @bind="horaFinUI" required />
                    </div>

                    <div class="fila-formulario-derecha">
                        <span class="etiqueta-fija">Ubicacion</span>
                        <input type="text" class="custom-input" placeholder="Pasaje Porta 132" @bind="eventoModel.ubicacion" required />
                    </div>

                    <div class="fila-formulario-derecha">
                        <span class="etiqueta-fija">Sitio del Evento</span>
                        <input type="text" class="custom-input" placeholder="El Teatro Teatral" @bind="eventoModel.nombre_establecimiento" required />
                    </div>

                    <div class="fila-formulario-derecha">
                        <span class="etiqueta-fija">Distrito</span>
                        <select class="custom-input custom-select" @bind="idDistritoSeleccionado" required>
                            <option value="0" disabled selected>Selecciona un distrito</option>
                            @foreach (var d in listaDistritos)
                            {
                                <option value="@d.idDistrito">@d.nombre</option>
                            }
                        </select>
                    </div>

                    <div class="fila-formulario-derecha">
                        <span class="etiqueta-fija">Region</span>
                        <input type="text" class="custom-input bg-bloqueado" value="Lima Metropolitana" readonly />
                    </div>

                </div>

            </div>

            <div class="text-center mt-5">
                <button type="submit" class="btn-crear-evento fw-bold text-uppercase" disabled="@estaGuardando">
                    @(estaGuardando ? "Guardando..." : "Crear Evento")
                </button>
            </div>

        </form>

    </div>
</div>

<style>
    /* Mismos estilos que ya tenías... */
    .crear-evento-page {
        background-color: #121212;
        font-family: system-ui, -apple-system, sans-serif;
    }

    .evento-card {
        background: linear-gradient(145deg, #070724 0%, #100f57 45%, #18239c 100%);
        max-width: 1200px;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .bg-bloqueado {
        background-color: rgba(255, 255, 255, 0.05) !important;
        cursor: not-allowed;
        color: rgba(255, 255, 255, 0.5) !important;
    }

    .custom-select option {
        background-color: #100f57;
        color: white;
    }

    .subtitulo-explicativo {
        font-size: 1.1rem;
        letter-spacing: 2px;
        color: rgba(255, 255, 255, 0.6) !important;
        margin: 0;
    }

    .btn-regresar {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background-color: transparent;
        border: 2px solid rgba(255, 255, 255, 0.7);
        color: white !important;
        transition: all 0.2s ease-in-out;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .btn-regresar:hover {
            background-color: rgba(255, 255, 255, 0.15);
            border-color: #ffffff;
        }

    .flecha-retroceso {
        font-size: 34px;
        line-height: 1;
        font-weight: bold;
        display: inline-block;
        margin-top: -6px;
        color: white !important;
    }

    .custom-input {
        width: 100%;
        background-color: transparent;
        border: 2px solid rgba(255, 255, 255, 0.7);
        border-radius: 12px;
        padding: 10px 18px;
        color: white !important;
        font-size: 1rem;
        outline: none;
    }

        .custom-input::placeholder {
            color: rgba(255, 255, 255, 0.5);
        }

        .custom-input:focus {
            border-color: #ffffff;
        }

    .custom-titulo-input {
        font-size: 1.6rem;
        font-weight: bold;
        border-radius: 10px;
    }

    .custom-textarea {
        border-radius: 18px;
        resize: none;
    }

    .etiqueta-fija {
        min-width: 135px;
        max-width: 135px;
        border: 2px solid rgba(255, 255, 255, 0.7);
        border-radius: 12px;
        padding: 10px;
        color: white;
        font-size: 0.95rem;
        font-weight: 500;
        display: inline-block;
    }

    .fila-formulario-derecha {
        display: flex;
        align-items: center;
        gap: 15px;
        width: 100%;
    }

    .btn-crear-evento {
        background-color: #d1e4ff;
        color: #0c0a3e;
        border: none;
        border-radius: 35px;
        padding: 15px 70px;
        font-size: 1.1rem;
        letter-spacing: 1px;
        transition: all 0.2s ease-in-out;
        cursor: pointer;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
    }

        .btn-crear-evento:hover:not(:disabled) {
            background-color: #ffffff;
            transform: scale(1.03);
        }

        .btn-crear-evento:disabled {
            opacity: 0.7;
            cursor: not-allowed;
        }
</style>

@code {
    private EventoViewModel eventoModel = new EventoViewModel();
    private bool estaGuardando = false;
    private string mensajeError = "";

    private List<Distrito> listaDistritos = new();
    private int idDistritoSeleccionado = 0;

    // NUEVO: Variables para Categoría
    private List<Categoria> listaCategorias = new();
    private int idCategoriaSeleccionada = 0;

    private string fechaUI = DateTime.Today.ToString("dd/MM/yyyy");
    private string horaInicioUI = string.Empty;
    private string horaFinUI = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Consultamos distritos y categorías en paralelo
            var taskDistritos = UbicacionService.ListarDistritosAsync();
            var taskCategorias = CategoriaService.ListarCategoriasAsync();

            await Task.WhenAll(taskDistritos, taskCategorias);

            listaDistritos = await taskDistritos;
            listaCategorias = await taskCategorias;
        }
        catch (Exception ex)
        {
            mensajeError = "No se pudieron cargar los datos iniciales: " + ex.Message;
        }
    }

    private int NumeroEntradasValidado
    {
        get => eventoModel.capacidad_entradas;
        set => eventoModel.capacidad_entradas = value < 0 ? 0 : value;
    }

    private string PrecioFormateado
    {
        get => $"S/. {eventoModel.precio.ToString("0.00")}";
        set
        {
            string limpio = value.Replace("S/.", "").Replace("S/", "").Replace(" ", "").Trim();
            if (decimal.TryParse(limpio, out decimal resultado))
                eventoModel.precio = resultado < 0 ? 0 : resultado;
            else if (string.IsNullOrEmpty(limpio))
                eventoModel.precio = 0;
        }
    }

    private async Task GuardarEventoAsync()
    {
        if (idDistritoSeleccionado == 0)
        {
            mensajeError = "Por favor, selecciona un distrito.";
            return;
        }

        if (idCategoriaSeleccionada == 0)
        {
            mensajeError = "Por favor, selecciona una categoría.";
            return;
        }

        estaGuardando = true;

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity is not null && user.Identity.IsAuthenticated)
            {
                var idClaim = user.FindFirst("IdUsuario")?.Value;

                if (int.TryParse(idClaim, out int idAnfitrionLogueado))
                {
                    eventoModel.idAnfitrion = idAnfitrionLogueado;
                    eventoModel.anfitrion = new Anfitrion { idUsuario = idAnfitrionLogueado };

                    eventoModel.FK_idDistrito = idDistritoSeleccionado;

                    // ASIGNAMOS LA CATEGORÍA SELECCIONADA
                    eventoModel.FK_idCategoria_evento = idCategoriaSeleccionada;

                    eventoModel.FK_idEstadoPublicacion = 1;
                    eventoModel.FK_idEstadoEvento = 1;

                    if (DateTime.TryParseExact(fechaUI, "dd/MM/yyyy", null, System.Globalization.DateTimeStyles.None, out DateTime fechaParsed))
                        eventoModel.fecha = fechaParsed.ToString("yyyy-MM-dd");

                    if (DateTime.TryParse(horaInicioUI, out DateTime hInicio))
                        eventoModel.hora_inicio = hInicio.ToString("HH:mm:ss");

                    if (DateTime.TryParse(horaFinUI, out DateTime hFin))
                        eventoModel.hora_fin = hFin.ToString("HH:mm:ss");

                    eventoModel.entradas_disponibles = NumeroEntradasValidado;
                    if (!string.IsNullOrEmpty(eventoModel.img))
                    {
                        var regexDrive = new System.Text.RegularExpressions.Regex(@"/d/([a-zA-Z0-9-_]+)");
                        var matchDrive = regexDrive.Match(eventoModel.img);

                        if (matchDrive.Success)
                        {
                            string idDrive = matchDrive.Groups[1].Value;

                            eventoModel.img = $"https://lh3.googleusercontent.com/d/{idDrive}";
                        }
                        else if (!eventoModel.img.Contains("googleusercontent.com"))
                        {
                            mensajeError = "El formato del enlace de Google Drive no es válido.";
                            estaGuardando = false;
                            return;
                        }
                    }
                    //------------
                    await AnfitrionService.CrearEventoAsync(eventoModel);
                    NavigationManager.NavigateTo("/anfitrion/gestionar-evento");
                }
            }
        }
        catch (Exception ex)
        {
            mensajeError = "Error al crear: " + ex.Message;
        }
        finally
        {
            estaGuardando = false;
        }
    }

    private void VolverAtras()
    {
        NavigationManager.NavigateTo("/anfitrion/gestionar-evento");
    }
}
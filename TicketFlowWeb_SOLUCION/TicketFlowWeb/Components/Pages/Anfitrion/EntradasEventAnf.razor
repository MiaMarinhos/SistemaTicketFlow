@page "/anfitrion/entradas_evento"
@using Microsoft.AspNetCore.Authorization
@using TicketFlowWeb.Models
@using TicketFlowWeb.Services.AnfitrionRS
@using Microsoft.AspNetCore.Components.Authorization

@attribute [Authorize(Roles = "ANFITRION")]

@inject NavigationManager NavigationManager
@inject AnfitrionRestService AnfitrionService
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>TicketFlow - Entradas por Eventos</PageTitle>

<div class="entradas-eventos-contenedor">
    <main class="contenido-perfil">

        <section class="titulo-section mb-4">
            <h1>Entradas por eventos</h1>
        </section>

        <section class="row g-4 mb-4">

            <div class="col-md-4">
                <div class="tarjeta-kpi-anf">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="kpi-titulo-anf">MÁS ENTRADAS VENDIDAS</span>
                        <span>🔥</span>
                    </div>
                    <div class="kpi-valor-evento">@(string.IsNullOrEmpty(eventoMasVendido) ? "Sin datos" : eventoMasVendido)</div>
                    <p class="m-0 text-success small fw-bold">@maxVendidas tickets vendidos</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="tarjeta-kpi-anf">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="kpi-titulo-anf">MÁS ENTRADAS DISPONIBLES</span>
                        <span>🎟️</span>
                    </div>
                    <div class="kpi-valor-evento">@(string.IsNullOrEmpty(eventoMasLibre) ? "Sin datos" : eventoMasLibre)</div>
                    <p class="m-0 text-primary small fw-bold">@maxLibres tickets libres</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="tarjeta-kpi-anf destacada-anf">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="kpi-titulo-anf">TOTAL ENTRADAS VENDIDAS</span>
                        <span>📊</span>
                    </div>
                    <div class="kpi-valor-anf text-primary">@totalVendidas</div>
                    <p class="m-0 text-muted small">De un total de @totalEmitidas emitidas</p>
                </div>
            </div>

        </section>

        <section class="tarjeta-perfil p-4 rounded-4 bg-white shadow-sm">
            <h4 class="mb-3 fw-bold text-indigo fs-5">Detalle de eventos</h4>

            <div class="tabla-scroll-contenedor">
                <table class="table table-striped table-hover align-middle m-0 Custom-tabla-anf">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Título</th>
                            <th>Fecha</th>
                            <th>Precio</th>
                            <th class="text-center">Entradas Vendidas</th>
                            <th class="text-center">Entradas Disponibles</th>
                            <th class="text-center">Capacidad Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (cargando)
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5">
                                    <div class="spinner-border text-primary" role="status">
                                        <span class="visually-hidden">Calculando inventario...</span>
                                    </div>
                                </td>
                            </tr>
                        }
                        else if (!listadoInventario.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    Aún no tienes eventos publicados para calcular inventario.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var ev in listadoInventario)
                            {
                                <tr>
                                    <td class="fw-bold text-muted" style="width: 60px;">@ev.Id</td>
                                    <td class="fw-bold text-indigo">@ev.Titulo</td>
                                    <td><span class="badge-fecha">@ev.FechaTexto</span></td>
                                    <td class="fw-bold text-dark">S/. @ev.Precio.ToString("N2")</td>
                                    <td class="text-center fw-bold text-success fs-6">@ev.EntradasVendidas</td>
                                    <td class="text-center fw-bold text-primary fs-6">@ev.EntradasDisponibles</td>
                                    <td class="text-center text-muted">@ev.CapacidadTotal</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </section>

    </main>
</div>

<style>
    /* TODOS TUS ESTILOS SE MANTIENEN IGUAL */
    .entradas-eventos-contenedor {
        min-height: 100vh;
        background-color: #f2edff;
        font-family: Arial, Helvetica, sans-serif;
        color: #110846;
    }

    .contenido-perfil {
        padding: 40px 50px;
    }

    .titulo-section {
        background-color: white;
        padding: 35px 42px;
        border-radius: 8px;
    }

        .titulo-section h1 {
            margin: 0;
            font-size: 38px;
            font-weight: bold;
            letter-spacing: 2px;
            color: #15095f;
        }

    .tarjeta-kpi-anf {
        background: #ffffff;
        border: 1px solid #e1dbf5;
        border-radius: 14px;
        padding: 22px;
        box-shadow: 0 4px 15px rgba(21, 9, 95, 0.04);
        min-height: 135px;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

        .tarjeta-kpi-anf.destacada-anf {
            background: linear-gradient(135deg, #ffffff 0%, #f7f5ff 100%);
            border: 1px solid #c3b6f2;
        }

    .kpi-titulo-anf {
        font-size: 12px;
        letter-spacing: 1px;
        color: #666688;
        font-weight: bold;
    }

    .kpi-valor-anf {
        font-size: 32px;
        font-weight: bold;
        color: #15095f;
        margin: 2px 0;
    }

    .kpi-valor-evento {
        font-size: 20px;
        font-weight: bold;
        color: #15095f;
        margin: 4px 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .tabla-scroll-contenedor {
        max-height: 400px;
        overflow-y: auto;
        border: 1px solid #f0edf5;
        border-radius: 4px;
    }

        .tabla-scroll-contenedor::-webkit-scrollbar {
            width: 8px;
        }

        .tabla-scroll-contenedor::-webkit-scrollbar-track {
            background: #f1edf5;
        }

        .tabla-scroll-contenedor::-webkit-scrollbar-thumb {
            background: #c3b6f2;
            border-radius: 4px;
        }

            .tabla-scroll-contenedor::-webkit-scrollbar-thumb:hover {
                background: #15095f;
            }

    .Custom-tabla-anf {
        border: none;
        width: 100%;
    }

        .Custom-tabla-anf thead th {
            color: #0c2775 !important;
            background-color: #d1e8ff !important;
            font-weight: bold;
            padding: 14px;
            font-size: 15px;
            position: sticky;
            top: 0;
            z-index: 2;
        }

        .Custom-tabla-anf tbody td {
            padding: 15px 14px;
            font-size: 15px;
            color: #333;
        }

    .text-indigo {
        color: #15095f;
    }

    .badge-fecha {
        background-color: #cbdcf7;
        color: #0c2775;
        padding: 5px 12px;
        border-radius: 15px;
        font-weight: 500;
        font-size: 13px;
    }

    @@media (max-width: 900px) {
        .contenido-perfil {
            padding: 20px 15px;
        }

        .titulo-section h1 {
            font-size: 28px;
        }
    }
</style>

@code {
    private bool cargando = true;
    private List<InventarioEventoDto> listadoInventario = new();

    // Variables para los KPIs superiores
    private string eventoMasVendido = "";
    private int maxVendidas = 0;
    private string eventoMasLibre = "";
    private int maxLibres = 0;
    private int totalVendidas = 0;
    private int totalEmitidas = 0;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity is not null && user.Identity.IsAuthenticated)
        {
            var idClaim = user.FindFirst("IdUsuario")?.Value;

            if (int.TryParse(idClaim, out int idAnfitrion))
            {
                // 1. Traemos los eventos de este anfitrión
                var todosLosEventos = await AnfitrionService.VerTodosLosEventosAsync();
                var misEventos = todosLosEventos?.Where(e => e.anfitrion != null && e.anfitrion.idUsuario == idAnfitrion).ToList() ?? new();

                // 2. Traemos TODAS las compras hechas a los eventos de este anfitrión
                var compras = await AnfitrionService.VerComprasDeSusEventosAsync(idAnfitrion);

                listadoInventario.Clear();
                totalVendidas = 0;
                totalEmitidas = 0;

                // 3. Cruzamos y agrupamos los datos (AQUÍ ESTÁ LA MAGIA)
                foreach (var ev in misEventos)
                {
                    // Comparamos el idEvento de la compra (int) con el id del evento (string)
                    int vendidas = compras?.Where(c => c.idEvento == ev.id).Sum(c => c.entradasCompradas) ?? 0;

                    int disponibles = ev.capacidad_entradas - vendidas;
                    if (disponibles < 0) disponibles = 0;

                    listadoInventario.Add(new InventarioEventoDto
                    {
                        Id = ev.id, // Tu ID de evento es string
                        Titulo = string.IsNullOrEmpty(ev.titulo) ? "Sin título" : ev.titulo,
                        FechaTexto = ev.fechaModerna?.ToString("dd/MM/yyyy") ?? "Pendiente",
                        Precio = ev.precio,
                        EntradasVendidas = vendidas,
                        EntradasDisponibles = disponibles,
                        CapacidadTotal = ev.capacidad_entradas
                    });

                    totalVendidas += vendidas;
                    totalEmitidas += ev.capacidad_entradas;
                }

                // 4. Calculamos los KPIs usando LINQ para encontrar los máximos
                if (listadoInventario.Any())
                {
                    var masVendido = listadoInventario.OrderByDescending(x => x.EntradasVendidas).First();
                    eventoMasVendido = masVendido.Titulo;
                    maxVendidas = masVendido.EntradasVendidas;

                    var masLibre = listadoInventario.OrderByDescending(x => x.EntradasDisponibles).First();
                    eventoMasLibre = masLibre.Titulo;
                    maxLibres = masLibre.EntradasDisponibles;
                }
            }
        }

        cargando = false;
    }

    private class InventarioEventoDto
    {
        public int Id { get; set; }
        public string Titulo { get; set; } = string.Empty;
        public string FechaTexto { get; set; } = string.Empty;
        public decimal Precio { get; set; }
        public int EntradasVendidas { get; set; }
        public int EntradasDisponibles { get; set; }
        public int CapacidadTotal { get; set; }
    }
}
@page "/cliente/detalle-evento/{Id:int}"
@using Microsoft.AspNetCore.Components
@using System.Collections.Generic

<div class="detalle-evento-page">

    <div class="detalle-contenedor">

        <div class="poster-evento @evento.ClasePoster">
            <div class="poster-contenido">
                <p class="poster-fecha">@evento.FechaPoster</p>
                <h2>@evento.TituloPoster</h2>
                <p>@evento.SubtituloPoster</p>
                <p class="poster-lugar">@evento.Ubicacion</p>
            </div>
        </div>

        <div class="info-evento">
            <h1>@evento.Titulo</h1>

            <div class="descripcion">
                @evento.Descripcion
            </div>

            <div class="datos-evento">
                <div class="fila-dato">
                    <label>Fecha</label>
                    <span>@evento.Fecha</span>
                </div>

                <div class="fila-dato">
                    <label>Ubicación</label>
                    <span>@evento.Ubicacion</span>
                </div>

                <div class="fila-dato">
                    <label>Precio</label>
                    <span>@evento.Precio</span>
                </div>
            </div>

            <div class="acciones">
                <a href="/cliente/eventos" class="btn-volver">Volver</a>

                <a href="@($"/cliente/resumen-compra/{evento.Id}")" class="btn-comprar">
                    Comprar entrada
                </a>
            </div>
        </div>

    </div>

</div>

<style>
    .detalle-evento-page {
        min-height: 100vh;
        background: linear-gradient(90deg, #05051f 0%, #1d1270 45%, #3928d8 100%);
        font-family: Arial, Helvetica, sans-serif;
        color: white;
        padding: 60px 70px;
    }

    .detalle-contenedor {
        display: grid;
        grid-template-columns: 420px 1fr;
        gap: 60px;
        align-items: center;
        max-width: 1200px;
        margin: 0 auto;
    }

    .poster-evento {
        height: 600px;
        border: 4px solid #111;
        box-shadow: 0 12px 28px rgba(0, 0, 0, 0.45);
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
    }

    .poster-frio {
        background: linear-gradient(135deg, #111111, #4a4a4a);
    }

    .poster-poemax {
        background: linear-gradient(135deg, #000000, #1c1648);
    }

    .poster-teatro {
        background: linear-gradient(135deg, #21083f, #6931b8);
    }

    .poster-concierto {
        background: linear-gradient(135deg, #08213f, #1787b8);
    }

    .poster-contenido {
        padding: 30px;
    }

    .poster-fecha {
        font-size: 18px;
        letter-spacing: 3px;
        margin-bottom: 35px;
    }

    .poster-evento h2 {
        font-size: 62px;
        font-weight: bold;
        margin-bottom: 15px;
    }

    .poster-evento p {
        font-size: 20px;
    }

    .poster-lugar {
        margin-top: 170px;
        font-size: 17px;
        letter-spacing: 2px;
    }

    .info-evento h1 {
        font-size: 64px;
        font-weight: bold;
        margin-bottom: 35px;
    }

    .descripcion {
        border: 3px solid white;
        border-radius: 20px;
        padding: 30px;
        min-height: 180px;
        font-size: 22px;
        line-height: 1.5;
        margin-bottom: 35px;
    }

    .datos-evento {
        display: flex;
        flex-direction: column;
        gap: 18px;
    }

    .fila-dato {
        display: grid;
        grid-template-columns: 160px 1fr;
        gap: 15px;
        align-items: center;
    }

        .fila-dato label {
            border: 2px solid white;
            border-radius: 8px;
            padding: 14px;
            font-size: 18px;
            font-weight: bold;
        }

        .fila-dato span {
            border: 2px solid white;
            border-radius: 8px;
            padding: 14px;
            font-size: 18px;
        }

    .acciones {
        display: flex;
        justify-content: flex-end;
        gap: 20px;
        margin-top: 45px;
    }

    .btn-volver,
    .btn-comprar {
        display: inline-block;
        text-decoration: none;
        border-radius: 30px;
        padding: 15px 38px;
        font-size: 18px;
        font-weight: bold;
    }

    .btn-volver {
        color: white;
        border: 3px solid white;
    }

    .btn-comprar {
        color: #160b62;
        background-color: white;
        border: 3px solid white;
    }

    .btn-volver:hover {
        background-color: white;
        color: #160b62;
    }

    .btn-comprar:hover {
        background-color: #dffcff;
        color: #160b62;
    }

    @@media (max-width: 900px) {
        .detalle-evento-page {
            padding: 35px 25px;
        }

        .detalle-contenedor {
            grid-template-columns: 1fr;
            gap: 35px;
        }

        .poster-evento {
            height: 420px;
        }

        .poster-lugar {
            margin-top: 100px;
        }

        .info-evento h1 {
            font-size: 46px;
        }

        .fila-dato {
            grid-template-columns: 1fr;
        }

        .acciones {
            justify-content: center;
            flex-direction: column;
        }

        .btn-volver,
        .btn-comprar {
            text-align: center;
        }
    }
</style>

@code {
    [Parameter]
    public int Id { get; set; }

    private EventoDetalle evento = new EventoDetalle(
        1,
        "Nombre de un Evento muy Interesante",
        "FRÍOS",
        "1ra Temporada",
        "15 MARZO   8:00 PM",
        "Av. No sé 123, San Miguel",
        "15/03/2026 - 8:00 a 10:00 pm",
        "S/. 45.00",
        "Un show de comedia en vivo con invitados especiales. Una noche ligera, divertida y perfecta para pasarla con amigos.",
        "poster-frio"
    );

    private List<EventoDetalle> eventos = new List<EventoDetalle>
    {
        new EventoDetalle(
            1,
            "Nombre de un Evento muy Interesante",
            "FRÍOS",
            "1ra Temporada",
            "15 MARZO   8:00 PM",
            "Av. No sé 123, San Miguel",
            "15/03/2026 - 8:00 a 10:00 pm",
            "S/. 45.00",
            "Un show de comedia en vivo con invitados especiales. Una noche ligera, divertida y perfecta para pasarla con amigos.",
            "poster-frio"
        ),

        new EventoDetalle(
            2,
            "Poemax",
            "POEMAX",
            "Stand-up comedy y poesía",
            "07 MAYO   10:30 PM",
            "Pasaje Porta 132, Miraflores",
            "07/05/2026 - 10:30 a 11:30 pm",
            "S/. 50.00",
            "Evento que combina humor, poesía y una experiencia cultural distinta para disfrutar una noche diferente.",
            "poster-poemax"
        ),

        new EventoDetalle(
            3,
            "Obra de Teatro: Hamlet",
            "HAMLET",
            "Obra teatral",
            "12 JULIO   7:30 PM",
            "Teatro Municipal de Lima",
            "12/07/2026 - 7:30 a 9:30 pm",
            "S/. 90.00",
            "Presentación teatral inspirada en Hamlet. Una puesta en escena dramática con actores locales y producción moderna.",
            "poster-teatro"
        ),

        new EventoDetalle(
            4,
            "Concierto Rock Nocturno",
            "ROCK",
            "Música en vivo",
            "20 AGOSTO   9:00 PM",
            "Av. La Marina 456, Pueblo Libre",
            "20/08/2026 - 9:00 a 11:00 pm",
            "S/. 75.00",
            "Concierto de bandas locales con música en vivo, ambiente nocturno y una experiencia pensada para fanáticos del rock.",
            "poster-concierto"
        )
    };

    protected override void OnParametersSet()
    {
        evento = ObtenerEvento(Id);
    }

    private EventoDetalle ObtenerEvento(int id)
    {
        foreach (EventoDetalle item in eventos)
        {
            if (item.Id == id)
            {
                return item;
            }
        }

        return eventos[0];
    }

    private class EventoDetalle
    {
        public int Id { get; set; }
        public string Titulo { get; set; }
        public string TituloPoster { get; set; }
        public string SubtituloPoster { get; set; }
        public string FechaPoster { get; set; }
        public string Ubicacion { get; set; }
        public string Fecha { get; set; }
        public string Precio { get; set; }
        public string Descripcion { get; set; }
        public string ClasePoster { get; set; }

        public EventoDetalle(int id, string titulo, string tituloPoster, string subtituloPoster,
            string fechaPoster, string ubicacion, string fecha, string precio,
            string descripcion, string clasePoster)
        {
            Id = id;
            Titulo = titulo;
            TituloPoster = tituloPoster;
            SubtituloPoster = subtituloPoster;
            FechaPoster = fechaPoster;
            Ubicacion = ubicacion;
            Fecha = fecha;
            Precio = precio;
            Descripcion = descripcion;
            ClasePoster = clasePoster;
        }
    }
}
@page "/cliente/compra/{Id:int}/{Disponible:int}"

@using Microsoft.AspNetCore.Components
@using TicketFlowWeb.Models
@using TicketFlowWeb.Services.EventoRS
@using TicketFlowWeb.Services.UsuarioRS
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize]

@inject EventoRestService EventoService
@inject UsuarioRestService UsuarioService
@inject AuthenticationStateProvider AuthStateProvider

<div class="resumen-compra-page">

    @if (evento == null)
    {
        <div class="loading-container">
            <p>Cargando operacion de compra...</p>
        </div>
    }
    else
    {
        <div class="resumen-contenedor">

            <div class="columna-imagen">
                <img src="@evento.img" alt="Portada del Evento" class="imagen-evento" />
            </div>

            <div class="panel-compra">
                <h1>@evento.titulo</h1>
                <h5 class="text-light">Entradas disponibles: @Disponible</h5>
                <br />
                <div class="formulario-compra">

                    <div class="fila-cantidad">
                        <label>Cantidad de entradas:</label>

                        <div class="control-cantidad">
                            <button type="button" @onclick="DisminuirCantidad">−</button>
                            <span>@cantidadEntradas</span>
                            <button type="button" @onclick="AumentarCantidad">+</button>
                        </div>
                    </div>

                    <div class="fila-dato">
                        <label>Subtotal:</label>
                        <span>S/. @Subtotal.ToString("0.00")</span>
                    </div>

                    <div class="fila-dato">
                        <label>Puntos bonus disponibles:</label>
                        <span>@puntosBonusDisponiblesCliente puntos</span>
                    </div>

                    <div class="fila-descuento">
                        <label>Aplicar descuento:</label>

                        <div class="opciones-descuento">
                            <div class="opcion">
                                <input type="radio"
                                       name="descuento"
                                       checked="@(idPuntoBonusSeleccionado == 4)"
                                       @onchange="@(() => SeleccionarDescuento(0, 0.00m))" />
                                <span>No usar puntos</span>
                            </div>

                            <div class="opcion">
                                <input type="radio"
                                       name="descuento"
                                       disabled="@(puntosBonusDisponiblesCliente < 100)"
                                       checked="@(idPuntoBonusSeleccionado == 1)"
                                       @onchange="@(() => SeleccionarDescuento(1, 0.10m))" />
                                <span>@((cantidadEntradas * 100) - (cantidadEntradas - 1) * 10) puntos = 10% de desc. (-S/. @((Subtotal * 0.10m).ToString("0.00")))</span>
                                <span class="info-icon" data-tooltip="Por cada entrada extra, la cantidad de puntos bonus necesarios serán 90.">ⓘ</span>
                            </div>

                            <div class="opcion">
                                <input type="radio"
                                       name="descuento"
                                       disabled="@(puntosBonusDisponiblesCliente < 200)"
                                       checked="@(idPuntoBonusSeleccionado == 2)"
                                       @onchange="@(() => SeleccionarDescuento(2, 0.20m))" />
                                <span>@((cantidadEntradas * 200) - (cantidadEntradas - 1) * 20) puntos = 20% de desc. (-S/. @((Subtotal * 0.20m).ToString("0.00")))</span>
                                <span class="info-icon" data-tooltip="Por cada entrada extra, la cantidad de puntos bonus necesarios serán 180.">ⓘ</span>
                            </div>

                            <div class="opcion">
                                <input type="radio"
                                       name="descuento"
                                       disabled="@(puntosBonusDisponiblesCliente < 300)"
                                       checked="@(idPuntoBonusSeleccionado == 3)"
                                       @onchange="@(() => SeleccionarDescuento(3, 0.30m))" />
                                <span>@((cantidadEntradas * 300) - (cantidadEntradas-1)*30) puntos = 30% de desc. (-S/. @((Subtotal * 0.30m).ToString("0.00")))</span>
                                <span class="info-icon" data-tooltip="Por cada entrada extra, la cantidad de puntos bonus necesarios serán 270.">ⓘ</span>
                            </div>
                        </div>
                    </div>

                    <div class="fila-dato total">
                        <label>Total:</label>
                        <span>S/. @Total.ToString("0.00")</span>
                    </div>

                    <div class="acciones">
                        <a href="@($"/public/detalle-evento/{Id}")" class="btn-volver">Volver</a>

                        @if (cantidadEntradas <= Disponible && cantidadEntradas > 0)
                        {
                            <a href="@($"/cliente/confirmar-pago/{idClienteLogueado}/{Id}/{cantidadEntradas}/{idPuntoBonusSeleccionado}/{Subtotal}/{Total}")"
                               class="btn-continuar">
                                Continuar con el pago
                            </a>
                        }
                        else
                        {
                            <a class="btn-continuar disabled"
                               style="cursor: not-allowed; opacity: 0.5; pointer-events: none; background-color: #6b7280;">
                                Continuar con el pago
                            </a>
                        }
                    </div>

                </div>
            </div>

        </div>
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    [Parameter]
    public int Disponible { get; set; }

    public int cantidadEntradas = 1;
    public int idPuntoBonusSeleccionado = 4;
    public decimal porcentajeDescuento = 0.00m;

    // Variables dinámicas para el cliente de la sesión
    public int idClienteLogueado;
    public int puntosBonusDisponiblesCliente = 0;
    private EventoViewModel? evento;

    protected override async Task OnParametersSetAsync()
    {
        // 1. Jalamos el evento de la URL
        evento = await EventoService.verDetalleEventoAsync(Id);

        // 2. Extraemos el estado de autenticación de Blazor
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity != null && user.Identity.IsAuthenticated)
        {
            foreach (var claim in user.Claims)
            {
                Console.WriteLine($"👉 Tipo de Claim encontrado: '{claim.Type}' | Valor: '{claim.Value}'");
            }

            // 3. Intento de captura flexible
            var idClaim = user.FindFirst(c => c.Type == "IdUsuario")?.Value
                       ?? user.FindFirst(c => c.Type == System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
                       ?? user.FindFirst(c => c.Type == "id")?.Value;

            if (int.TryParse(idClaim, out int idParseado))
            {
                idClienteLogueado = idParseado;
                // 4. Disparamos tu servicio
                puntosBonusDisponiblesCliente = await UsuarioService.ObtenerPuntosBonusAsync(idClienteLogueado);
                Console.WriteLine($"✅ ID Cliente Detectado: {idClienteLogueado}. Puntos devueltos por el servicio: {puntosBonusDisponiblesCliente}");
            }
            else
            {
                Console.WriteLine("❌ ERROR: El Claim con el ID del usuario fue encontrado pero no se pudo transformar a un número entero.");
            }
        }
        else
        {
            Console.WriteLine("❌ ERROR: El usuario no está autenticado en el contexto de Blazor.");
        }
    }

    private decimal Subtotal => (decimal)(evento?.precio ?? 0) * cantidadEntradas;
    private decimal Total
    {
        get
        {
            decimal descuentoCalculado = Subtotal * porcentajeDescuento;
            decimal total = Subtotal - descuentoCalculado;
            return total < 0 ? 0 : total;
        }
    }

    private void AumentarCantidad() => cantidadEntradas++;
    private void DisminuirCantidad()
    {
        if (cantidadEntradas > 1) cantidadEntradas--;
    }

    private void SeleccionarDescuento(int idBonus, decimal porcentaje)
    {
        idPuntoBonusSeleccionado = idBonus;
        porcentajeDescuento = porcentaje;
    }
}

<style>
    .resumen-compra-page {
        min-height: 100vh;
        background: linear-gradient(90deg, #05051f 0%, #1d1270 45%, #3928d8 100%);
        font-family: Arial, Helvetica, sans-serif;
        color: white;
        padding: 60px 70px;
    }

    .resumen-contenedor {
        display: grid;
        grid-template-columns: 420px 1fr;
        gap: 60px;
        align-items: center;
        max-width: 1200px;
        margin: 0 auto;
    }

    /* 🎨 NUEVOS ESTILOS PARA ADAPTAR LA IMAGEN PERFECTAMENTE */
    .columna-imagen {
        width: 100%;
        display: flex;
        align-items: center;
    }

    .imagen-evento {
        width: 100%;
        max-height: 600px;
        object-fit: cover;
        border: 4px solid white;
        border-radius: 15px;
        box-shadow: 0 12px 28px rgba(0, 0, 0, 0.45);
    }

    .poster-frio {
        background: linear-gradient(135deg, #111111, #4a4a4a);
    }

    .poster-poemax {
        background: linear-gradient(135deg, #000000, #1c1648);
    }

    .poster-teatro {
        background: linear-gradient(135deg, #21083f, #6931b8);
    }

    .poster-concierto {
        background: linear-gradient(135deg, #08213f, #1787b8);
    }

    .poster-fecha {
        font-size: 18px;
        letter-spacing: 3px;
        margin-bottom: 35px;
    }

    .poster-evento h2 {
        font-size: 62px;
        font-weight: bold;
        margin-bottom: 15px;
    }

    .poster-evento p {
        font-size: 20px;
    }

    .poster-lugar {
        margin-top: 170px;
        font-size: 17px;
        letter-spacing: 2px;
    }

    .panel-compra h1 {
        font-size: 58px;
        font-weight: bold;
        margin-bottom: 35px;
    }

    .formulario-compra {
        max-width: 650px;
    }

    .fila-cantidad,
    .fila-dato,
    .fila-descuento {
        display: grid;
        grid-template-columns: 230px 1fr;
        gap: 18px;
        align-items: center;
        margin-bottom: 18px;
    }

        .fila-cantidad label,
        .fila-dato label,
        .fila-descuento label {
            border: 2px solid white;
            border-radius: 8px;
            padding: 14px;
            font-size: 18px;
            font-weight: bold;
        }

        .fila-dato span {
            border: 2px solid white;
            border-radius: 8px;
            padding: 14px;
            font-size: 18px;
        }

    .control-cantidad {
        display: flex;
        align-items: center;
        gap: 16px;
    }

        .control-cantidad button {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            border: 2px solid white;
            background-color: transparent;
            color: white;
            font-size: 22px;
            font-weight: bold;
            cursor: pointer;
        }

        .control-cantidad span {
            min-width: 45px;
            text-align: center;
            border: 2px solid white;
            border-radius: 8px;
            padding: 10px 15px;
            font-size: 20px;
        }

    .opciones-descuento {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .opcion {
        display: grid;
        grid-template-columns: 30px 1fr;
        gap: 10px;
        align-items: center;
    }

        .opcion input {
            width: 20px;
            height: 20px;
        }

        .opcion span {
            border: none;
            padding: 0;
            font-size: 17px;
            font-weight: bold;
        }

        .opcion input:disabled + span {
            opacity: 0.45;
        }

    .total {
        margin-top: 25px;
    }

        .total label,
        .total span {
            font-size: 20px;
            font-weight: bold;
        }

    .acciones {
        display: flex;
        justify-content: flex-end;
        gap: 20px;
        margin-top: 30px;
    }

    .btn-volver,
    .btn-continuar {
        display: inline-block;
        text-decoration: none;
        border-radius: 30px;
        padding: 15px 34px;
        font-size: 18px;
        font-weight: bold;
    }

    .btn-volver {
        color: white;
        border: 3px solid white;
    }

    .btn-continuar {
        color: #160b62;
        background-color: white;
        border: 3px solid white;
    }

    .btn-volver:hover {
        background-color: white;
        color: #160b62;
    }

    .btn-continuar:hover {
        background-color: #dffcff;
        color: #160b62;
    }

    @@media (max-width: 900px) {
        .resumen-compra-page {
            padding: 35px 25px;
        }

        .resumen-contenedor {
            grid-template-columns: 1fr;
            gap: 35px;
        }

        .poster-lugar {
            margin-top: 100px;
        }

        .panel-compra h1 {
            font-size: 42px;
        }

        .fila-cantidad,
        .fila-dato,
        .fila-descuento {
            grid-template-columns: 1fr;
        }

        .acciones {
            flex-direction: column;
        }

        .btn-volver,
        .btn-continuar {
            text-align: center;
        }
    }

    /* Alineación de la opción para que el icono quede perfecto al costado */
    .opcion {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 8px;
    }

    /* Estilo del símbolo (i) */
    .info-icon {
        display: inline-block;
        color: #0284c7; /* Azul sutil */
        font-weight: bold;
        cursor: help; /* Cambia el puntero a un signo de pregunta/ayuda */
        font-size: 14px;
        position: relative;
        margin-left: 4px;
        transition: color 0.2s ease;
    }

        .info-icon:hover {
            color: #0369a1; /* Azul más oscuro al pasar el mouse */
        }

        /* 🛠️ EL TOOLTIP (Contenedor oculto por defecto) */
        .info-icon::after {
            content: attr(data-tooltip); /* Toma el texto del atributo html */
            position: absolute;
            bottom: 130%; /* Lo posiciona arriba del icono */
            left: 50%;
            transform: translateX(-50%) scale(0.9);
            background-color: #1e293b; /* Fondo gris oscuro/slate elegante */
            color: #ffffff;
            padding: 8px 12px;
            border-radius: 6px;
            font-size: 12px;
            font-family: sans-serif;
            font-weight: normal;
            white-space: pre-line; /* Permite saltos si es texto largo */
            width: 220px; /* Ancho máximo para que no se desarme */
            text-align: center;
            box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
            opacity: 0;
            pointer-events: none; /* Evita que estorbe si se pasa el mouse cerca */
            transition: opacity 0.2s ease, transform 0.2s ease;
            z-index: 50;
        }

        /* 🛠️ La flechita del Tooltip */
        .info-icon::before {
            content: "";
            position: absolute;
            bottom: 110%;
            left: 50%;
            transform: translateX(-50%);
            border-width: 6px;
            border-style: solid;
            border-color: #1e293b transparent transparent transparent; /* Flecha apuntando abajo */
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.2s ease;
            z-index: 50;
        }

        /* 🚀 ACCIÓN: Mostrar cuando el puntero pasa por encima */
        .info-icon:hover::after,
        .info-icon:hover::before {
            opacity: 1;
            transform: translateX(-50%) scale(1);
        }
</style>
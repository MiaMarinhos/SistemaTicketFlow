</style>

@code {
    [Parameter]
    public int Id { get; set; }

    private int cantidadEntradas = 1;
    private int puntosBonus = 100;
    private decimal descuentoSeleccionado = 10;

    private EventoResumen evento = new EventoResumen(
        1,
        "Nombre de un Evento muy Interesante",
        "FRÍOS",
        "1ra Temporada",
        "15 MARZO   8:00 PM",
        "Av. No sé 123, San Miguel",
        45,
        "poster-frio"
    );

    private List<EventoResumen> eventos = new List<EventoResumen>
    {
        new EventoResumen(
            1,
            "Nombre de un Evento muy Interesante",
            "FRÍOS",
            "1ra Temporada",
            "15 MARZO   8:00 PM",
            "Av. No sé 123, San Miguel",
            45,
            "poster-frio"
        ),

        new EventoResumen(
            2,
            "Poemax",
            "POEMAX",
            "Stand-up comedy y poesía",
            "07 MAYO   10:30 PM",
            "Pasaje Porta 132, Miraflores",
            50,
            "poster-poemax"
        ),

        new EventoResumen(
            3,
            "Obra de Teatro: Hamlet",
            "HAMLET",
            "Obra teatral",
            "12 JULIO   7:30 PM",
            "Teatro Municipal de Lima",
            90,
            "poster-teatro"
        ),

        new EventoResumen(
            4,
            "Concierto Rock Nocturno",
            "ROCK",
            "Música en vivo",
            "20 AGOSTO   9:00 PM",
            "Av. La Marina 456, Pueblo Libre",
            75,
            "poster-concierto"
        )
    };

    private decimal Subtotal
    {
        get
        {
            return evento.PrecioUnitario * cantidadEntradas;
        }
    }

    private decimal Total
    {
        get
        {
            decimal total = Subtotal - descuentoSeleccionado;

            if (total < 0)
            {
                return 0;
            }

            return total;
        }
    }

    protected override void OnParametersSet()
    {
        evento = ObtenerEvento(Id);
    }

    private void AumentarCantidad()
    {
        cantidadEntradas++;
    }

    private void DisminuirCantidad()
    {
        if (cantidadEntradas > 1)
        {
            cantidadEntradas--;
        }
    }

    private void SeleccionarDescuento(decimal descuento)
    {
        descuentoSeleccionado = descuento;
    }

    private EventoResumen ObtenerEvento(int id)
    {
        foreach (EventoResumen item in eventos)
        {
            if (item.Id == id)
            {
                return item;
            }
        }

        return eventos[0];
    }

    private class EventoResumen
    {
        public int Id { get; set; }
        public string Titulo { get; set; }
        public string TituloPoster { get; set; }
        public string SubtituloPoster { get; set; }
        public string FechaPoster { get; set; }
        public string Ubicacion { get; set; }
        public decimal PrecioUnitario { get; set; }
        public string ClasePoster { get; set; }

        public EventoResumen(int id, string titulo, string tituloPoster, string subtituloPoster,
            string fechaPoster, string ubicacion, decimal precioUnitario, string clasePoster)
        {
            Id = id;
            Titulo = titulo;
            TituloPoster = tituloPoster;
            SubtituloPoster = subtituloPoster;
            FechaPoster = fechaPoster;
            Ubicacion = ubicacion;
            PrecioUnitario = precioUnitario;
            ClasePoster = clasePoster;
        }
    }
}
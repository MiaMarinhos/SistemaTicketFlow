@page "/cliente/resumen-compra/{Id:int}"
@using Microsoft.AspNetCore.Components

<div class="resumen-compra-page">

    <div class="resumen-contenedor">

        <div class="poster-evento @evento.ClasePoster">
            <div class="poster-contenido">
                <p class="poster-fecha">@evento.FechaPoster</p>
                <h2>@evento.TituloPoster</h2>
                <p>@evento.SubtituloPoster</p>
                <p class="poster-lugar">@evento.Ubicacion</p>
            </div>
        </div>

        <div class="panel-compra">
            <h1>@evento.Titulo</h1>

            <div class="formulario-compra">

                <div class="fila-cantidad">
                    <label>Cantidad de entradas:</label>

                    <div class="control-cantidad">
                        <button type="button" @onclick="DisminuirCantidad">−</button>
                        <span>@cantidadEntradas</span>
                        <button type="button" @onclick="AumentarCantidad">+</button>
                    </div>
                </div>

                <div class="fila-dato">
                    <label>Subtotal:</label>
                    <span>S/. @Subtotal.ToString("0.00")</span>
                </div>

                <div class="fila-dato">
                    <label>Puntos bonus disponibles:</label>
                    <span>@puntosBonus puntos</span>
                </div>

                <div class="fila-descuento">
                    <label>Aplicar descuento:</label>

                    <div class="opciones-descuento">
                        <div class="opcion">
                            <input type="radio"
                                   name="descuento"
                                   checked="@(descuentoSeleccionado == 0)"
                                   @onchange="@(() => SeleccionarDescuento(0))" />
                            <span>No usar</span>
                        </div>

                        <div class="opcion">
                            <input type="radio"
                                   name="descuento"
                                   checked="@(descuentoSeleccionado == 5)"
                                   @onchange="@(() => SeleccionarDescuento(5))" />
                            <span>50 puntos = S/. 5.00</span>
                        </div>

                        <div class="opcion">
                            <input type="radio"
                                   name="descuento"
                                   checked="@(descuentoSeleccionado == 10)"
                                   @onchange="@(() => SeleccionarDescuento(10))" />
                            <span>100 puntos = S/. 10.00</span>
                        </div>
                    </div>
                </div>

                <div class="fila-dato total">
                    <label>Total:</label>
                    <span>S/. @Total.ToString("0.00")</span>
                </div>

                <div class="acciones">
                    <a href="@($"/cliente/detalle-evento/{evento.Id}")" class="btn-volver">Volver</a>
                    <a href="@($"/cliente/confirmar-pago/{evento.Id}")" class="btn-continuar">
                        Continuar con el pago
                    </a>
                </div>

            </div>
        </div>

    </div>

</div>


    .btn-volver,
    .btn-continuar {
        display: inline-block;
        text-decoration: none;
        border-radius: 30px;
        padding: 15px 34px;
        font-size: 18px;
        font-weight: bold;
    }

    .btn-volver {
        color: white;
        border: 3px solid white;
    }

    .btn-continuar {

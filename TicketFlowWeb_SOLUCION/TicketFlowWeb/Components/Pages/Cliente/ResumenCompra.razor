        margin-bottom: 35px;
    }

    .poster-evento h2 {
        font-size: 62px;
        font-weight: bold;
        margin-bottom: 15px;
    }

    .poster-evento p {
        font-size: 20px;
    }

    .poster-lugar {
        margin-top: 170px;
        font-size: 17px;
        letter-spacing: 2px;
    }

    .panel-compra h1 {
        font-size: 58px;
        font-weight: bold;

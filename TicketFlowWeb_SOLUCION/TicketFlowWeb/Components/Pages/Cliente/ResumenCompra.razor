    @@media (max-width: 900px) {
        .resumen-compra-page {
            padding: 35px 25px;
        }

        .resumen-contenedor {
            grid-template-columns: 1fr;
            gap: 35px;
        }

        .poster-evento {
            height: 420px;
        }

        .poster-lugar {
            margin-top: 100px;
        }

        .panel-compra h1 {
            font-size: 42px;
        }

        .fila-cantidad,
        .fila-dato,
        .fila-descuento {
            grid-template-columns: 1fr;
        }

        .acciones {
            flex-direction: column;
        }

        .btn-volver,
        .btn-continuar {
            text-align: center;
        }

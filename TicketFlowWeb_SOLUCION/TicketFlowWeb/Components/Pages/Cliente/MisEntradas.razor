@page "/cliente/mis-entradas"
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using TicketFlowWeb.Models
@using TicketFlowWeb.Services.CompraRS


<div class="mis-entradas-page">

    <section class="bienvenida-cliente">
        <h1>ENTRADAS COMPRADAS</h1>
        <a href="/cliente/perfil" class="btn-anfitrion">VOLVER</a>
    </section>

    @if (!string.IsNullOrEmpty(mensajeError))
    {
        <div class="alert alert-danger">
            @mensajeError
        </div>
    }
    else if (compras == null)
    {
        <p class="msg-info">Cargando tu historial de entradas desde el servidor...</p>
    }
    else if (!compras.Any())
    {
        <p class="msg-info">Aún no has comprado ninguna entrada. ¡Anímate a asistir a un evento!</p>
    }
    else
    {
        <section class="entradas-section">
            @foreach (var compra in compras)
            {
                <div class="entrada-rectangulo">

                    @* 🖼️ Miniatura del póster (Izquierda) *@
                    @if (compra.evento != null)
                    {
                        <div class="mini-poster">
                            <img src="@compra.evento.img" alt="Poster" />
                        </div>
                    }

                    @* ℹ️ Zona central: Distribución de datos en columnas dinámicas *@
                    <div class="info-compra-central">
                        <div>
                            <h3>@(compra.evento?.titulo ?? "Evento")</h3>
                            <p class="organizador">Organiza: <strong>@(compra.evento?.anfitrion?.nombre ?? "Anfitrión")</strong></p>
                        </div>

                        <div class="detalle-gris">
                            <p>📍 <strong>Lugar:</strong> @(compra.evento?.ubicacion)</p>
                            <p>🏢 @(compra.evento?.nombre_establecimiento)</p>
                        </div>

                        <div class="detalle-gris">
                            <p>📅 <strong>Fecha:</strong> @compra.fechaCompraS</p>
                            <p>🎟️ <strong>Entradas:</strong> @compra.entradasCompradas unids.</p>
                        </div>

                        <div class="detalle-gris">
                            <p>💰 <strong>Total Pagado:</strong></p>
                            <span class="precio-total">S/. @compra.montoTotal.ToString("0.00")</span>
                        </div>
                    </div>
                    <button type="button" class="btn-descargar btn-reporte-pendiente" @onclick="() => ExportarEntradaPdf(compra.idCompra)" > Descargar entrada </button>
                    
                </div>
            }
        </section>
    }
</div>


<style>
    .mis-entradas-page {
        max-width: 1000px;
        margin: 0 auto;
        padding: 20px;
        font-family: 'Tahoma', sans-serif;
        color: #ffffff;
    }

    /* Encabezado de la página */
    .bienvenida-cliente {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
        border-bottom: 2px solid #525D76;
        padding-bottom: 15px;
    }

        .bienvenida-cliente h1 {
            font-size: 24px;
            font-weight: bold;
            margin: 0;
            color: #00ffd0;
        }

    /* Botón Volver */
    .btn-anfitrion {
        background-color: #525D76;
        color: white;
        padding: 10px 20px;
        text-decoration: none;
        border-radius: 6px;
        font-weight: bold;
        font-size: 14px;
        transition: background-color 0.2s ease;
    }

        .btn-anfitrion:hover {
            background-color: #3b4456;
        }

    /* Sección contenedora de la lista */
    .entradas-section {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    /* 📦 EL RECTÁNGULO PRINCIPAL DE LA COMPRA */
    .entrada-rectangulo {
        display: flex;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
        align-items: center;
        padding: 15px 25px;
        transition: transform 0.2s ease, background-color 0.2s ease, border-color 0.2s ease;
    }

        /* Efecto hover sobre el rectángulo */
        .entrada-rectangulo:hover {
            transform: translateY(-2px);
            background: rgba(255, 255, 255, 0.08);
            border-color: rgba(0, 255, 208, 0.4);
        }

    /* 🖼️ Miniatura del póster (Izquierda) */
    .mini-poster {
        width: 100px;
        height: 100px;
        flex-shrink: 0;
        margin-right: 25px;
    }

        .mini-poster img {
            width: 100px;
            height: 100px;
            object-fit: cover;
            border-radius: 8px;
            border: 1px solid rgba(255, 255, 255, 0.2);
        }

    /* ℹ️ Zona central: Distribución de datos en columnas auto-ajustables */
    .info-compra-central {
        flex: 1;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 15px;
        align-items: center;
    }

        .info-compra-central h3 {
            margin: 0 0 5px 0;
            font-size: 18px;
            color: #4D4544;
            font-weight: bold;
        }

        .info-compra-central p {
            margin: 0;
        }

        .info-compra-central .organizador {
            font-size: 13px;
            color: #00ffd0;
        }

        .info-compra-central .detalle-gris {
            font-size: 14px;
            color: #cccccc;
        }

            .info-compra-central .detalle-gris p {
                margin-bottom: 4px;
            }

                .info-compra-central .detalle-gris p:last-child {
                    margin-bottom: 0;
                }

        .info-compra-central .precio-total {
            font-weight: bold;
            color: #242221;
            font-size: 16px;
        }

    /* 📥 BOTÓN DESCARGAR ENTRADA (Extremo Derecho) */
    .accion-derecha {
        flex-shrink: 0;
        margin-left: 25px;
    }

    .btn-descargar {
        display: inline-block;
        background-color: #00ffd0;
        color: #111111;
        padding: 12px 24px;
        text-decoration: none;
        border-radius: 8px;
        font-weight: bold;
        font-size: 14px;
        text-align: center;
        box-shadow: 0 4px 10px rgba(0, 255, 208, 0.2);
        transition: background-color 0.2s ease, transform 0.1s ease, box-shadow 0.2s ease;
    }

        .btn-descargar:hover {
            background-color: #00cca6;
            box-shadow: 0 6px 15px rgba(0, 255, 208, 0.4);
        }

        .btn-descargar:active {
            transform: scale(0.98);
        }

    /* Alertas de error */
    .alert-danger {
        background-color: rgba(220, 53, 69, 0.2);
        border: 1px solid #dc3545;
        color: #ea868f;
        padding: 15px;
        border-radius: 6px;
        margin-bottom: 20px;
    }

    /* Mensajes informativos de carga o vacío */
    .msg-info {
        text-align: center;
        color: #cccccc;
        font-size: 16px;
    }

    button.btn-descargar {
        border: none;
        font-family: inherit;
    }

    .btn-reporte-pendiente {
        opacity: 0.65;
        cursor: not-allowed;
    }
</style>
@page "/cliente/mis-entradas"

<div class="mis-entradas-page">

    <section class="bienvenida-cliente">
        <h1>Bienvenido Luis</h1>
        <a href="/solicitud-anfitrion" class="btn-anfitrion">Entrar como anfitrión</a>
    </section>

    <section class="entradas-section">
        <h2>TUS EVENTOS</h2>

        <div class="contenedor-carrusel">
            <button class="flecha">‹</button>

            <div class="entradas-grid">

                @foreach (EntradaCliente entrada in entradas)
                {
                    <div class="entrada-card">

                        <div class="poster @entrada.ClasePoster">
                            <div class="poster-contenido">
                                <h3>@entrada.TituloPoster</h3>
                                <p>@entrada.Subtitulo</p>
                            </div>
                        </div>

                        <div class="info-entrada">
                            <h3>@entrada.Titulo</h3>
                            <p class="autor">---------- @entrada.Autor</p>

                            <p><strong>Fecha:</strong> @entrada.Fecha</p>
                            <p><strong>Hora:</strong> @entrada.Hora</p>
                            <p><strong>Lugar:</strong> @entrada.Lugar</p>

                            <a href="@($"/cliente/descargar-entrada/{entrada.Id}")" class="btn-descargar">
                                Descarga tu entrada
                            </a>
                        </div>

                    </div>
                }

            </div>

            <button class="flecha">›</button>
        </div>

        <div class="puntos">
            <span></span>
            <span></span>
            <span></span>
            <span></span>
        </div>
    </section>

</div>

<style>
    .mis-entradas-page {
        min-height: 100vh;
        background: linear-gradient(180deg, #85e8f0 0%, #7de8ee 55%, #744cff 100%);
        font-family: Arial, Helvetica, sans-serif;
        color: #0c073d;
        padding-bottom: 60px;
    }

    .bienvenida-cliente {
        min-height: 210px;
        background: linear-gradient(rgba(12, 7, 61, 0.35), rgba(12, 7, 61, 0.55)), radial-gradient(circle at center, #4834ad 0%, #231160 55%, #0c073d 100%);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        text-align: center;
        padding: 40px 30px;
    }

        .bienvenida-cliente h1 {
            font-size: 64px;
            font-weight: bold;
            margin: 0;
        }

    .btn-anfitrion {
        position: absolute;
        top: 30px;
        right: 50px;
        color: white;
        border: 3px solid white;
        border-radius: 30px;
        padding: 12px 28px;
        text-decoration: none;
        font-weight: bold;
        text-transform: uppercase;
        font-size: 15px;
    }

        .btn-anfitrion:hover {
            background-color: white;
            color: #0c073d;
        }

    .entradas-section {
        padding: 50px 55px;
    }

        .entradas-section h2 {
            font-size: 58px;
            font-weight: bold;
            text-align: center;
            margin-bottom: 45px;
            letter-spacing: 4px;
            color: #0c2775;
        }

    .contenedor-carrusel {
        display: grid;
        grid-template-columns: 50px 1fr 50px;
        gap: 20px;
        align-items: center;
    }

    .flecha {
        width: 45px;
        height: 45px;
        border-radius: 50%;
        border: 2px solid #777;
        background-color: rgba(255, 255, 255, 0.75);
        color: #333;
        font-size: 35px;
        line-height: 35px;
        cursor: pointer;
    }

    .entradas-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 45px;
    }

    .entrada-card {
        display: grid;
        grid-template-rows: 260px auto;
        background-color: rgba(255, 255, 255, 0.25);
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 10px 22px rgba(0, 0, 0, 0.18);
    }

    .poster {
        border: 4px solid #111;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        text-align: center;
    }

    .poster-frio {
        background: linear-gradient(135deg, #111, #565656);
    }

    .poster-poemax {
        background: linear-gradient(135deg, #000, #1c1648);
    }

    .poster-teatro {
        background: linear-gradient(135deg, #21083f, #6931b8);
    }

    .poster-concierto {
        background: linear-gradient(135deg, #08213f, #1787b8);
    }

    .poster h3 {
        font-size: 46px;
        font-weight: bold;
        margin-bottom: 8px;
    }

    .poster p {
        font-size: 19px;
        margin: 0;
    }

    .info-entrada {
        padding: 24px 28px 30px 28px;
    }

        .info-entrada h3 {
            font-size: 28px;
            font-weight: bold;
            margin-bottom: 5px;
            color: #0c2775;
        }

    .autor {
        font-weight: bold;
        margin-bottom: 15px;
    }

    .info-entrada p {
        font-size: 17px;
        margin-bottom: 8px;
    }

    .btn-descargar {
        display: inline-block;
        margin-top: 18px;
        background-color: #13075c;
        color: white;
        text-decoration: none;
        padding: 14px 30px;
        border-radius: 28px;
        font-weight: bold;
        text-transform: uppercase;
    }

        .btn-descargar:hover {
            background-color: white;
            color: #13075c;
        }

    .puntos {
        display: flex;
        justify-content: center;
        gap: 9px;
        margin-top: 35px;
    }

        .puntos span {
            width: 18px;
            height: 18px;
            background-color: #100848;
            border-radius: 50%;
            display: block;
        }

    @@media (max-width: 900px) {
        .bienvenida-cliente h1 {
            font-size: 42px;
        }

        .btn-anfitrion {
            position: static;
            margin-left: 20px;
        }

        .bienvenida-cliente {
            flex-direction: column;
            gap: 20px;
        }

        .entradas-section {
            padding: 35px 25px;
        }

            .entradas-section h2 {
                font-size: 38px;
            }

        .contenedor-carrusel {
            grid-template-columns: 1fr;
        }

        .flecha {
            display: none;
        }

        .entradas-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

@code {
    private List<EntradaCliente> entradas = new List<EntradaCliente>
    {
        new EntradaCliente(
            1,
            "Nombre de un Evento muy Interesante",
            "FRÍOS",
            "1ra Temporada",
            "AUTOR 1",
            "15/03/2026",
            "8:00 pm",
            "Av. No sé 123, San Miguel",
            "poster-frio"
        ),

        new EntradaCliente(
            2,
            "Poemax",
            "POEMAX",
            "Stand-up comedy y poesía",
            "AUTOR 2",
            "07/05/2026",
            "10:30 pm",
            "Pasaje Porta 132, Miraflores",
            "poster-poemax"
        ),

        new EntradaCliente(
            3,
            "Obra de Teatro: Hamlet",
            "HAMLET",
            "Obra teatral",
            "AUTOR 3",
            "12/07/2026",
            "7:30 pm",
            "Teatro Municipal de Lima",
            "poster-teatro"
        ),

        new EntradaCliente(
            4,
            "Concierto Rock Nocturno",
            "ROCK",
            "Música en vivo",
            "AUTOR 4",
            "20/08/2026",
            "9:00 pm",
            "Av. La Marina 456, Pueblo Libre",
            "poster-concierto"
        )
    };

    private class EntradaCliente
    {
        public int Id { get; set; }
        public string Titulo { get; set; }
        public string TituloPoster { get; set; }
        public string Subtitulo { get; set; }
        public string Autor { get; set; }
        public string Fecha { get; set; }
        public string Hora { get; set; }
        public string Lugar { get; set; }
        public string ClasePoster { get; set; }

        public EntradaCliente(int id, string titulo, string tituloPoster, string subtitulo,
            string autor, string fecha, string hora, string lugar, string clasePoster)
        {
            Id = id;
            Titulo = titulo;
            TituloPoster = tituloPoster;
            Subtitulo = subtitulo;
            Autor = autor;
            Fecha = fecha;
            Hora = hora;
            Lugar = lugar;
            ClasePoster = clasePoster;
        }
    }
}
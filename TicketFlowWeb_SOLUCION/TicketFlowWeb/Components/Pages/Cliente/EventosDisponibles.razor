            "Nombre de un Evento muy Interesante",
            "FRÍOS",
            "1ra Temporada",
            "15/03/2026",
            "8:00 pm",
            "Av. No sé 123, San Miguel",
            "S/. 45.00",
            "evento-frio"
        ),

        new EventoCard(
            2,
            "Poemax",
            "POEMAX",
            "Stand-up comedy y poesía",
            "07/05/2026",
            "10:30 pm",
            "Pasaje Porta 132, Miraflores",
            "S/. 50.00",
            "evento-poemax"
        ),

        new EventoCard(
            3,
            "Obra de Teatro: Hamlet",
            "HAMLET",
            "Obra teatral",
            "12/07/2026",
            "7:30 pm",
            "Teatro Municipal de Lima",
            "S/. 90.00",
            "evento-teatro"
        ),

        new EventoCard(
            4,
            "Concierto Rock Nocturno",
            "ROCK",
            "Música en vivo",
            "20/08/2026",
            "9:00 pm",
            "Av. La Marina 456, Pueblo Libre",
            "S/. 75.00",
            "evento-concierto"
        )
    };

    private class EventoCard
    {
        public int Id { get; set; }
        public string Nombre { get; set; }
        public string TituloPoster { get; set; }
        public string Subtitulo { get; set; }
        public string Fecha { get; set; }
        public string Hora { get; set; }
        public string Lugar { get; set; }
        public string Precio { get; set; }
        public string ClaseImagen { get; set; }

        public EventoCard(int id, string nombre, string tituloPoster, string subtitulo,
            string fecha, string hora, string lugar, string precio, string claseImagen)
        {
            Id = id;
            Nombre = nombre;
            TituloPoster = tituloPoster;
            Subtitulo = subtitulo;
            Fecha = fecha;
            Hora = hora;
            Lugar = lugar;
            Precio = precio;
            ClaseImagen = claseImagen;
        }
    }
}
@page "/cliente/eventos"

<div class="eventos-cliente-page">

    <section class="encabezado-eventos">
        <h1>Eventos</h1>
        <p>Descubre los próximos eventos disponibles en TicketFlow</p>
    </section>

    <section class="contenedor-eventos">

        @foreach (EventoCard evento in eventos)
        {
            <div class="evento-card">
                <div class="evento-imagen @evento.ClaseImagen">
                    <div>
                        <h2>@evento.TituloPoster</h2>
                        <p>@evento.Subtitulo</p>
                    </div>
                </div>

                <div class="evento-info">
                    <h2>@evento.Nombre</h2>

                    <p><strong>Fecha:</strong> @evento.Fecha</p>
                    <p><strong>Hora:</strong> @evento.Hora</p>
                    <p><strong>Lugar:</strong> @evento.Lugar</p>
                    <p><strong>Precio:</strong> @evento.Precio</p>

                    <a href="@($"/cliente/detalle-evento/{evento.Id}")" class="btn-ver-detalle">
                        Ver detalle
                    </a>
                </div>
            </div>
        }

    </section>

</div>

<style>
    .eventos-cliente-page {
        min-height: 100vh;
        background: linear-gradient(180deg, #71dce8 0%, #8bf0f3 45%, #dffcff 100%);
        font-family: Arial, Helvetica, sans-serif;
        color: #0c073d;
        padding-bottom: 50px;
    }

    .encabezado-eventos {
        background: linear-gradient(rgba(12, 7, 61, 0.60), rgba(12, 7, 61, 0.60)), radial-gradient(circle at center, #4231a3 0%, #1b115f 55%, #0c073d 100%);
        color: white;
        padding: 55px 70px;
    }

        .encabezado-eventos h1 {
            font-size: 58px;
            font-weight: bold;
            margin-bottom: 10px;
        }

        .encabezado-eventos p {
            font-size: 20px;
            margin: 0;
        }

    .contenedor-eventos {
        padding: 45px 70px;
        display: flex;
        flex-direction: column;
        gap: 45px;
    }

    .evento-card {
        display: grid;
        grid-template-columns: 420px 1fr;
        gap: 40px;
        align-items: center;
        background: rgba(255, 255, 255, 0.35);
        border-radius: 18px;
        padding: 28px;
        box-shadow: 0 8px 18px rgba(0, 0, 0, 0.18);
    }

    .evento-imagen {
        height: 240px;
        border: 5px solid #111;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        text-align: center;
        border-radius: 4px;
    }

        .evento-imagen h2 {
            font-size: 42px;
            font-weight: bold;
            margin-bottom: 8px;
        }

        .evento-imagen p {
            font-size: 18px;
            margin: 0;
        }

    .evento-frio {
        background: linear-gradient(135deg, #111, #5b5b5b);
    }

    .evento-poemax {
        background: linear-gradient(135deg, #000, #2b205d);
    }

    .evento-teatro {
        background: linear-gradient(135deg, #190b46, #6949c8);
    }

    .evento-concierto {
        background: linear-gradient(135deg, #08213f, #1787b8);
    }

    .evento-info h2 {
        font-size: 42px;
        font-weight: bold;
        margin-bottom: 25px;
        color: #0c2775;
    }

    .evento-info p {
        font-size: 18px;
        margin-bottom: 8px;
    }

    .btn-ver-detalle {
        display: inline-block;
        margin-top: 20px;
        background-color: #13075c;
        color: white;
        text-decoration: none;
        padding: 13px 32px;
        border-radius: 25px;
        font-weight: bold;
        border: 2px solid #13075c;
    }

        .btn-ver-detalle:hover {
            background-color: white;
            color: #13075c;
        }

    @@media (max-width: 900px) {
        .encabezado-eventos {
            padding: 40px 30px;
        }

            .encabezado-eventos h1 {
                font-size: 42px;
            }

        .contenedor-eventos {
            padding: 35px 25px;
        }

        .evento-card {
            grid-template-columns: 1fr;
        }

        .evento-info h2 {
            font-size: 32px;
        }
    }
</style>

@code {
    private List<EventoCard> eventos = new List<EventoCard>
    {
        new EventoCard(

        background-color: #110846;
        color: white;
        display: grid;
        grid-template-columns: 1.3fr 0.7fr;
        gap: 35px;
        padding: 50px 60px;
    }

        .conocenos-section h2 {
            color: white;
        }

    .conocenos-texto p {
        font-size: 18px;
        line-height: 1.6;
    }

    .conocenos-imagen {
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .cuadro-red {

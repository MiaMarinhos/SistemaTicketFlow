        color: #09082d;
    }

    .hero-cliente {
        min-height: 320px;
        background: linear-gradient(rgba(14, 7, 60, 0.35), rgba(14, 7, 60, 0.65)), radial-gradient(circle at center, #5141bd 0%, #26136f 50%, #0c073d 100%);

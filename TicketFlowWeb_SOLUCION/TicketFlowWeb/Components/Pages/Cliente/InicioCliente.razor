        padding: 45px 60px;
    }

        .shows-section h2,
        .testimonios-section h2,
        .conocenos-section h2 {
            font-size: 42px;
            font-weight: bold;
            letter-spacing: 8px;
            margin-bottom: 35px;
            color: #0b0b3d;
        }

    .shows-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 35px;
    }

    .show-card {
        display: grid;
        grid-template-columns: 1fr 1fr;
        background-color: rgba(255, 255, 255, 0.35);
        border: 3px solid #111;
        min-height: 280px;
    }

    .show-img {
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 36px;
        font-weight: bold;
        text-align: center;
    }

    .show-img-uno {
        background: linear-gradient(135deg, #111, #555);
    }

    .show-img-dos {
        background: linear-gradient(135deg, #000, #2d235c);

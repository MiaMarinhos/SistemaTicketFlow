            height: 18px;
            background-color: #110846;
            border-radius: 50%;
            display: block;
        }

    .testimonios-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 28px 60px;
    }

    .testimonio {
        display: flex;
        align-items: center;
        gap: 18px;
    }

    .avatar {
        width: 70px;
        height: 70px;
        background-color: #eeeeee;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #12075a;
        font-size: 28px;
        font-weight: bold;
        flex-shrink: 0;
    }

    .globo {

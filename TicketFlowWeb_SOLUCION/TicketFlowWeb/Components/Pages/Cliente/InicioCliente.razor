        min-height: 230px;
        border: 2px solid #78f3ff;
        border-radius: 20px;
        padding: 25px;
        text-align: center;
        box-shadow: 0 0 25px rgba(120, 243, 255, 0.5);
    }

        .cuadro-red h3 {
            font-size: 30px;
            color: #78f3ff;
            margin-bottom: 20px;
        }

        .cuadro-red span {
            display: inline-block;
            border: 1px solid #78f3ff;
            border-radius: 20px;
            padding: 8px 15px;
            margin: 8px;
        }


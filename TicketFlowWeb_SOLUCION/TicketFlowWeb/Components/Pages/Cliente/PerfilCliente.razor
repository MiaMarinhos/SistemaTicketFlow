@page "/cliente/perfil"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "CLIENTE")]
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using System.Security.Claims
@using TicketFlowWeb.Models
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject TicketFlowWeb.Services.UsuarioRS.UsuarioRestService UsuarioService
@inject NavigationManager Navigation

<div class="perfil-cliente-page">

    <aside class="sidebar-cliente">
        <div class="usuario-box">
            <div class="avatar-cliente">
                👤
            </div>

            <div class="usuario-info">
                <h3>@nombreCliente</h3>
                <p>Cliente</p>
            </div>
        </div>

        <hr />

        <nav class="menu-cliente">
            <a href="/cliente/perfil" class="menu-item activo">
                <span>👤</span>
                Mi Perfil
            </a>

            <a href="/public/descubrir" class="menu-item">
                <span>🎭</span>
                Eventos
            </a>

            <a href="/cliente/mis-entradas" class="menu-item">
                <span>🎟️</span>
                Mis Entradas
            </a>

            <a href="/auth/logout" class="menu-item logout">
                <span>↩</span>
                LogOut
            </a>
        </nav>
    </aside>

    <main class="contenido-perfil">

        <section class="titulo-section">
            <h1>Mi Perfil</h1>
        </section>

        <section class="tarjeta-perfil">

            @if (cargando)
            {
                <p>Cargando perfil...</p>
            }
            else if (!string.IsNullOrWhiteSpace(mensajeError))
            {
                <div class="alert alert-warning">@mensajeError</div>
            }
            else if (perfilCliente is not null)
            {
                @if (!string.IsNullOrWhiteSpace(mensajeExito))
                {
                    <div class="alert alert-success">@mensajeExito</div>
                }

                @if (!editando)
                {
                    <div class="tabla-perfil">

                        <div class="fila-perfil">
                            <div class="campo">CÓDIGO:</div>
                            <div class="valor">@($"CL-{perfilCliente.idUsuario:D4}")</div>
                        </div>

                        <div class="fila-perfil">
                            <div class="campo">NOMBRE:</div>
                            <div class="valor">@Mostrar(perfilCliente.nombre)</div>
                        </div>

                        <div class="fila-perfil">
                            <div class="campo">APELLIDO PATERNO:</div>
                            <div class="valor">@Mostrar(perfilCliente.apellidoPaterno)</div>
                        </div>

                        <div class="fila-perfil">
                            <div class="campo">APELLIDO MATERNO:</div>
                            <div class="valor">@Mostrar(perfilCliente.apellidoMaterno)</div>
                        </div>

                        <div class="fila-perfil">
                            <div class="campo">DNI:</div>
                            <div class="valor">@Mostrar(perfilCliente.dni)</div>
                        </div>

                        <div class="fila-perfil">
                            <div class="campo">CORREO:</div>
                            <div class="valor">@Mostrar(perfilCliente.correoElectronico)</div>
                        </div>

                        <div class="fila-perfil">
                            <div class="campo">TELÉFONO:</div>
                            <div class="valor">@Mostrar(perfilCliente.telefono)</div>
                        </div>

                        <div class="fila-perfil">
                            <div class="campo">EDAD:</div>
                            <div class="valor">@perfilCliente.edad</div>
                        </div>

                        <div class="fila-perfil">
                            <div class="campo">PREFERENCIA / DISTRITO:</div>
                            <div class="valor">@ObtenerNombreDistrito(perfilCliente.idDistrito)</div>
                        </div>

                        <div class="fila-perfil">
                            <div class="campo">PUNTOS BONUS:</div>
                            <div class="valor puntos">@perfilCliente.puntosBonus puntos</div>
                        </div>

                    </div>

                    <div class="acciones-perfil">
                        <button type="button" class="btn-perfil secundario" @onclick="ActivarEdicion">
                            Editar perfil
                        </button>

                        <a href="/cliente/mis-entradas" class="btn-perfil secundario">
                            Ver mis entradas
                        </a>

                        <a href="/public/descubrir" class="btn-perfil principal">
                            Descubrir eventos
                        </a>
                    </div>
                }
                else
                {
                    <EditForm Model="@editModel" OnValidSubmit="GuardarPerfil">
                        <DataAnnotationsValidator />

                        <div class="tabla-perfil">

                            <div class="fila-perfil">
                                <div class="campo">CÓDIGO:</div>
                                <div class="valor">@($"CL-{editModel.idUsuario:D4}")</div>
                            </div>

                            <div class="fila-perfil">
                                <div class="campo">NOMBRE:</div>
                                <div class="valor">
                                    <InputText class="form-control" @bind-Value="editModel.nombre" />
                                </div>
                            </div>

                            <div class="fila-perfil">
                                <div class="campo">APELLIDO PATERNO:</div>
                                <div class="valor">
                                    <InputText class="form-control" @bind-Value="editModel.apellidoPaterno" />
                                </div>
                            </div>

                            <div class="fila-perfil">
                                <div class="campo">APELLIDO MATERNO:</div>
                                <div class="valor">
                                    <InputText class="form-control" @bind-Value="editModel.apellidoMaterno" />
                                </div>
                            </div>

                            <div class="fila-perfil">
                                <div class="campo">DNI:</div>
                                <div class="valor">
                                    <InputText class="form-control" @bind-Value="editModel.dni" />
                                </div>
                            </div>

                            <div class="fila-perfil">
                                <div class="campo">CORREO:</div>
                                <div class="valor">
                                    <InputText class="form-control" @bind-Value="editModel.correoElectronico" />
                                </div>
                            </div>

                            <div class="fila-perfil">
                                <div class="campo">TELÉFONO:</div>
                                <div class="valor">
                                    <InputText class="form-control" @bind-Value="editModel.telefono" />
                                </div>
                            </div>

                            <div class="fila-perfil">
                                <div class="campo">EDAD:</div>
                                <div class="valor">
                                    <InputNumber class="form-control" @bind-Value="editModel.edad" />
                                </div>
                            </div>

                            <div class="fila-perfil">
                                <div class="campo">PREFERENCIA / DISTRITO:</div>
                                <div class="valor">
                                    <InputSelect class="form-control" @bind-Value="editModel.idDistrito">
                                        @foreach (var distrito in distritos)
                                        {
                                            <option value="@distrito.idDistrito">@distrito.nombre</option>
                                        }
                                    </InputSelect>
                                </div>
                            </div>

                            <div class="fila-perfil">
                                <div class="campo">PUNTOS BONUS:</div>
                                <div class="valor puntos">
                                    @perfilCliente.puntosBonus puntos
                                    <small class="nota-puntos">Los puntos bonus no se editan manualmente.</small>
                                </div>
                            </div>

                        </div>

                        <div class="acciones-perfil">
                            <button type="submit" class="btn-perfil principal" disabled="@guardando">
                                @(guardando ? "Guardando..." : "Guardar cambios")
                            </button>

                            <button type="button" class="btn-perfil secundario" @onclick="CancelarEdicion">
                                Cancelar
                            </button>
                        </div>
                    </EditForm>
                }
            }

        </section>

    </main>

</div>

@code {
    private string nombreCliente = "Cliente";
    private ClientePerfilViewModel? perfilCliente;
    private ClientePerfilViewModel editModel = new();

    private List<Distrito> distritos = new();

    private bool cargando = true;
    private bool editando = false;
    private bool guardando = false;

    private string? mensajeError;
    private string? mensajeExito;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var usuario = authState.User;

            if (usuario.Identity?.IsAuthenticated != true)
            {
                Navigation.NavigateTo("/login", forceLoad: true);
                return;
            }

            nombreCliente = usuario.FindFirst("Nombres")?.Value ?? "Cliente";

            var idTexto = usuario.FindFirst(ClaimTypes.NameIdentifier)?.Value;
            if (!int.TryParse(idTexto, out var idUsuario))
            {
                mensajeError = "No se encontró el ID del usuario en la sesión. Vuelve a iniciar sesión.";
                return;
            }

            distritos = await UsuarioService.ObtenerDistritosAsync();

            perfilCliente = await UsuarioService.ObtenerPerfilClienteAsync(idUsuario);

            if (perfilCliente is null)
            {
                mensajeError = "No se pudo cargar el perfil desde el backend.";
                return;
            }

            if (perfilCliente.idDistrito <= 0 && distritos.Count > 0)
            {
                perfilCliente.idDistrito = distritos[0].idDistrito;
            }

            if (perfilCliente.genero is null)
            {
                perfilCliente.genero = new Genero { idGenero = 1 };
            }

            nombreCliente = Mostrar(perfilCliente.nombre, "Cliente");
        }
        catch (Exception ex)
        {
            mensajeError = $"Error cargando el perfil: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private void ActivarEdicion()
    {
        if (perfilCliente is null)
        {
            return;
        }

        mensajeError = null;
        mensajeExito = null;

        editModel = CopiarPerfil(perfilCliente);

        if (editModel.idDistrito <= 0 && distritos.Count > 0)
        {
            editModel.idDistrito = distritos[0].idDistrito;
        }

        if (editModel.genero is null)
        {
            editModel.genero = new Genero { idGenero = 1 };
        }

        editando = true;
    }

    private void CancelarEdicion()
    {
        editando = false;
        mensajeError = null;
        mensajeExito = null;
    }

    private async Task GuardarPerfil()
    {
        if (perfilCliente is null)
        {
            return;
        }

        try
        {
            guardando = true;
            mensajeError = null;
            mensajeExito = null;

            if (string.IsNullOrWhiteSpace(editModel.nombre) ||
                string.IsNullOrWhiteSpace(editModel.apellidoPaterno) ||
                string.IsNullOrWhiteSpace(editModel.apellidoMaterno) ||
                string.IsNullOrWhiteSpace(editModel.dni) ||
                string.IsNullOrWhiteSpace(editModel.correoElectronico) ||
                string.IsNullOrWhiteSpace(editModel.telefono))
            {
                mensajeError = "Completa todos los campos obligatorios.";
                return;
            }

            if (editModel.edad <= 0)
            {
                mensajeError = "La edad debe ser mayor a 0.";
                return;
            }

            var ok = await UsuarioService.ActualizarPerfilClienteAsync(editModel.idUsuario, editModel);

            if (!ok)
            {
                mensajeError = "No se pudo actualizar el perfil en el backend.";
                return;
            }

            var actualizado = await UsuarioService.ObtenerPerfilClienteAsync(editModel.idUsuario);

            if (actualizado is not null)
            {
                if (actualizado.idDistrito <= 0)
                {
                    actualizado.idDistrito = editModel.idDistrito;
                }

                perfilCliente = actualizado;
                nombreCliente = Mostrar(perfilCliente.nombre, "Cliente");
            }

            editando = false;
            mensajeExito = "Perfil actualizado correctamente.";
        }
        catch (Exception ex)
        {
            mensajeError = $"Error actualizando perfil: {ex.Message}";
        }
        finally
        {
            guardando = false;
        }
    }

    private static ClientePerfilViewModel CopiarPerfil(ClientePerfilViewModel c)
    {
        return new ClientePerfilViewModel
        {
            idUsuario = c.idUsuario,
            dni = c.dni,
            nombre = c.nombre,
            apellidoPaterno = c.apellidoPaterno,
            apellidoMaterno = c.apellidoMaterno,
            telefono = c.telefono,
            edad = c.edad,
            correoElectronico = c.correoElectronico,
            contrasena = c.contrasena,
            idDistrito = c.idDistrito,
            puntosBonus = c.puntosBonus,
            genero = c.genero is null
                ? new Genero { idGenero = 1 }
                : new Genero { idGenero = c.genero.idGenero, nombre = c.genero.nombre }
        };
    }

    private string ObtenerNombreDistrito(int idDistrito)
    {
        var distrito = distritos.FirstOrDefault(d => d.idDistrito == idDistrito);
        return distrito is null ? "No definido" : distrito.nombre;
    }

    private static string Mostrar(string? valor, string defecto = "-")
    {
        return string.IsNullOrWhiteSpace(valor) ? defecto : valor;
    }
}

<style>
    .perfil-cliente-page {
        min-height: 100vh;
        display: grid;
        grid-template-columns: 260px 1fr;
        background-color: #f2edff;
        font-family: Arial, Helvetica, sans-serif;
        color: #110846;
    }

    .sidebar-cliente {
        background-color: #15095f;
        color: white;
        padding: 45px 28px;
        display: flex;
        flex-direction: column;
        min-height: 100vh;
    }

    .usuario-box {
        display: flex;
        align-items: center;
        gap: 18px;
        margin-bottom: 28px;
    }

    .avatar-cliente {
        width: 70px;
        height: 70px;
        background-color: white;
        color: #15095f;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 42px;
        flex-shrink: 0;
    }

    .usuario-info h3 {
        margin: 0;
        font-size: 22px;
        font-weight: bold;
    }

    .usuario-info p {
        margin: 5px 0 0 0;
        font-size: 15px;
        opacity: 0.9;
    }

    .sidebar-cliente hr {
        border: none;
        border-top: 3px solid white;
        margin: 0 0 35px 0;
    }

    .menu-cliente {
        display: flex;
        flex-direction: column;
        gap: 12px;
        flex: 1;
    }

    .menu-item {
        display: flex;
        align-items: center;
        gap: 12px;
        color: white;
        text-decoration: none;
        padding: 14px 12px;
        border-radius: 12px;
        font-size: 17px;
        transition: 0.2s;
    }

        .menu-item:hover,
        .menu-item.activo {
            background-color: rgba(255, 255, 255, 0.15);
        }

        .menu-item span {
            width: 26px;
            text-align: center;
        }

    .logout {
        margin-top: auto;
    }

    .contenido-perfil {
        padding: 55px 65px;
    }

    .titulo-section {
        background-color: white;
        padding: 35px 42px;
        margin-bottom: 25px;
    }

        .titulo-section h1 {
            margin: 0;
            font-size: 42px;
            font-weight: bold;
            letter-spacing: 4px;
            color: #15095f;
        }

    .tarjeta-perfil {
        background-color: white;
        padding: 55px 50px;
        min-height: 520px;
    }

    .tabla-perfil {
        max-width: 760px;
        border: 1px solid #f0edf5;
    }

    .fila-perfil {
        display: grid;
        grid-template-columns: 300px 1fr;
        min-height: 68px;
        border-bottom: 1px solid #f0edf5;
    }

        .fila-perfil:last-child {
            border-bottom: none;
        }

    .campo,
    .valor {
        display: flex;
        align-items: center;
        padding: 0 22px;
        font-size: 17px;
    }


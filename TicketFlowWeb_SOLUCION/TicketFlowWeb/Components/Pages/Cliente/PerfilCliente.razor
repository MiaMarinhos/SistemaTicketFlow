        align-items: flex-start;
        justify-content: center;
    }

    .nota-puntos {
        margin-top: 4px;
        font-size: 12px;
        color: #777;
        font-weight: normal;
    }

    .acciones-perfil {
        display: flex;
        gap: 20px;
        margin-top: 35px;
        max-width: 760px;
        justify-content: flex-end;
    }

    .btn-perfil {
        text-decoration: none;
        padding: 14px 30px;
        border-radius: 28px;
        font-size: 17px;

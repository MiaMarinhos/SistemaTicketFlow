@page "/cliente/descargar-entrada/{Id:int}"
@using Microsoft.AspNetCore.Components
@using System.Collections.Generic

<div class="descargar-entrada-page">

    <div class="entrada-contenedor">

        <div class="poster-evento @evento.ClasePoster">
            <div class="poster-contenido">
                <p class="poster-fecha">@evento.FechaPoster</p>
                <h2>@evento.TituloPoster</h2>
                <p>@evento.SubtituloPoster</p>
                <p class="poster-lugar">@evento.Ubicacion</p>
            </div>
        </div>

        <div class="panel-entrada">
            <h1>DESCARGA TU ENTRADA</h1>

            <h2>@evento.Titulo</h2>

            <div class="mensaje">
                <h3>¡TE ESPERAMOS!</h3>
                <p>Tu compra fue registrada correctamente.</p>
            </div>

            <div class="datos-entrada">

                <div class="fila-dato">
                    <label>Fecha</label>
                    <span>@evento.Fecha</span>
                </div>

                <div class="fila-dato">
                    <label>Ubicación</label>
                    <span>@evento.Ubicacion</span>
                </div>

                <div class="fila-dato">
                    <label>Fecha Compra</label>
                    <span>01/06/2026</span>
                </div>

                <div class="fila-dato">
                    <label>Código</label>
                    <span>@evento.CodigoCompra</span>
                </div>

                <div class="fila-dato">
                    <label>N° Entradas</label>
                    <span>1</span>
                </div>

            </div>

            <div class="acciones">
                <a href="/cliente/eventos" class="btn-secundario">Ver más eventos</a>
                <a href="#" class="btn-descargar">Descargar entrada</a>
            </div>
        </div>

    </div>

</div>

<style>
    .descargar-entrada-page {
        min-height: 100vh;
        background: linear-gradient(90deg, #05051f 0%, #1d1270 45%, #3928d8 100%);
        font-family: Arial, Helvetica, sans-serif;
        color: white;
        padding: 60px 70px;
    }

    .entrada-contenedor {
        display: grid;
        grid-template-columns: 420px 1fr;
        gap: 60px;
        align-items: center;
        max-width: 1200px;
        margin: 0 auto;
    }

    .poster-evento {
        height: 600px;
        border: 4px solid #111;
        box-shadow: 0 12px 28px rgba(0, 0, 0, 0.45);
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
    }

    .poster-frio {
        background: linear-gradient(135deg, #111111, #4a4a4a);
    }

    .poster-poemax {
        background: linear-gradient(135deg, #000000, #1c1648);
    }

    .poster-teatro {
        background: linear-gradient(135deg, #21083f, #6931b8);
    }

    .poster-concierto {
        background: linear-gradient(135deg, #08213f, #1787b8);
    }

    .poster-contenido {
        padding: 30px;
    }

    .poster-fecha {
        font-size: 18px;
        letter-spacing: 3px;
        margin-bottom: 35px;
    }

    .poster-evento h2 {
        font-size: 62px;
        font-weight: bold;
        margin-bottom: 15px;
    }

    .poster-evento p {
        font-size: 20px;
    }

    .poster-lugar {
        margin-top: 170px;
        font-size: 17px;
        letter-spacing: 2px;
    }

    .panel-entrada h1 {
        font-size: 46px;
        font-weight: bold;
        margin-bottom: 25px;
    }

    .panel-entrada h2 {
        font-size: 58px;
        font-weight: bold;
        margin-bottom: 25px;
    }

    .mensaje {
        border: 3px solid white;
        border-radius: 20px;
        padding: 25px;
        margin-bottom: 30px;
        max-width: 700px;
    }

        .mensaje h3 {
            font-size: 32px;
            font-weight: bold;
            margin-bottom: 10px;
        }

        .mensaje p {
            font-size: 20px;
            margin: 0;
        }

    .datos-entrada {
        display: flex;
        flex-direction: column;
        gap: 16px;
        max-width: 700px;
    }

    .fila-dato {
        display: grid;
        grid-template-columns: 180px 1fr;
        gap: 15px;
        align-items: center;
    }

        .fila-dato label {
            border: 2px solid white;
            border-radius: 8px;
            padding: 14px;
            font-size: 18px;
            font-weight: bold;
        }

        .fila-dato span {
            border: 2px solid white;
            border-radius: 8px;
            padding: 14px;
            font-size: 18px;
        }

    .acciones {
        display: flex;
        justify-content: flex-end;
        gap: 20px;
        max-width: 700px;
        margin-top: 35px;
    }

    .btn-secundario,
    .btn-descargar {
        display: inline-block;
        text-decoration: none;
        border-radius: 30px;
        padding: 15px 36px;
        font-size: 18px;
        font-weight: bold;
    }

    .btn-secundario {
        color: white;
        border: 3px solid white;
    }

    .btn-descargar {
        color: #160b62;
        background-color: white;
        border: 3px solid white;
    }

    .btn-secundario:hover {
        background-color: white;
        color: #160b62;
    }

    .btn-descargar:hover {
        background-color: #dffcff;
        color: #160b62;
    }

    @@media (max-width: 900px) {
        .descargar-entrada-page {
            padding: 35px 25px;
        }

        .entrada-contenedor {
            grid-template-columns: 1fr;
            gap: 35px;
        }

        .poster-evento {
            height: 420px;
        }

        .poster-lugar {
            margin-top: 100px;
        }

        .panel-entrada h1 {
            font-size: 32px;
        }

        .panel-entrada h2 {
            font-size: 42px;
        }

        .fila-dato {
            grid-template-columns: 1fr;
        }

        .acciones {
            flex-direction: column;
        }

        .btn-secundario,
        .btn-descargar {
            text-align: center;
        }
    }
</style>

@code {
    [Parameter]
    public int Id { get; set; }

    private EventoEntrada evento = new EventoEntrada(
        1,
        "Nombre de un Evento muy Interesante",
        "FRÍOS",
        "1ra Temporada",
        "15 MARZO   8:00 PM",
        "Av. No sé 123, San Miguel",
        "15/03/2026 - 8:00 a 10:00 pm",
        "TF-001234",
        "poster-frio"
    );

    private List<EventoEntrada> eventos = new List<EventoEntrada>
    {
        new EventoEntrada(
            1,
            "Nombre de un Evento muy Interesante",
            "FRÍOS",
            "1ra Temporada",
            "15 MARZO   8:00 PM",
            "Av. No sé 123, San Miguel",
            "15/03/2026 - 8:00 a 10:00 pm",
            "TF-001234",
            "poster-frio"
        ),

        new EventoEntrada(
            2,
            "Poemax",
            "POEMAX",
            "Stand-up comedy y poesía",
            "07 MAYO   10:30 PM",
            "Pasaje Porta 132, Miraflores",
            "07/05/2026 - 10:30 a 11:30 pm",
            "TF-002345",
            "poster-poemax"
        ),

        new EventoEntrada(
            3,
            "Obra de Teatro: Hamlet",
            "HAMLET",
            "Obra teatral",
            "12 JULIO   7:30 PM",
            "Teatro Municipal de Lima",
            "12/07/2026 - 7:30 a 9:30 pm",
            "TF-003456",
            "poster-teatro"
        ),

        new EventoEntrada(
            4,
            "Concierto Rock Nocturno",
            "ROCK",
            "Música en vivo",
            "20 AGOSTO   9:00 PM",
            "Av. La Marina 456, Pueblo Libre",
            "20/08/2026 - 9:00 a 11:00 pm",
            "TF-004567",
            "poster-concierto"
        )
    };

    protected override void OnParametersSet()
    {
        evento = ObtenerEvento(Id);
    }

    private EventoEntrada ObtenerEvento(int id)
    {
        foreach (EventoEntrada item in eventos)
        {
            if (item.Id == id)
            {
                return item;
            }
        }

        return eventos[0];
    }

    private class EventoEntrada
    {
        public int Id { get; set; }
        public string Titulo { get; set; }
        public string TituloPoster { get; set; }
        public string SubtituloPoster { get; set; }
        public string FechaPoster { get; set; }
        public string Ubicacion { get; set; }
        public string Fecha { get; set; }
        public string CodigoCompra { get; set; }
        public string ClasePoster { get; set; }

        public EventoEntrada(int id, string titulo, string tituloPoster, string subtituloPoster,
            string fechaPoster, string ubicacion, string fecha, string codigoCompra, string clasePoster)
        {
            Id = id;
            Titulo = titulo;
            TituloPoster = tituloPoster;
            SubtituloPoster = subtituloPoster;
            FechaPoster = fechaPoster;
            Ubicacion = ubicacion;
            Fecha = fecha;
            CodigoCompra = codigoCompra;
            ClasePoster = clasePoster;
        }
    }
}
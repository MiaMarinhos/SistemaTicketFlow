@page "/cliente/confirmar-pago/{idClienteLogueado:int}/{Id:int}/{Cantidad:int}/{IdBonus:int}/{Subtotal:decimal}/{Total:decimal}"

@using Microsoft.AspNetCore.Components
@using TicketFlowWeb.Models
@using TicketFlowWeb.Services.EventoRS
@using TicketFlowWeb.Services.CompraRS
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize]

@inject EventoRestService EventoService 
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject CompraRestService CompraService
@inject IJSRuntime JS

<div class="confirmar-pago-page">

    @if (eventoReal == null)
    {
        <div class="loading-container" style="text-align: center; padding: 50px;">
            <p>Cargando información del pago seguro...</p>
        </div>
    }
    else
    {
        <div class="confirmar-contenedor">

            <div class="resumen-contenedor">
                <img src="@eventoReal.img" alt="Portada del Evento" class="poster-contenido" style="width: 100%; border-radius: 8px; box-shadow: 0 12px 28px rgba(0, 0, 0, 0.45);" />
            </div>

            <div class="panel-pago">
                <h1>@eventoReal.titulo</h1>

                <div class="resumen-box">
                    <h2>Resumen de Pago</h2>

                    <div class="fila-dato">
                        <label>Cantidad:</label>
                        <span>@Cantidad entradas</span>
                    </div>

                    <div class="fila-dato">
                        <label>Precio Unitario:</label>
                        <span>S/. @(eventoReal.precio.ToString("0.00") ?? "0.00")</span>
                    </div>

                    <div class="fila-dato">
                        <label>Subtotal:</label>
                        <span>S/. @Subtotal.ToString("0.00")</span>
                    </div>

                    <div class="fila-dato">
                        <label>Descuento aplicado:</label>
                        <span>S/. @DescuentoCalculado.ToString("0.00")</span>
                    </div>

                    <div class="fila-dato total">
                        <label>Total a pagar:</label>
                        <span>S/. @Total.ToString("0.00")</span>
                    </div>
                </div>

                <div class="contenedor-flex-pagos" style="display: flex; gap: 40px; align-items: flex-start; max-width: 700px; margin-bottom: 30px;">

                    @* LADO IZQUIERDO: Las opciones de los métodos *@
                    <div class="metodos-box" style="flex: 1; margin-bottom: 0;">
                        <h2>Método de pago:</h2>

                        <div class="opciones-pago">
                            <div class="opcion-pago">
                                <input type="radio"
                                       name="metodoPago"
                                       checked="@(metodoPago == "Yape")"
                                       @onchange="@(() => SeleccionarMetodo("Yape"))" />
                                <span>Yape</span>
                            </div>

                            <div class="opcion-pago">
                                <input type="radio"
                                       name="metodoPago"
                                       checked="@(metodoPago == "Plin")"
                                       @onchange="@(() => SeleccionarMetodo("Plin"))" />
                                <span>Plin (Próximamente)</span>
                            </div>

                            <div class="opcion-pago">
                                <input type="radio"
                                       name="metodoPago"
                                       checked="@(metodoPago == "BCP")"
                                       @onchange="@(() => SeleccionarMetodo("BCP"))" />
                                <span>BCP (Próximamente)</span>
                            </div>
                        </div>
                    </div>

                    @* LADO DERECHO: El QR dinámico de Yape *@
                    @if (metodoPago == "Yape")
                    {
                        <div class="contenedor-qr" style="background: rgba(255, 255, 255, 0.1); border: 2px dashed #00ffd0; padding: 20px; border-radius: 12px; text-align: center; width: 280px; flex-shrink: 0;">
                            <h4 style="color: #00ffd0; font-weight: bold; margin-bottom: 10px; font-size: 16px;">¡Escanea y Yapea!</h4>
                            <p style="font-size: 13px; margin-bottom: 12px;">Monto: <strong>S/. @Total.ToString("0.00")</strong></p>

                            <img src="@urlQrYape" alt="Código QR Yape" style="width: 160px; height: 160px; border-radius: 8px; background: white; padding: 8px;" />

                            <p style="font-size: 11px; margin-top: 10px; color: #ccc;">Una vez realizado el depósito, presione "Confirmar Pago".</p>
                        </div>
                    }
                </div>

                <div class="acciones">
                    @* Volver te regresa a la pasarela de compra manteniendo el ID *@
                    <a href="@($"/cliente/compra/{Id}")" class="btn-volver">
                        Volver
                    </a>

                    @* Botón de confirmación ejecuta método en C# para registrar en BD antes de ir a descargar *@
                    <button type="button" @onclick="ProcesarRegistroCompra" class="btn-confirmar" style="cursor: pointer;">
                        Confirmar pago
                    </button>
                </div>

            </div>
        </div>
    }
</div>

@code {

    [Parameter] public int Id { get; set; }
    [Parameter] public int Cantidad { get; set; }
    [Parameter] public int IdBonus { get; set; }
    [Parameter] public decimal Subtotal { get; set; }
    [Parameter] public decimal Total { get; set; }
    [Parameter] public int idClienteLogueado { get; set; }

    private string metodoPago = "Yape"; // Por defecto inicializa en Yape
    private EventoViewModel? eventoReal;

    private string urlQrYape = "https://lh3.googleusercontent.com/d/1QHJXW8xyDvfFp9IfAmseD0sOyq7V2ssl";

    private decimal DescuentoCalculado => Subtotal - Total;

    protected override async Task OnParametersSetAsync()
    {
        eventoReal = await EventoService.verDetalleEventoAsync(Id);

    }

    private void SeleccionarMetodo(string metodo)
    {
        metodoPago = metodo;
    }

    private async Task ProcesarRegistroCompra()
    {
        var nuevaCompraReq = new Models.COMPRA.RegistroCompraVM
        {
            idCliente = idClienteLogueado,
            idEvento = Id,
            entradasCompradas = Cantidad,
            idpuntoBonus = IdBonus,
            montoParcial = (double)Subtotal,
            montoTotal = (double)Total,
            metodoPago = metodoPago
        };

        try
        {
            // Ejecutamos el servicio inyectado original
            var resultadoCompra = await CompraService.RegistrarCompraAsync(nuevaCompraReq);

            if (resultadoCompra != null)
            {
                await JS.InvokeVoidAsync("alert", $"✅ ¡Compra realizada con éxito!");

                // Redireccionamos usando el ID de compra real autogenerado
                Navigation.NavigateTo($"/cliente/mis-entradas/");
            }
            else
            {
                await JS.InvokeVoidAsync("alert", "⚠️ Hubo un problema al procesar la respuesta del servidor.");
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"❌ Error Crítico: {ex.Message}");
        }
    }
}

<style>
    /* Conservé exactamente tus mismos estilos CSS intactos */
    .confirmar-pago-page {
        min-height: 100vh;
        background: linear-gradient(90deg, #05051f 0%, #1d1270 45%, #3928d8 100%);
        font-family: Arial, Helvetica, sans-serif;
        color: white;
        padding: 60px 70px;
    }

    .confirmar-contenedor {
        display: grid;
        grid-template-columns: 420px 1fr;
        gap: 60px;
        align-items: center;
        max-width: 1200px;
        margin: 0 auto;
    }

    .poster-contenido {
        padding: 10px;
    }

    .panel-pago h1 {
        font-size: 58px;
        font-weight: bold;
        margin-bottom: 30px;
    }

    .resumen-box,
    .metodos-box {
        max-width: 700px;
        margin-bottom: 30px;
    }

    .resumen-box h2,
    .metodos-box h2 {
        font-size: 28px;
        font-weight: bold;
        margin-bottom: 20px;
    }

    .fila-dato {
        display: grid;
        grid-template-columns: 230px 1fr;
        gap: 18px;
        align-items: center;
        margin-bottom: 15px;
    }

    .fila-dato label {
        border: 2px solid white;
        border-radius: 8px;
        padding: 13px;
        font-size: 18px;
        font-weight: bold;
    }

    .fila-dato span {
        border: 2px solid white;
        border-radius: 8px;
        padding: 13px;
        font-size: 18px;
    }

    .total label,
    .total span {
        font-size: 20px;
        font-weight: bold;
    }

    .opciones-pago {
        display: flex;
        flex-direction: column;
        gap: 14px;
        max-width: 350px;
    }

    .opcion-pago {
        display: grid;
        grid-template-columns: 35px 1fr;
        align-items: center;
        gap: 12px;
    }

    .opcion-pago input {
        width: 22px;
        height: 22px;
    }

    .opcion-pago span {
        border: 2px solid white;
        border-radius: 8px;
        padding: 13px;
        font-size: 18px;
    }

    .acciones {
        display: flex;
        justify-content: flex-end;
        gap: 20px;
        margin-top: 40px;
        max-width: 700px;
    }

    .btn-volver,
    .btn-confirmar {
        display: inline-block;
        text-decoration: none;
        border-radius: 30px;
        padding: 15px 36px;
        font-size: 18px;
        font-weight: bold;
    }

    .btn-volver {
        color: white;
        border: 3px solid white;
    }

    .btn-confirmar {
        color: #160b62;
        background-color: white;
        border: 3px solid white;
    }

    .btn-volver:hover {
        background-color: white;
        color: #160b62;
    }

    .btn-confirmar:hover {
        background-color: #dffcff;
        color: #160b62;
    }

    @("@media") (max-width: 900px) {
        .confirmar-pago-page {
            padding: 35px 25px;
        }

        .confirmar-contenedor {
            grid-template-columns: 1fr;
            gap: 35px;
        }

        .panel-pago h1 {
            font-size: 42px;
        }

        .fila-dato {
            grid-template-columns: 1fr;
        }

        .acciones {
            flex-direction: column;
        }

        .btn-volver,
        .btn-confirmar {
            text-align: center;
        }
    }
</style>
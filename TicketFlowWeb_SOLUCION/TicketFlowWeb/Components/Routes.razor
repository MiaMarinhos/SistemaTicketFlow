@using Microsoft.AspNetCore.Components.Authorization

<Router AppAssembly="typeof(Program).Assembly" NotFoundPage="typeof(Pages.NotFound)">
    <Found Context="routeData">
        @* 🌟 CAMBIO CLAVE: Cambiamos RouteView por AuthorizeRouteView *@
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">

            @* 🔒 Lo que verá el usuario si da clic a un botón sin estar logueado *@
            <NotAuthorized>
                <div class="resumen-compra-page" style="padding: 60px 40px; text-align: center; font-family: Arial; min-height: 100vh; background: linear-gradient(90deg, #05051f 0%, #1d1270 45%, #3928d8 100%); color: white;">
                    <h2 style="font-size: 36px; font-weight: bold;">Acceso Restringido</h2>
                    <p style="font-size: 18px; margin-top: 10px;">Debes iniciar sesión para poder continuar con tu compra.</p>
                    <a href="/login" style="display: inline-block; margin-top: 25px; padding: 14px 35px; background: white; color: #160b62; font-weight: bold; text-decoration: none; border-radius: 30px; font-size: 16px;">
                        Ir al Login
                    </a>
                </div>
            </NotAuthorized>

        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>